#!/usr/bin/env bash
K4_NAME=k4-wow K4_ID=wow K4_TITLE="World of Warcraft" K4_KEY=W K4_ICON=󰺵 K4_DESC="Forever: your characters, addons, the reset, raid nights"
# k4-wow: k4 around World of Warcraft Forever (wow.py in ~/.local/share/k4 does the work): the
# characters window (k4 --wow, the KWow board once it comes), the Apps page (play, time played, the
# characters, the reset, realm and token, addons, raid nights), screenshots as cards, reminders,
# the bar module. The characters come from k4's companion addon (K4Companion, installed from here).
#   k4-wow window [TAB] | play    the window (Super+Alt+W; addons, raids) | the game (Super+Shift+Alt+W)
#   k4-wow data | act VERB …      the window's data and actions (wow.py)
#   k4-wow watch | tick           while the game runs (sessions, screenshots) | every minute (k4-wow.timer)
#   k4-wow bar | find | note …    the bar module, the launcher's rows, the cards' buttons
#   k4-wow reset                  "2 d 4 h" to the weekly reset (k4-cal's popup shows it)
. "$HOME/.local/share/k4/lib.sh"
launch_row() { :; }
SELF=$(command -v k4-wow || echo "$0")
PY="$HOME/.local/share/k4/wow.py"
export K4_WOW_FRONT="$SELF"
w() { python3 -I "$PY" "$@"; }

timer() {  # the minute timer (reminders, realm and token), once
  local d="$HOME/.config/systemd/user"
  [ -e "$d/k4-wow.timer" ] && return
  mkdir -p "$d"
  printf '[Unit]\nDescription=k4 WoW: reminders, realm and token\n\n[Service]\nType=oneshot\nExecStart=%s tick\n' "$SELF" > "$d/k4-wow.service"
  printf '[Unit]\nDescription=k4 WoW every minute\n\n[Timer]\nOnCalendar=*:*:00\nPersistent=false\n\n[Install]\nWantedBy=timers.target\n' > "$d/k4-wow.timer"
  systemctl --user daemon-reload && systemctl --user enable --now k4-wow.timer >/dev/null 2>&1; }

window() {  # window [chars|addons|raids]: the tab it opens on
  pkill -f '^k4 --wo[w]' && exit 0
  timer
  local pop=()
  [ -n "${K4_BAR_MX:-}" ] && [ "${K4_BAR_WIDTH:-0}" -gt 0 ] && pop=(--popup "$K4_BAR_MX,$K4_BAR_MW,$K4_BAR_WIDTH,${K4_BAR_SIDE:-right},${K4_BAR_POS:-top}")
  w data | K4_WOW_TAB="${1:-}" k4 --wow "${pop[@]}" >/dev/null; }

find_rows() {  # the launcher: a character by name
  local name realm cls lvl gold
  while IFS=$'\t' read -r name realm cls lvl gold; do
    item "$name" "bg $(printf %q "$SELF") window" "$cls $lvl · $realm · $gold" "" "search;words;min=3;rank=70;tag=WoW;icon=󰺵;find=$(k4flag "$realm")"
  done < <(w find); }

hm() { local s=${1:-0}; [ "$s" -ge 3600 ] && echo "$((s / 3600)) h $((s / 60 % 60)) m" || echo "$((s / 60)) m"; }
span() { local s=${1:-0}; [ "$s" -ge 86400 ] && echo "$((s / 86400)) d $((s / 3600 % 24)) h" || hm "$s"; }

# ---------- the Apps page ----------
available() { [ -d "$HOME/Games/battlenet" ] || [ -n "${K4_WOW_DIR:-}" ]; }
summary() { local st n; IFS=$'\t' read -r _ st _ _ _ _ _ < <(w info | head -1); n=$(w info | grep -c '^C'); [ "$st" = ok ] && echo "$n character$([ "$n" = 1 ] || echo s) · reset in $(w reset --short)" || echo "not installed"; }
section() {  # the design's AppsWow (and AppsWowNotSetup): play, time played, characters, this week, more
  local kind f1 f2 f3 f4 f5 f6 f7 f8 st today week reset comp run at nad=0 nup=0 raid="" nraid=0 shots="" logs=""
  local -a cs=() ws=()
  while IFS=$'\t' read -r kind f1 f2 f3 f4 f5 f6 f7 f8; do
    case "$kind" in
      S) st=$f1; today=$f2; week=$f3; reset=$f4; comp=$f5; run=$f6; at=$f7 ;;
      C) cs+=("$f1"$'\t'"$f2"$'\t'"$f3"$'\t'"$f4"$'\t'"$f5"$'\t'"$f6"$'\t'"$f7"$'\t'"$f8") ;;
      W) ws+=("$f1"$'\t'"$f2"$'\t'"$f3"$'\t'"$f4") ;;
      A) nad=$f1; nup=$f2 ;;
      D) raid="$f1 $f2 $f3"; nraid=$f4 ;;
      F) shots=$f1; logs=$f2 ;;
    esac
  done < <(w info)
  if [ "$st" != ok ]; then
    desc "World of Warcraft through Battle.net" "not installed" "Search WoW…"
    notice "Forever is not installed" "Install it from Battle.net (omarchy-launch-battlenet), then come back." muted
    stay "Open Battle.net" "bg omarchy-launch-battlenet" "mark=→;markc=accent"; return
  fi
  local l kind_ a b c realm="" token="" why=""
  for l in "${ws[@]}"; do
    IFS=$'\t' read -r kind_ a b c <<<"$l"
    case "$kind_" in
      realm) [ -z "$realm" ] && realm="$a · $([ "$b" = UP ] && echo up || echo down)$([ "$c" = 1 ] && echo " · queue")" ;;
      token) token=$a ;;
      why) why=$a ;;
    esac
  done
  local play; play=$([ "$run" = 1 ] && echo "Playing" || echo "Play")
  if [ ${#cs[@]} -eq 0 ]; then   # not set up: the companion, the API client, play
    desc "characters, addons, realm and the weekly reset" "not set up" "Search WoW…"
    hints "↵" Run "⌫" Back
    notice "No characters yet" "Install the k4 Companion addon and log in once. Realm status and the token need a Blizzard API client (develop.battle.net)." accent
    if [ "$comp" = 1 ]; then item "The k4 Companion is installed" ":" "log in once (or /reload)" "" "mark=✓;markc=green"
    else stay "Install the k4 Companion" "$(printf %q "$SELF") act install-companion" "into Interface/AddOns" "mark=↓;markc=accent"; fi
    [ "$why" = noclient ] && stay "Set up a Blizzard API client" "bg xdg-open https://develop.battle.net/access/clients" "client ID and secret" "mark=?"
    item "$play" "bg $(printf %q "$SELF") play" "Super+Shift+Alt+W" "" "mark=▶"
    return
  fi
  desc "World of Warcraft Classic Forever · characters from the k4 Companion addon" "${realm:-${#cs[@]} characters}" "Search WoW…"
  hints "↑↓" Move "↵" Run "⌫" Back
  if [ "$run" = 1 ]; then item "Playing" "bg $(printf %q "$SELF") window" "Super+Alt+W" "" "mark=▶;markc=green"
  else item "Play" "bg $(printf %q "$SELF") play" "Super+Shift+Alt+W" "" "mark=▶;markc=accent"; fi
  item "Time played" ":" "today $(hm "$today") · this week $(hm "$week")" "" "mark=◷"
  hdr "Characters" "${#cs[@]}"
  local name rlm cls lvl gold seen rest cd sub
  for l in "${cs[@]}"; do
    IFS=$'\t' read -r name rlm cls lvl gold seen rest cd <<<"$l"
    if [ "$cd" = 1 ]; then sub="cooldown ready"
    elif [ "${rest:--1}" -ge 150 ]; then sub="rested full"
    else sub="seen $(ago "$seen")"; fi
    item "$name · $cls $lvl" "bg $(printf %q "$SELF") window" "$gold · $rlm" "" "mark=●$([ "$cd" = 1 ] && echo ";markc=accent");sub=$(k4flag "  $sub")"
  done
  hdr "This week"
  item "Weekly reset" ":" "in $(span "$reset") · $(date -d "@$at" '+%a %H:%M')" "" "mark=↻"
  case "$why" in
    noclient) stay "Realm & token: add a Blizzard API client" "bg xdg-open https://develop.battle.net/access/clients" "develop.battle.net · then k4-wow act client ID" "mark=?" ;;
    notinapi) item "Realm & token" ":" "Forever is not in Blizzard's API yet" "" "mark=○;metac=dim" ;;
    offline) item "Realm & token" ":" "Blizzard did not answer" "" "mark=○;metac=yellow" ;;
    *) if [ -n "$realm" ]; then item "Realm · ${realm%% · *}" ":" "${realm#* · }" "" "mark=◉$([[ $realm == *down* ]] && echo ";metac=red")"
       else stay "Realm & token" "$(printf %q "$SELF") act world" "↵ asks Blizzard" "mark=◉"; fi
       [ -n "$token" ] && item "WoW Token" ":" "$token" "" "mark=¤" ;;
  esac
  hdr "More"
  item "Addons" "bg $(printf %q "$SELF") window addons" "$([ "$nup" -gt 0 ] && echo "$nup update$([ "$nup" = 1 ] || echo s)" || echo "$nad installed")" "" "mark=»$([ "$nup" -gt 0 ] && echo ";metac=accent")"
  item "Raid nights" "bg $(printf %q "$SELF") window raids" "${raid:-none yet · add one in the window}" "" "mark=»"
  stay "Screenshots folder" "$(printf %q "$SELF") act open-screens" "$shots" "mark=↗"
  stay "Logs" "$(printf %q "$SELF") act open-logs" "$logs" "mark=↗"; }

raid_add() {  # asked in a small prompt: Wed 20:00 Molten Core
  local a; a=$(ask "Raid night: day time name (Wed 20:00 Molten Core)") || return
  # shellcheck disable=SC2086
  [ -n "$a" ] && notify "Raid nights" "$(w act raid add $a | head -1)"; }

case "${1:-}" in
  window) shift; window "${1:-}"; exit 0 ;;
  play) w play; exit 0 ;;
  data) w data; exit 0 ;;
  act) shift
       if [ "${1:-}" = search ]; then shift; w act search "${K4_INPUT:-$*}"; exit 0; fi
       w act "$@"; exit 0 ;;
  watch) w watch; exit 0 ;;
  tick) w tick; exit 0 ;;
  bar) w bar; exit 0 ;;
  find) find_rows; exit 0 ;;
  note) shift; w note "$@"; exit 0 ;;
  reset) w reset --short; exit 0 ;;
  raid-add) raid_add; exit 0 ;;
esac
k4_dispatch "$@"

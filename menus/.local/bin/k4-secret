#!/usr/bin/env bash
# k4-secret: the passwords k4 keeps in the keyring (org.freedesktop.secrets: GNOME Keyring,
# KeePassXC…), and the Keyring window (k4 --keyring, the Kestrel design's Network › Keyring).
# Wi-Fi and VPN passwords typed into k4 are stored as items with the attributes app=k4,
# kind=wifi|vpn, name=SSID|connection, and used again without asking.
#   k4-secret                      the window (also: window); under a bar module when clicked there
#   k4-secret lookup KIND NAME     the secret on stdout (exit 1: none, or the keyring is locked)
#   k4-secret store KIND NAME      the secret from stdin
#   k4-secret clear KIND NAME      forget it
#   k4-secret names KIND           the names k4 keeps for that kind (no secrets), one a line
#   k4-secret count                how many k4 keeps
#   k4-secret locked               exit 0 when the keyring is locked
#   k4-secret unlock               ask the keyring to unlock (its own prompt)
#   k4-secret data | act VERB ID   the window's data (S and E lines) and actions (use, forget)
# A locked keyring is never asked from scripts in the background: lookup and store fail at once.
export PATH="$HOME/.local/bin:$PATH"
SELF=$(command -v k4-secret || echo "$0")
DEST=org.freedesktop.secrets
SVC=/org/freedesktop/secrets
COL=/org/freedesktop/secrets/aliases/default

have() { busctl --user status "$DEST" >/dev/null 2>&1; }
locked() { have || return 0; [ "$(busctl --user get-property "$DEST" "$COL" org.freedesktop.Secret.Collection Locked 2>/dev/null)" = "b true" ]; }
ready() { command -v secret-tool >/dev/null && have && ! locked; }

lookup() { ready || return 1; local s; s=$(timeout 15 secret-tool lookup app k4 kind "$1" name "$2" 2>/dev/null) && [ -n "$s" ] && printf '%s' "$s"; }
store() { ready || return 1; timeout 15 secret-tool store --label="k4 · ${1^^} · $2" app k4 kind "$1" name "$2" 2>/dev/null; }
clear_() { ready || return 1; timeout 15 secret-tool clear app k4 kind "$1" name "$2" 2>/dev/null; }

unlock() {  # Service.Unlock gives a prompt to show (gnome-keyring: its own window)
  local out prompt
  out=$(busctl --user -j call "$DEST" "$SVC" org.freedesktop.Secret.Service Unlock ao 1 "$COL" 2>/dev/null) || return 1
  prompt=$(printf '%s' "$out" | jq -r '.data[1]')
  [ -n "$prompt" ] && [ "$prompt" != / ] && busctl --user call "$DEST" "$prompt" org.freedesktop.Secret.Prompt Prompt s "" >/dev/null 2>&1
  return 0; }

# The items that match some attributes: "path<TAB>label<TAB>created<TAB>attributes as k=v;k=v"
items() {  # items KEY VALUE [KEY VALUE…]
  local n=$(( $# / 2 )) out p
  out=$(busctl --user -j call "$DEST" "$SVC" org.freedesktop.Secret.Service SearchItems 'a{ss}' "$n" "$@" 2>/dev/null) || return 0
  for p in $(printf '%s' "$out" | jq -r '.data[0][], .data[1][]'); do
    busctl --user -j get-property "$DEST" "$p" org.freedesktop.Secret.Item Label Created Attributes 2>/dev/null \
      | jq -rs --arg p "$p" '[$p, .[0].data, (.[1].data | tostring), (.[2].data | to_entries | map("\(.key)=\(.value)") | join(";"))] | @tsv'
  done; }
attr() { printf '%s' "$1" | tr ';' '\n' | sed -n "s/^$2=//p" | head -1; }
names() { items app k4 kind "$1" | while IFS=$'\t' read -r _ _ _ at; do attr "$at" name; done; }
ago() {
  local s=$(( $(date +%s) - ${1:-0} ))
  if [ "$s" -lt 3600 ]; then echo "$(( s / 60 )) min ago"; elif [ "$s" -lt 86400 ]; then echo "$(( s / 3600 )) h ago"
  elif [ "$s" -lt 1209600 ]; then echo "$(( s / 86400 )) d ago"; elif [ "$s" -lt 5184000 ]; then echo "$(( s / 604800 )) w ago"
  else echo "$(( s / 2592000 )) mo ago"; fi; }

data() {
  local p l c at kind name cur vpns
  printf 'S\t%s\n' "$(locked && echo 1 || echo 0)"
  cur=$(nmcli -t -f ACTIVE,SSID dev wifi 2>/dev/null | awk -F: '$1 == "yes" { print $2; exit }')
  vpns=$(nmcli -t -f NAME,TYPE con show --active 2>/dev/null | awk -F: '$2 == "vpn" || $2 == "wireguard" { print $1 }')
  while IFS=$'\t' read -r p l c at; do
    [ -n "$p" ] || continue
    kind=$(attr "$at" kind); name=$(attr "$at" name)
    case "$kind" in
      wifi) printf 'E\t%s\tWIFI\tWi-Fi\t%s\tsaved %s%s\tUse\t%s\n' "$p" "$name" "$(ago "$c")" "$([ "$name" = "$cur" ] && echo ' · used now')" "$([ "$name" = "$cur" ] && echo 1 || echo 0)" ;;
      vpn) printf 'E\t%s\tVPN\tVPN\t%s\tsaved %s\tConnect\t%s\n' "$p" "$name" "$(ago "$c")" "$(grep -qxF -- "$name" <<<"$vpns" && echo 1 || echo 0)" ;;
    esac
  done < <(items app k4)
  # the sign-in tokens k4's integrations keep (Google Calendar: k4-cal; GitHub: gh)
  while IFS=$'\t' read -r p l c at; do [ -n "$p" ] && printf 'E\t%s\tTOKEN\tAccounts\tGoogle Calendar\tsign-in token for k4-cal · saved %s\tSync now\t0\n' "$p" "$(ago "$c")"; done < <(items service k4-google-calendar)
  while IFS=$'\t' read -r p l c at; do [ -n "$p" ] && { u=$(attr "$at" username); printf 'E\t%s\tTOKEN\tAccounts\tGitHub%s\ttoken for gh · saved %s\tCheck\t0\n' "$p" "${u:+ · $u}" "$(ago "$c")"; }; done < <(items service gh:github.com)
  while IFS=$'\t' read -r p l c at; do [ -n "$p" ] && [ "$(attr "$at" name)" = trafiklab ] && printf 'E\t%s\tTOKEN\tAccounts\tTrafiklab · departures key\tfor k4-bus · saved %s\tCheck\t0\n' "$p" "$(ago "$c")"; done < <(items app k4 kind token)
  printf 'R\t%s act\nL\t%s data\n' "$SELF" "$SELF"; }

act() {
  local verb="$1" p="${2:-}" at kind name out pw
  at=$(busctl --user -j get-property "$DEST" "$p" org.freedesktop.Secret.Item Attributes 2>/dev/null | jq -r '.data | to_entries | map("\(.key)=\(.value)") | join(";")')
  kind=$(attr "$at" kind); name=$(attr "$at" name)
  case "$verb" in
    use)
      case "$kind" in
        wifi) out=$(K4_RUN=1 K4_INPUT="" sway-menu call wifi_join "$name" WPA 2>&1 | tail -1); echo "${out:-Joined $name}" ;;
        vpn) vpn_up "$name" ;;
        *) case "$(attr "$at" service)" in
             k4-google-calendar) k4-cal sync >/dev/null 2>&1 && echo "Calendar synced" || { echo "Calendar sync failed"; echo k4:tone red; } ;;
             "") [ "$name" = trafiklab ] && { k4-bus act refresh >/dev/null 2>&1; k4-bus bar | grep -q 'key?' && { echo "Trafiklab does not accept the key"; echo k4:tone red; } || echo "Trafiklab key works"; } ;;
             gh:github.com) gh auth status >/dev/null 2>&1 && echo "GitHub checked · the token works" || { echo "GitHub says the token does not work"; echo k4:tone red; } ;;
           esac ;;
      esac ;;
    forget)
      busctl --user call "$DEST" "$p" org.freedesktop.Secret.Item Delete >/dev/null 2>&1 \
        && { echo "Forgot ${name:-it}$([ "$kind" = wifi ] && echo ' · next time k4 asks for the password')"; echo k4:tone red; } \
        || { echo "Could not forget it"; echo k4:tone red; } ;;
  esac; }

vpn_up() {  # vpn_up NAME: a NetworkManager VPN with its password from the keyring
  local pw
  if pw=$(lookup vpn "$1"); then
    nmcli con up id "$1" passwd-file <(printf 'vpn.secrets.password:%s\n' "$pw") >/dev/null 2>&1 && echo "VPN $1 up" || { echo "VPN $1 did not come up"; echo k4:tone red; }
  else nmcli --ask con up id "$1" >/dev/null 2>&1 && echo "VPN $1 up" || { echo "VPN $1 needs its password"; echo k4:tone yellow; }; fi; }

window() {
  pkill -f '^k4 --keyring' && exit 0
  local pop=() out
  [ -n "${K4_BAR_MX:-}" ] && [ "${K4_BAR_WIDTH:-0}" -gt 0 ] && pop=(--popup "$K4_BAR_MX,$K4_BAR_MW,$K4_BAR_WIDTH,${K4_BAR_SIDE:-right},${K4_BAR_POS:-top}")
  out=$(data | k4 --keyring "${pop[@]}")
  [ "$out" = unlock ] && unlock
  return 0; }

case "${1:-window}" in
  window) window ;;
  lookup) lookup "${2:?kind}" "${3:?name}" ;;
  store) store "${2:?kind}" "${3:?name}" ;;
  clear) clear_ "${2:?kind}" "${3:?name}" ;;
  names) ready && names "${2:?kind}" ;;
  count) n=0; ready && n=$(items app k4 | grep -c .); echo "${n:-0}" ;;
  locked) locked ;;
  unlock) unlock ;;
  vpn-up) vpn_up "${2:?name}" ;;
  data) data ;;
  act) act "${2:?verb}" "${3:?item}" ;;
  *) sed -n '2,15p' "$0" >&2; exit 2 ;;
esac

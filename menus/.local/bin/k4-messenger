#!/usr/bin/env bash
K4_NAME=k4-messenger K4_ID=messenger K4_TITLE=Messenger K4_KEY=J K4_ICON=󰍦 K4_DESC="Facebook Messenger, through a bridge on this machine"
# k4-messenger: Facebook Messenger in k4 (k4 --messenger: the conversations, the open one's
# messages, a line to write), the bar's unread tag, the launcher's Apps row and the cards' buttons,
# over k4-messengerd (a Matrix homeserver and the mautrix-meta bridge on this machine).
#   k4-messenger window [ROOM]   the window (again: closes it; from a bar click: under it);
#                                --new: on a new chat (^N)
#   k4-messenger data            its data (k4-messengerd ctl data)
#   k4-messenger act VERB [ARG]  open ROOM, close, more, send ROOM ($K4_INPUT), read ROOM,
#                                search QUERY (k4:person ID NAME lines), start ID NAME (k4:open ROOM),
#                                setup (its steps in $XDG_RUNTIME_DIR/k4-messenger-setup.log),
#                                login ($K4_INPUT: the cookies), media EVENT (opens a photo or video), url URL (the browser),
#                                unlock (the keyring), retry (asks the bridge again), web (messenger.com),
#                                log (setup's), journal (the services')
#   k4-messenger bar             the bar module (the unread count; hidden until set up)
#   k4-messenger note KEY ID     a card's buttons (reply: $K4_INPUT)
#   k4-messenger find            every conversation as a row only the launcher's search shows (the
#                                Kestrel design's SearchMessenger boards); not set up or logged
#                                out: one row saying so, shown for any search
#   k4-messenger restore-login   the login k4-vault brought from another machine
#                                (~/.local/state/k4/messenger-restore.json), once set up; also after setup
. "$HOME/.local/share/k4/lib.sh"
SELF=$(command -v k4-messenger || echo "$0")
D=$(command -v k4-messengerd || echo "${0%/*}/k4-messengerd")
STATUS_FILE="${K4_MESSENGER_STATUS:-${XDG_RUNTIME_DIR:-/tmp}/k4-messenger.status}"
ctl() { "$D" ctl "$@" 2>/dev/null; }
set_up() { [ -f "$HOME/.config/k4-messenger/meta.yaml" ]; }

available() { return 0; }   # nothing to install by hand: the window sets it up
summary() { local st n; IFS=$'\t' read -r st n _ 2>/dev/null < "$STATUS_FILE"
  case "${st:-}" in
    ok) [ "${n:-0}" -gt 0 ] && echo "$n unread" || echo "no unread" ;;
    login|relogin) echo "log in" ;;
    "") set_up && echo "not running" || echo "not set up" ;;
    *) echo "$st" ;;
  esac; }
state() { local st; IFS=$'\t' read -r st _ 2>/dev/null < "$STATUS_FILE"; echo "${st:-}"; }
OLDER="$K4_STATE/messenger-older"   # the Apps section's older chats unfolded

when_() {  # when_ EPOCH -> 2 min, 3 h, yesterday, Mon, 12 Oct (the list's time)
  local now=${K4_MESSENGER_NOW:-${EPOCHSECONDS:-$(date +%s)}} d
  d=$(( now - $1 ))
  if [ "$d" -lt 60 ]; then echo now; elif [ "$d" -lt 3600 ]; then echo "$(( d / 60 )) min"
  elif [ "$(date -d "@$1" +%F)" = "$(date -d "@$now" +%F)" ]; then echo "$(( d / 3600 )) h"
  elif [ "$(date -d "@$1" +%F)" = "$(date -d "@$(( now - 86400 ))" +%F)" ]; then echo yesterday
  elif [ "$d" -lt $(( 7 * 86400 )) ]; then LC_ALL=C date -d "@$1" +%a
  else LC_ALL=C date -d "@$1" '+%-d %b'; fi; }

# The chats as rows: chat KIND (dm, named, group) and the line under the name ("2 new · Anna: …").
chat_rows() {  # chat_rows FIRST LAST|all SEARCH(1|0): C lines FIRST..LAST of `ctl rooms`
  local f id name un ts who last group mine titled members n=0 kind line flags
  while IFS=$'\x1f' read -r f id name un ts who last group mine titled members; do
    [ "$f" = C ] || continue; n=$((n + 1))
    [ "$n" -ge "$1" ] || continue; [ "$2" = all ] || [ "$n" -le "$2" ] || break
    kind=dm; [ "$group" = 1 ] && { [ "$titled" = 1 ] && kind=named || kind=group; }
    line="$([ "${un:-0}" -gt 0 ] && echo "$un new · ")$([ "$mine" = 1 ] && echo "you: " || { [ "$group" = 1 ] && [ -n "$who" ] && echo "${who%% *}: "; })$last"
    if [ "$3" = 1 ]; then
      flags="search;tag=Messenger;chat=$kind;icon=$([ "$kind" = dm ] && echo 󰍦 || echo 󰡉);find=$(k4flag "$members")"
      [ "$group" = 1 ] && [ -n "$members" ] && flags+=";people=$(( $(tr -cd '|' <<<"$members" | wc -c) + 2 ))"
      [ "${un:-0}" -gt 0 ] && flags+=";chip=$un"
      item "$name" "bg $(printf %q "$SELF") window $(printf %q "$id")" "$line" "" "$flags"
    else
      flags="sub=  $(k4flag "$line");mark=$([ "$group" = 1 ] && echo ⁂ || echo @)"
      [ "${un:-0}" -gt 0 ] && flags+=";markc=accent;chip=$un;chipc=accent"
      item "$name" "bg $(printf %q "$SELF") window $(printf %q "$id")" "$(when_ "$ts")" "" "$flags"
    fi
  done < <(ctl rooms | tr '\t' '\037'); }   # (a tab is whitespace to read: empty fields would collapse)

# The Apps section (the Integrations board's Messenger): 8 chats, the older ones folded (unfolded:
# 3, "…5 more", then them), a new chat; not set up and starting say so.
section() {
  local w="bg $(printf %q "$SELF") window"
  if ! set_up; then
    hints "↑↓" Move "↵" Open "⌫" Back
    desc "your Messenger chats, here and in search" "not set up" "Find a chat…"
    notice "Messenger isn’t set up" "Setup installs a small Matrix server and the Messenger bridge as user services (about 150 MB, 1–2 min). Your chats stay on this computer."
    item "Set up Messenger" "$w" "1–2 min" "" "mark=↓;markc=accent"
    stay "What gets installed" "notify 'continuwuity and mautrix-meta' 'in ~/.local/lib/k4-messenger, as user services'" "continuwuity · mautrix-meta" "mark=?"
    return
  fi
  if [ "$(state)" = starting ]; then
    hints "↵" "Unlock keyring" "⌫" Back
    desc "after a reboot, Messenger waits for the keyring" "starting…" "Find a chat…"
    notice "Starting Messenger…" "Your setup is fine. It waits for the keyring after a reboot; unlock it and your chats come back." muted
    stay "Unlock keyring" "k4-secret unlock >/dev/null 2>&1 && notify Keyring 'open · Messenger starts in a few seconds' || notify Keyring 'stayed locked'"
    empty "Chats show here once it has started"
    return
  fi
  local n un
  n=$(ctl rooms | grep -c '^C'); un=$(ctl rooms | awk -F'\t' '$1 == "C" && $4 > 0' | wc -l)
  desc "unread first, then newest · ↵ opens the chat in the Messenger window" "$n chats$([ "$un" -gt 0 ] && echo " · $un unread")" "Find a chat…"
  hints "↑↓" Move "↵" "Open chat" "^N" "New chat" "⌫" Back
  if [ "$n" -eq 0 ]; then hdr "Conversations"; empty "No chats yet"
  elif [ "$n" -le 8 ]; then hdr "Conversations" "$n"; chat_rows 1 8 0
  elif [ -e "$OLDER" ]; then
    hdr "Conversations" 8; chat_rows 1 3 0
    stay "…$(( 8 - 3 )) more" "rm -f $(printf %q "$OLDER")" ""
    hdr "Older" "$(( n - 8 ))"; chat_rows 9 all 0
    stay "Fold older chats" "rm -f $(printf %q "$OLDER")" "" "mark=«"
  else
    hdr "Conversations" 8; chat_rows 1 8 0
    stay "Show $(( n - 8 )) older chats" "mkdir -p $(printf %q "$K4_STATE"); touch $(printf %q "$OLDER")" "search finds them anyway" "mark=»;markc=accent"
  fi
  hdr "Manage"
  item "Open Messenger" "$w" "Super+Alt+M"
  item "New chat…" "$w --new" "^N"; }

data() { ctl data || printf 'S\t%s\t0\t\t%s\n' "$(set_up && echo down || echo setup)" "$(set_up && echo "k4's Messenger service is not running" || echo "Not set up yet")"
  printf 'R\t%s act\nL\t%s data\n' "$SELF" "$SELF"; }

act() {
  local verb="$1"; shift
  case "$verb" in
    open|read|close|more) ctl "$verb" "$@" >/dev/null; echo k4:noreload; [ "$verb" = read ] && echo "Marked read" ;;
    send) ctl send "$1" | tail -1 ;;
    search) local r n; r=$(ctl search "$*"); n=$(grep -c '^P' <<<"$r")   # the window lists them (k4:person ID NAME)
            case "$r" in error*) echo "${r#error	}"; echo k4:tone red; return ;; esac
            grep '^P' <<<"$r" | sed 's/^P\t/k4:person\t/'; echo k4:noreload
            [ "$n" -gt 0 ] && echo "$n on Messenger" || echo "Nobody called “$*” on Messenger" ;;
    start) local r; r=$(ctl start "$1" "${2:-}")
           case "$r" in ok*) printf 'k4:open\t%s\n' "${r#ok	}"; echo "${2:-The chat} · say hi" ;; *) echo "${r#error	}"; echo k4:tone red ;; esac ;;
    setup) local log="${XDG_RUNTIME_DIR:-/tmp}/k4-messenger-setup.log"   # the window reads the steps while it runs
           "$D" setup > "$log" 2>&1; tail -1 "$log"
           restore_login && echo "Logged in with the login k4-vault saved"
           if systemctl --user is-active -q k4-messenger.service; then echo k4:tone green; else echo k4:tone red; fi ;;
    url) case "$1" in http://*|https://*) open_url "$1"; echo k4:noreload; echo "Opened in the browser" ;; *) echo "Not a link"; echo k4:tone red ;; esac ;;
    media) local r; r=$(ctl media "$1"); echo k4:noreload   # the file, fetched once, in its app (imv, mpv…)
           case "$r" in ok*) bg xdg-open "${r#ok	}"; echo "Opening it" ;; *) echo "${r#error	}"; echo k4:tone red ;; esac ;;
    unlock) echo k4:noreload; if k4-secret unlock >/dev/null 2>&1; then echo "Keyring open · Messenger starts in a few seconds"; else echo "The keyring stayed locked"; echo k4:tone yellow; fi ;;
    retry) local r; r=$(ctl check); case "$r" in ok*) echo "Messenger answers again"; echo k4:tone green ;; *) echo "Still not answering · it tries again every minute"; echo k4:tone yellow ;; esac ;;
    web) open_url https://www.messenger.com/; echo k4:noreload; echo "Opened messenger.com" ;;
    log) tui sh -c "less +G $(printf %q "${XDG_RUNTIME_DIR:-/tmp}/k4-messenger-setup.log")"; echo k4:noreload; echo "Opened the setup log" ;;
    journal) tui sh -c "journalctl --user -e -u k4-matrix -u k4-meta-bridge -u k4-messenger"; echo k4:noreload; echo "Opened the services' log" ;;
    login) local r; r=$(ctl login-cookies); case "$r" in ok*) echo "${r#ok	}"; echo k4:tone green ;; *) echo "${r#error	}"; echo k4:tone red ;; esac ;;
  esac; }

find_rows() {  # the launcher's Apps section: typing a name finds the chat
  local w="bg $(printf %q "$SELF") window"
  if ! set_up; then item "Set up Messenger to search your chats" "$w" "a local server and a bridge · 150 MB" "" "search;always;tag=Messenger;icon=󰍦"; return; fi
  case "$(state)" in
    login|relogin) item "Log in to Messenger to search your chats" "$w" "Messenger logged the bridge out" "" "search;always;tag=Messenger;icon=󰍦"; return ;;
    starting) item "Unlock the keyring to search your chats" "$w" "Messenger waits for it after a reboot" "" "search;always;tag=Messenger;icon=󰍦"; return ;;
  esac
  chat_rows 1 all 1; }

RESTORE="$HOME/.local/state/k4/messenger-restore.json"
restore_login() {  # the cookies k4-vault restored, handed to the bridge (then gone); logged in already: just gone
  [ -s "$RESTORE" ] && set_up || return 1
  local i r
  for i in $(seq 20); do [ "$(state)" = starting ] || [ -z "$(state)" ] || break; sleep 1; done
  case "$(state)" in ok) rm -f "$RESTORE"; return 1 ;; esac
  r=$(K4_INPUT=$(cat "$RESTORE") ctl login-cookies)
  case "$r" in ok*) rm -f "$RESTORE"; return 0 ;; *) return 1 ;; esac; }

bar() {
  local st n acct note; IFS=$'\t' read -r st n acct note 2>/dev/null < "$STATUS_FILE" || { echo '{}'; return; }
  case "$st" in
    ok) [ "${n:-0}" -gt 0 ] || { echo '{}'; return; }
        jq -cn --argjson n "$n" '{icon: "󰍦", badge: $n, tooltip: "Messenger · \($n) unread · Super+Alt+M"}' ;;
    login|relogin) jq -cn --arg t "$note" '{icon: "󰍦", icon_tone: "yellow", text: "!", text_tone: "yellow", tooltip: ("Messenger · log in again" + (if $t != "" then " · " + $t else "" end))}' ;;
    error) jq -cn --arg t "$note" '{icon: "󰍦", icon_tone: "yellow", tooltip: "Messenger · \($t)"}' ;;
    *) echo '{}' ;;
  esac; }

window() {
  pkill -f '^k4 --messenge[r]' && exit 0
  [ "${1:-}" = --new ] && { export K4_MESSENGER_NEW=1; shift; }
  [ -n "${1:-}" ] && ctl open "$1" >/dev/null
  local pop=()
  [ -n "${K4_BAR_MX:-}" ] && [ "${K4_BAR_WIDTH:-0}" -gt 0 ] && pop=(--popup "$K4_BAR_MX,$K4_BAR_MW,$K4_BAR_WIDTH,${K4_BAR_SIDE:-right},${K4_BAR_POS:-top}")
  data | k4 --messenger "${pop[@]}" >/dev/null
  ctl close >/dev/null; }

case "${1:-}" in
  window) shift; window "$@"; exit 0 ;;
  data) data; exit 0 ;;
  act) shift; act "$@"; exit 0 ;;
  bar) bar; exit 0 ;;
  note) shift; ctl note "$@" >/dev/null; exit 0 ;;
  find) find_rows; exit 0 ;;
  restore-login) restore_login; exit ;;
esac
k4_dispatch "$@"

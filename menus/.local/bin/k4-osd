#!/usr/bin/env bash
# k4-osd: the volume, microphone, brightness, keyboard-light, Caps Lock and layout keys with k4's
# on-screen display (the Kestrel design's KOsd board: one 400×64 box, bottom centre 64 px up,
# 1.5 s; a repeat updates it in place). Bound to the keys in Hyprland's bindings.lua (and sway's).
#   k4-osd volume up|down|mute [STEP] [boost]   5% steps up to 100% (boost: past it, up to 150%)
#   k4-osd mic mute
#   k4-osd brightness up|down [STEP]            the backlight, else the monitor over DDC; never under 5%
#   k4-osd kbd                                  the keyboard light's next step
#   k4-osd caps                                 Caps Lock's state (after the key)
#   k4-osd layout next
# Settings › Bar › On-screen display (~/.local/state/k4/osd: on, off, volume) turns it off, or
# keeps it for volume only; an Audio or Display popup already open shows the change itself.
# On Omarchy without the k4 bar running, Omarchy's own commands (and their OSD) do it instead.
set -u
export PATH="$HOME/.local/bin:$PATH"
OMARCHY=""; command -v omarchy-theme-set >/dev/null 2>&1 && OMARCHY=1
PREF=$(cat "$HOME/.local/state/k4/osd" 2>/dev/null || echo on)

clean() { local s=${1:-}; printf '%s' "${s//|/ }"; }
show() {  # show KIND FIELD=VALUE…: the box (k4 --osd; its spec is key=value fields, | between)
  local kind="$1"; shift
  [ "$PREF" = off ] && return 0
  [ "$PREF" = volume ] && [ "$kind" != volume ] && return 0
  local pop; pop=$(cat "${XDG_RUNTIME_DIR:-/tmp}/k4-popup" 2>/dev/null)   # the popup shows it itself
  if pgrep -f '^k4 --menu' >/dev/null; then
    case "$kind:$pop" in volume:audio|mic:audio|brightness:display) return 0 ;; esac
  fi
  local IFS='|'; setsid -f k4 --osd "$*" >/dev/null 2>&1 </dev/null; }
pct() { awk '{ printf "%d", $2 * 100 + 0.5 }'; }

if [ -n "$OMARCHY" ] && ! pgrep -f '^k4 --bar' >/dev/null; then
  case "${1:-} ${2:-}" in
    "volume up") exec omarchy-audio-output-volume raise ;;
    "volume down") exec omarchy-audio-output-volume lower ;;
    "volume mute") exec omarchy-audio-output-volume mute-toggle ;;
    "mic mute") exec omarchy-audio-input-mute ;;
    "brightness up") exec omarchy-brightness-display +5% ;;
    "brightness down") exec omarchy-brightness-display 5%- ;;
  esac
fi

# A device's name, and where it is (built-in, USB, Bluetooth).
dev() {  # dev @DEFAULT_AUDIO_SINK@|@DEFAULT_AUDIO_SOURCE@ -> "name<TAB>where"
  wpctl inspect "$1" 2>/dev/null | awk -F' = ' '
    /node.description/ { gsub(/"/, "", $2); n = $2 }
    /device.bus /      { gsub(/"/, "", $2); b = $2 }
    END { w = b == "bluetooth" ? "Bluetooth" : (b == "usb" ? "USB" : "built-in"); printf "%s\t%s", n, w }'; }

volume() {
  local before v p name where
  before=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | pct)
  case "${1:-}" in
    up) if [ "${3:-}" = boost ]; then wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ "${2:-1}%+"
        else wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ "${2:-5}%+"; fi
        wpctl set-mute @DEFAULT_AUDIO_SINK@ 0 ;;
    down) wpctl set-volume @DEFAULT_AUDIO_SINK@ "${2:-5}%-"; wpctl set-mute @DEFAULT_AUDIO_SINK@ 0 ;;
    mute) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
  esac
  v=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null) || exit 0
  p=$(printf '%s' "$v" | pct)
  IFS=$'\t' read -r name where <<<"$(dev @DEFAULT_AUDIO_SINK@)"; name=$(clean "${name:-Output}")
  if [[ $v == *MUTED* ]]; then
    show volume "icon=󰝟" icon_tone=red label=Muted label_tone=red "sub=$name · was $p%" "bar=$p" bar_off=1 "val=—" val_tone=red edge=red
  elif [ "$p" -gt 100 ]; then
    show volume "icon=󰕾" icon_tone=yellow label=Volume "sub=$name · above 100% can distort" sub_tone=yellow "bar=$p" "val=$p%" val_tone=yellow edge=yellow
  else
    local icon=󰕾 sub="$name · $where" flash=""
    [ "$p" -le 50 ] && icon=󰖀; [ "$p" -eq 0 ] && icon=󰕿
    [ "${1:-}" = up ] && [ "${3:-}" != boost ] && [ "$before" -ge 100 ] && { flash=last; sub="$name · max · ⇧ goes past 100"; }
    show volume "icon=$icon" label=Volume "sub=$sub" "bar=$p" "val=$p%" ${flash:+flash=$flash}
  fi; }

mic() {
  wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
  local v name app
  v=$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null) || exit 0
  IFS=$'\t' read -r name _ <<<"$(dev @DEFAULT_AUDIO_SOURCE@)"; name=$(clean "${name:-Microphone}")
  app=$(pactl -f json list source-outputs 2>/dev/null | jq -r '[.[].properties["application.name"] // empty] | first // ""' 2>/dev/null)
  if [[ $v == *MUTED* ]]; then
    show mic "icon=󰍭" icon_tone=red "label=Microphone muted" label_tone=red "line=$name${app:+ · $(clean "$app") can’t hear you}" "chips=MUTED:red:fill" edge=red
  else
    show mic "icon=󰍬" "label=Microphone on" "line=$name${app:+ · in use by $(clean "$app")}" "chips=LIVE:green" edge=green
  fi; }

brightness() {  # the backlight (brightnessctl), else the monitor over DDC (ddcutil); 5% at the least
  local step="${2:-5}" p out sub icon flash=""
  out=$(hyprctl -j monitors 2>/dev/null | jq -r '.[] | select(.focused) | .name' 2>/dev/null)
  if brightnessctl -l -c backlight >/dev/null 2>&1; then
    local before; before=$(brightnessctl -m -c backlight | awk -F, 'NR == 1 { gsub(/%/, "", $4); print $4 }')
    case "${1:-}" in
      up) brightnessctl -q -c backlight set "$step%+" ;;
      down) if [ "$before" -le $((5 + step)) ]; then brightnessctl -q -c backlight set 5%; else brightnessctl -q -c backlight set "$step%-"; fi ;;
    esac
    p=$(brightnessctl -m -c backlight | awk -F, 'NR == 1 { gsub(/%/, "", $4); print $4 }')
    sub="${out:-screen} · built-in"; icon=󰃠
    [ "${1:-}" = down ] && [ "$before" -le 5 ] && { flash=first; sub="${out:-screen} · lowest, never off"; }
  elif command -v ddcutil >/dev/null; then
    p=$(ddcutil getvcp 10 --brief 2>/dev/null | awk '{ print $4 }')
    [ -n "$p" ] || exit 0
    local n=$p
    case "${1:-}" in up) n=$((p + step)) ;; down) n=$((p - step)) ;; esac
    n=$(( n > 100 ? 100 : (n < 5 ? 5 : n) ))
    [ "${1:-}" = down ] && [ "$p" -le 5 ] && flash=first
    [ "$n" != "$p" ] && ddcutil setvcp 10 "$n" --noverify >/dev/null 2>&1
    p=$n; sub="${out:-monitor} · external · via DDC"; icon=󰍹
  else exit 0; fi
  [ "$icon" = 󰃠 ] && [ "$p" -le 20 ] && icon=󰃞
  show brightness "icon=$icon" label=Brightness "sub=$sub" "bar=$p" "val=$p%" ${flash:+flash=$flash}; }

kbd() {  # the keyboard light: its next step (Off, Low, High…)
  local d m c names=(Off Low High)
  d=$(brightnessctl -l -m 2>/dev/null | awk -F, '$1 ~ /kbd_backlight/ { print $1; exit }')
  [ -n "$d" ] || exit 0
  m=$(brightnessctl -d "$d" max); c=$(brightnessctl -d "$d" get)
  c=$(( (c + 1) % (m + 1) )); brightnessctl -q -d "$d" set "$c"
  show kbd "icon=󰌌" "icon_tone=$([ "$c" -gt 0 ] && echo accent || echo dim)" "label=Keyboard light" "sub=$((m + 1)) steps" "steps=$c/$m" "val=${names[$c]:-$c}" "val_tone=$([ "$c" -gt 0 ] && echo fg || echo dim)"; }

caps() {  # Caps Lock as it is now (bound to the key without taking it)
  local on
  on=$(hyprctl -j devices 2>/dev/null | jq -r '[.keyboards[] | select(.main) | .capsLock] | first // false')
  if [ "$on" = true ]; then show caps "icon=󰘲" "label=Caps Lock" "line=TYPING IN CAPITALS" line_tone=soft "chips=ON:accent:fill"
  else show caps "icon=󰘲" icon_tone=dim "label=Caps Lock" "line=back to normal" "chips=OFF:dim" edge=faint; fi; }

layout() {
  local was name
  if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    lay() { hyprctl -j devices | jq -r '[.keyboards[] | select(.main) | .active_keymap] | first // ""'; }
    was=$(lay); hyprctl switchxkblayout all next >/dev/null; name=$(lay)
  else
    lay() { swaymsg -t get_inputs | jq -r '[.[] | select(.type == "keyboard" and .xkb_active_layout_name) | .xkb_active_layout_name] | first // ""'; }
    was=$(lay); swaymsg input type:keyboard xkb_switch_layout next >/dev/null; name=$(lay)
  fi
  short() { case "$1" in "English (US)") echo US ;; *) printf '%s' "$1" | cut -c1-2 | tr '[:lower:]' '[:upper:]' ;; esac; }
  show layout "icon=󰗊" "label=Keyboard layout" "line=$(clean "$name")" "chips=$(short "$was"):faint,→:dim,$(short "$name"):accent:fill"; }

case "${1:-}" in
  volume) volume "${2:-}" "${3:-}" "${4:-}" ;;
  mic) mic ;;
  brightness) brightness "${2:-}" "${3:-}" ;;
  kbd) kbd ;;
  caps) caps ;;
  layout) layout ;;
  *) sed -n '2,13p' "$0" >&2; exit 2 ;;
esac

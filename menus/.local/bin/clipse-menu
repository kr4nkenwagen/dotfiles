#!/usr/bin/env bash
# clipse-menu: clipse's clipboard history in the k4 launcher: Enter copies an entry back
# (pinned first, then newest; images with a thumbnail), clear the history, start the listener.
K4_NAME=clipse-menu K4_ID=clipboard K4_TITLE=Clipboard K4_KEY=P K4_ICON=󰅌 K4_DESC="History from clipse"
. "$HOME/.local/share/k4/lib.sh"
available() { command -v clipse >/dev/null; }
missing() { missing_body "copy from your clipboard history here" "$(install_cmd clipse '' 'go install github.com/savedra1/clipse@latest')" "https://github.com/savedra1/clipse"; }
HIST="${CLIPSE_HISTORY:-$HOME/.config/clipse/clipboard_history.json}"   # CLIPSE_HISTORY: tests
recording() { pgrep -f 'clipse (-listen|--listen)|wl-paste.*clipse' >/dev/null; }
summary() { local n; n=$(jq '.clipboardHistory | length' "$HIST" 2>/dev/null || echo 0); echo "$n entries$(recording || echo ' · not recording')"; }

copy_entry() {  # copy_entry RECORDED: the entry with that timestamp back onto the clipboard
  local file val
  file=$(jq -r --arg r "$1" '.clipboardHistory[] | select(.recorded == $r) | .filePath' "$HIST")
  if [ -n "$file" ] && [ "$file" != null ] && [ -f "$file" ]; then wl-copy < "$file"; notify Copied "${file##*/}"; return; fi
  val=$(jq -r --arg r "$1" '.clipboardHistory[] | select(.recorded == $r) | .value' "$HIST")
  printf '%s' "$val" | wl-copy; notify Copied "$(printf '%s' "$val" | head -1 | cut -c1-60)"; }
rows() {  # rows true|false: recorded<TAB>epoch<TAB>first line<TAB>extra lines<TAB>image path, newest first
  local off; off=$(date +%z | sed -E 's/^([+-])([0-9]{2})([0-9]{2})$/\1(\2*3600+\3*60)/'); off=$(( off ))
  jq -r --argjson p "$1" --argjson off "$off" '.clipboardHistory[] | select(.pinned == $p) |
    ((.recorded[0:19] | strptime("%Y-%m-%d %H:%M:%S") | mktime) - $off) as $t |
    (if (.filePath // "null") != "null" then .filePath else "" end) as $img |
    (.value | split("\n") | map(select(test("\\S")))) as $lines |
    select($img != "" or ($lines | length) > 0) |
    "\(.recorded)\t\($t)\t\(if $img != "" then ($img | split("/") | last) else ($lines[0] | gsub("\t"; " ") | .[0:200]) end)\t\(if $img != "" then 0 else ($lines | length) - 1 end)\t\($img)"' "$HIST" 2>/dev/null; }
entry() {  # entry RECORDED EPOCH LABEL EXTRA IMAGE [pinned]: the design's marks (★ pinned, ¶ multi-line, ↗ link)
  local mark="" more=""
  if [ -n "$5" ]; then more="thumb=$(k4flag "$5");sub=  $(file -b "$5" 2>/dev/null | grep -oE '[0-9]+ x [0-9]+' | tr -d ' ')"
  elif [ "$4" -gt 0 ]; then mark="mark=¶"; more="sub=  +$4 lines"
  elif [[ $3 == http*://* ]]; then mark="mark=↗"; fi
  [ -n "${6:-}" ] && mark="mark=★;markc=accent"
  local flags="$mark${mark:+${more:+;}}$more"
  stay "$3" "copy_entry '$1'" "$(ago "$2")" "$flags"; }

section() {
  local pinned=() recent=() r
  [ -f "$HIST" ] && { mapfile -t pinned < <(rows true); mapfile -t recent < <(rows false); }
  local total=$(( ${#pinned[@]} + ${#recent[@]} ))
  desc "clipse · $(recording && echo "pinned first, then newest" || echo "not recording")" "$(plural "$total" entries)" "Search history…"
  hints "↵" Copy "⌫" Back
  if ! recording; then
    notice "clipse isn't recording" "New copies aren't saved until the listener runs." red
    stay "Start the listener" 'bg clipse -listen; sleep 0.5; notify Started "clipse -listen"' "clipse -listen"
  fi
  if recording || [ ${#pinned[@]} -gt 0 ]; then
    hdr "Pinned" "${#pinned[@]}"
    [ ${#pinned[@]} -gt 0 ] || empty "Nothing pinned"
    for r in "${pinned[@]}"; do IFS=$'\t' read -r a b c d e <<<"$r"; entry "$a" "$b" "$c" "$d" "$e" pinned; done
  fi
  hdr "Recent" "${#recent[@]}"
  [ ${#recent[@]} -gt 0 ] || empty "Copy something and it shows up here"
  for r in "${recent[@]:0:60}"; do IFS=$'\t' read -r a b c d e <<<"$r"; entry "$a" "$b" "$c" "$d" "$e"; done
  recording || return 0
  hdr "Manage"
  stay "Clear history…" 'clipse -clear && notify Cleared "history (pinned kept)"' "asks first" "confirm=Clear the clipboard history?|Pinned entries stay."
  item "Open clipse" 'tui clipse; close_k4' "" "" "$([ "$total" -eq 0 ] && echo current)"
}
# ---------- k4 --clip (the Kestrel design's Clipboard window; k4-clip opens it) ----------
# clip-list: S recording · R/L the runner and loader · E id epoch pinned kind label lines chars image body
# app secret (body: lines joined by \x1f, capped; app and secret 1|0 from k4-clip watch's notes, the
# nearest within 2 s); newest first as clipse keeps them.
clip_list() {
  local off; off=$(date +%z | sed -E 's/^([+-])([0-9]{2})([0-9]{2})$/\1(\2*3600+\3*60)/'); off=$(( off ))
  printf 'S\t%s\n' "$(recording && echo 1 || echo 0)"
  printf 'R\t%s clip-act\nL\t%s clip-list\n' "$SELF_PATH" "$SELF_PATH"
  [ -f "$HIST" ] || return 0
  local meta="$HOME/.local/state/k4/clip-meta.tsv"; [ -f "$meta" ] || meta=/dev/null
  jq -r --argjson off "$off" --rawfile meta "$meta" '
    ($meta | split("\n") | map(select(length > 0) | split("\t") | {t: (.[0] | tonumber? // 0), app: (.[1] // ""), s: (.[2] // "0")})) as $m |
    .clipboardHistory[] |
    ((.recorded[0:19] | strptime("%Y-%m-%d %H:%M:%S") | mktime) - $off) as $t |
    ($t + (.recorded[19:] | tonumber? // 0)) as $tf |
    ([$m[] | select((.t - $tf | fabs) <= 2)] | min_by(.t - $tf | fabs) // {app: "", s: "0"}) as $who |
    (if (.filePath // "null") != "null" then .filePath else "" end) as $img |
    (.value // "") as $v |
    ($v | gsub("\r"; "") | split("\n")) as $all |
    ($all | map(select(test("\\S")))) as $lines |
    select($img != "" or ($lines | length) > 0) |
    (if $img != "" then "image" elif ($lines | length) > 1 then "block" else "text" end) as $k |
    ["E", .recorded, ($t | tostring), (if .pinned then "1" else "0" end), $k,
     (if $img != "" then ($img | split("/") | last) else ($lines[0] | gsub("\t"; " ") | .[0:200]) end),
     ($all | length | tostring), ($v | length | tostring), $img,
     ($v[0:6000] | gsub("\t"; "    ") | gsub("\r"; "") | gsub("\n"; "\u001f")), $who.app, $who.s] | @tsv' "$HIST" 2>/dev/null; }
clip_value() { jq -j --arg r "$1" '.clipboardHistory[] | select(.recorded == $r) | .value' "$HIST"; }
clip_file() { jq -r --arg r "$1" '.clipboardHistory[] | select(.recorded == $r) | .filePath // ""' "$HIST"; }
clip_copy() {  # clip_copy ID [plain]: the entry back on the clipboard
  local f; f=$(clip_file "$1")
  if [ -n "$f" ] && [ "$f" != null ] && [ -f "$f" ]; then wl-copy < "$f"
  elif [ -n "${2:-}" ]; then clip_value "$1" | wl-copy --type text/plain
  else clip_value "$1" | wl-copy; fi; }
clip_edit() {  # clip_edit JQ-FILTER ID: change the history file in place (clipse's listener rereads it)
  local tmp="$HIST.k4.$$"
  jq --arg r "$2" "$1" "$HIST" > "$tmp" && mv "$tmp" "$HIST"; }
clip_act() {  # clip_act VERB ID
  local verb="$1" id="$2" f t
  case "$verb" in
    paste|plain) clip_copy "$id" ${verb/paste/}; sleep 0.15; wtype -M shift -k Insert -m shift 2>/dev/null ;;   # into the window k4 left
    copy) clip_copy "$id" ;;
    send)  # over LocalSend: an image as its file, text as a message
      f=$(clip_file "$id")
      if [ -n "$f" ] && [ "$f" != null ] && [ -f "$f" ]; then exec k4-share send-file "$f"
      else exec k4-share send-text "$(clip_value "$id")"; fi ;;
    pin) clip_edit '.clipboardHistory |= map(if .recorded == $r then .pinned = (.pinned | not) else . end)' "$id"
         [ "$(jq -r --arg r "$id" '.clipboardHistory[] | select(.recorded == $r) | .pinned' "$HIST")" = true ] && echo "Pinned" || echo "Unpinned" ;;
    delete) f=$(clip_file "$id"); clip_edit '.clipboardHistory |= map(select(.recorded != $r))' "$id"
            [ -n "$f" ] && [ "$f" != null ] && rm -f "$f"; echo "Deleted from history" ;;
    extra)
      f=$(clip_file "$id")
      if [ -n "$f" ] && [ "$f" != null ] && [ -f "$f" ]; then   # an image: saved to Pictures
        mkdir -p "$HOME/Pictures"; t="$HOME/Pictures/clip-$(date +%Y%m%d-%H%M%S).${f##*.}"; cp "$f" "$t"; notify Saved "${t/#$HOME/\~}"
      else   # text: opened in the editor
        t=$(mktemp --suffix=.txt "${XDG_RUNTIME_DIR:-/tmp}/clip-XXXXXX"); clip_value "$id" > "$t"; tui "${EDITOR:-nvim}" "$t"
      fi ;;
  esac; }
case "${1:-}" in
  clip-list) SELF_PATH=$(command -v clipse-menu || echo "$0"); clip_list; exit 0 ;;
  clip-act) clip_act "${2:?verb}" "${3:?id}"; exit 0 ;;
esac
k4_dispatch "$@"

#!/usr/bin/env bash
K4_NAME=k4-youtube K4_ID=youtube K4_TITLE=YouTube K4_KEY=Y K4_ICON=󰗃 K4_DESC="Search YouTube, play in a corner on every workspace"
# k4-youtube: YouTube in k4 (k4 --youtube, the Kestrel design's KYouTube board: a search, its
# results as a grid, the queue, what you watched) and its player: one mpv in a small window pinned
# to the top-left corner of every workspace (Hyprland rule for the class k4-pip), never taking
# focus (the YouTubePip board). mpv-mpris makes it an MPRIS player, so the bar's media module and
# the media keys control it. No daemon: mpv holds the queue (its playlist), youtube-mpv.lua writes
# the history (where each video stopped), this script talks to it over its socket.
#   k4-youtube window [--popup]     the window (again: closes it; from a bar click: under it)
#   k4-youtube data                 its data: S, Q, V, N, P, H lines, R and L (src/youtube.odin)
#   k4-youtube act VERB [ARG]       search QUERY (a channel named so: first, C), channel ID (its videos in
#                                   place of the search), back (the search again), clear (back to the
#                                   home page, fetched again each time the window opens), home (fetch it again),
#                                   home-more (24 more under it: the window's endless scroll),
#                                   play ID [resume], queue ID, jump N, pause, next, prev, remove N,
#                                   browser ID, pip, close, forget, install
# Nothing searched: your YouTube home page (yt-dlp's :ytrec, signed in with the browser's session:
# ~/.local/state/k4/youtube/browser, else the default browser), fetched in the background and
# again after 30 minutes.
#   k4-youtube play URL|ID          play a link (youtube.com/watch?v=…, youtu.be/…, or any video URL) or an id now
#   k4-youtube toggle               hide or show the player (Super+Alt+Y); nothing playing: the window
#   k4-youtube close                stop it
#   k4-youtube find                 what you watched and the channels you subscribe to (subs.tsv, fetched
#                                   again after 6 hours), as rows only the launcher's search shows
. "$HOME/.local/share/k4/lib.sh"
launch_row() { :; }   # (Omarchy's YouTube web app has the same name: not this)
SELF=$(command -v k4-youtube || echo "$0")
C="${K4_YOUTUBE_CACHE:-$HOME/.cache/k4/youtube}"     # search.json, results.tsv, query, error, took, thumbs/
ST="${K4_YOUTUBE_STATE:-$HOME/.local/state/k4/youtube}" # meta.tsv (id title channel seconds), history.log (time id position seconds)
LUA="$HOME/.local/share/k4/youtube-mpv.lua"
KEEP_DAYS=90
mkdir -p "$C/thumbs" "$ST"

clean() { local s=${1:-}; s=${s//[$'\t\n\r']/ }; printf '%s' "$s"; }
id_of() {  # a video's id from an id, a watch link, a youtu.be or shorts link
  local u="$1"
  case "$u" in
    *youtu.be/*) u=${u##*youtu.be/} ;;
    *v=*) u=${u##*v=} ;;
    */shorts/*) u=${u##*/shorts/} ;;
  esac
  u=${u%%[&?#/]*}; printf '%s' "$u"; }
url_of() { printf 'https://www.youtube.com/watch?v=%s' "$1"; }
nth() { case "$1" in 1) echo 1st ;; 2) echo 2nd ;; 3) echo 3rd ;; *) echo "${1}th" ;; esac; }

# ---------- the corner player (mpv over its socket; shared with k4-jellyfin) ----------

. "$HOME/.local/share/k4/pip.sh"

# ---------- what is known about a video ----------

meta() {  # meta ID: title, channel, seconds, \037 between (a tab would let read merge empty ones)
  awk -F'\t' -v id="$1" '$1 == id { t = $2; c = $3; d = $4 } END { printf "%s\037%s\037%s", t, c, d }' "$ST/meta.tsv" 2>/dev/null; }
thumb() {  # thumb ID: the thumbnail's path once it is whole (fetched in the background meanwhile)
  local f="$C/thumbs/$1.jpg"
  if [ -s "$f" ]; then echo "$f"; return; fi
  [ -e "$f.part" ] || setsid -f sh -c 'curl -fsSL --max-time 8 "https://i.ytimg.com/vi/$1/mqdefault.jpg" -o "$2.part" && mv "$2.part" "$2" || rm -f "$2.part"' _ "$1" "$f" >/dev/null 2>&1 </dev/null
  echo ""; }

# What was watched: newest first, each once, with where it stopped (time id position seconds).
watched() {  # watched N
  tac "$ST/history.log" 2>/dev/null | awk -F'\t' -v old="$(( $(date +%s) - KEEP_DAYS * 86400 ))" '$1 >= old && !seen[$2]++' | head -n "$1"; }
compact() {  # the log keeps one line a video (its last) and 90 days
  [ "$(wc -l < "$ST/history.log" 2>/dev/null || echo 0)" -gt 2000 ] || return 0
  watched 100000 | tac > "$ST/history.log.new" && mv "$ST/history.log.new" "$ST/history.log"; }
resume_at() {  # resume_at ID: where it stopped, when that is worth going back to (else nothing)
  watched 100000 | awk -F'\t' -v id="$1" '$2 == id { if ($3 > 10 && ($4 == 0 || $3 < $4 * 0.95)) print int($3); exit }'; }

# ---------- the window's data ----------

# ---------- your home page (the recommendations), with the browser's YouTube session ----------

browser() {  # the browser whose cookies yt-dlp reads: the state file, else the default browser
  local b; b=$(cat "$ST/browser" 2>/dev/null)
  [ -n "$b" ] && { echo "$b"; return; }
  b=$(omarchy-cmd-default-browser 2>/dev/null || xdg-settings get default-web-browser 2>/dev/null)
  case "$b" in
    *brave*) echo brave ;; *google-chrome*) echo chrome ;; *chromium*) echo chromium ;; *vivaldi*) echo vivaldi ;;
    *zen*) echo firefox ;; *firefox*|*librewolf*) echo firefox ;; *) echo chromium ;;
  esac; }
cookies_from() {  # what yt-dlp is told: Chromium's kind keep their key in the keyring, and yt-dlp guesses
  # wrong outside GNOME and KDE (it then decrypts none of the newer cookies, the sign-in among them)
  local b; b=$(browser)
  case "$b" in *+*|firefox) echo "$b" ;; *) busctl --user status org.freedesktop.secrets >/dev/null 2>&1 && echo "$b+gnomekeyring" || echo "$b" ;; esac; }
JAR="$ST/cookies.txt"   # a sign-in k4-vault brought from another machine: used while the browser has none
yt_auth() { if [ -e "$C/auth-jar" ] && [ -s "$JAR" ]; then printf '%s\n' --cookies "$JAR"; else printf '%s\n' --cookies-from-browser "$(cookies_from)"; fi; }
export_cookies() {  # export_cookies FILE: the browser's YouTube and Google cookies as a cookies.txt (k4-vault backup)
  local all; all=$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/k4-yt.XXXXXX"); chmod 600 "$all"
  timeout 60 yt-dlp --cookies-from-browser "$(cookies_from)" --cookies "$all" --flat-playlist --playlist-end 1 --skip-download -q --no-warnings ":ytrec" >/dev/null 2>&1
  ( umask 077; awk -F'\t' 'NF >= 7 { d = $1; sub(/^#HttpOnly_/, "", d); if (d ~ /(^|\.)(youtube|google)\.com$/) print }' "$all" > "$1.part" )   # (#HttpOnly_: the sign-in's own)
  shred -u "$all" 2>/dev/null || rm -f "$all"
  grep -q $'\tSAPISID\t\|\t__Secure-3PSID\t' "$1.part" || { rm -f "$1.part"; return 1; }   # (not signed in: nothing worth keeping)
  { echo "# Netscape HTTP Cookie File"; cat "$1.part"; } > "$1"; rm -f "$1.part"; }
home_fetch() {  # the browser's sign-in first; when it has none and k4-vault left one, that one
  rm -f "$C/auth-jar"; home_fetch_once
  local hs; IFS=$'\t' read -r hs _ < "$C/home.state" 2>/dev/null
  [ "$hs" != ok ] && [ -s "$JAR" ] && { touch "$C/auth-jar"; home_fetch_once; IFS=$'\t' read -r hs _ < "$C/home.state"; [ "$hs" = ok ] || rm -f "$C/auth-jar"; }
  return 0; }
home_fetch_once() {  # the first 24 of the home page into home.tsv; home.state: ok, signedout or error, why
  local out err n auth; mapfile -t auth < <(yt_auth)
  err=$(mktemp)
  out=$(timeout 90 yt-dlp "${auth[@]}" --flat-playlist -J --no-warnings --playlist-end 24 ":ytrec" 2>"$err")
  if grep -q "secretstorage not available" "$err"; then   # the key is in the keyring: yt-dlp needs a module to ask it
    printf 'error\t%s\n' "yt-dlp needs python-secretstorage to read $(browser)'s sign-in (sudo pacman -S python-secretstorage)" > "$C/home.state"; rm -f "$err"; return
  fi
  if [ -z "$out" ]; then
    printf 'error\t%s\n' "$(clean "$(grep -m1 'ERROR' "$err" | sed 's/^ERROR: //' | head -c 200)")" > "$C/home.state"; rm -f "$err"; return
  fi
  rm -f "$err"
  jq -r '.entries[]? | select(.id != null) | [.id, (.title // ""), (.channel // .uploader // ""), ((.duration // 0) | floor), (.view_count // 0)] | map(tostring | gsub("[\t\n\r]"; " ")) | @tsv' <<<"$out" > "$C/home.tsv.part"
  n=$(wc -l < "$C/home.tsv.part")
  if [ "$n" -eq 0 ]; then rm -f "$C/home.tsv.part"; printf 'signedout\t\n' > "$C/home.state"; return; fi
  mv "$C/home.tsv.part" "$C/home.tsv"; cut -f1-4 "$C/home.tsv" >> "$ST/meta.tsv"
  printf 'ok\t\n' > "$C/home.state"; }
home_more() {  # the next 24 after the ones listed (the scroll reached the end); only ones not listed
  # yet: the feed is new each time it is asked for, so this is "more", not "the next page"
  local n out new auth; mapfile -t auth < <(yt_auth)
  n=$(wc -l < "$C/home.tsv" 2>/dev/null || echo 0)
  out=$(timeout 90 yt-dlp "${auth[@]}" --flat-playlist -J --no-warnings --playlist-start $((n + 1)) --playlist-end $((n + 24)) ":ytrec" 2>/dev/null)
  new=$(jq -r '.entries[]? | select(.id != null) | [.id, (.title // ""), (.channel // .uploader // ""), ((.duration // 0) | floor), (.view_count // 0)] | map(tostring | gsub("[\t\n\r]"; " ")) | @tsv' <<<"$out" 2>/dev/null \
    | awk -F'\t' 'NR == FNR { seen[$1] = 1; next } !seen[$1]++' "$C/home.tsv" -)
  [ -n "$new" ] || { echo "No more right now · ^R fetches a new home page"; return; }
  printf '%s\n' "$new" >> "$C/home.tsv"; printf '%s\n' "$new" | cut -f1-4 >> "$ST/meta.tsv"
  while IFS=$'\t' read -r id _; do thumb "$id" >/dev/null; done <<<"$new"
  echo "$(wc -l <<<"$new") more"; }
home_maybe() {  # home_maybe [force]: fetch it in the background (force: now; else when older than 30 minutes; once at a time)
  local f="$C/home.state"
  [ -e "$C/home.lock" ] && [ $(( $(date +%s) - $(stat -c %Y "$C/home.lock") )) -lt 120 ] && return
  [ "${1:-}" != force ] && [ -e "$f" ] && [ $(( $(date +%s) - $(stat -c %Y "$f") )) -lt 1800 ] && return
  touch "$C/home.lock"
  setsid -f bash -c '"$0" home-fetch; rm -f "$1"' "$SELF" "$C/home.lock" >/dev/null 2>&1 </dev/null; }

subs_fetch() {  # the channels you subscribe to into subs.tsv (id name @handle subscribers), signed in as for the home page
  local out auth; mapfile -t auth < <(yt_auth)
  out=$(timeout 90 yt-dlp "${auth[@]}" --flat-playlist -J --no-warnings "https://www.youtube.com/feed/channels" 2>/dev/null)
  jq -r '.entries[]? | select(.id != null) | [.id, (.title // .channel // ""), (.uploader_id // ""), (.channel_follower_count // 0)] | map(tostring | gsub("[\t\n\r]"; " ")) | @tsv' <<<"$out" > "$C/subs.tsv.part" 2>/dev/null
  if [ -s "$C/subs.tsv.part" ]; then mv "$C/subs.tsv.part" "$C/subs.tsv"; else rm -f "$C/subs.tsv.part"; touch "$C/subs.tsv"; fi; }
subs_maybe() {  # in the background when older than 6 hours (once at a time)
  [ -e "$C/subs.lock" ] && [ $(( $(date +%s) - $(stat -c %Y "$C/subs.lock") )) -lt 120 ] && return
  [ -e "$C/subs.tsv" ] && [ $(( $(date +%s) - $(stat -c %Y "$C/subs.tsv") )) -lt 21600 ] && return
  touch "$C/subs.lock"
  setsid -f bash -c '"$0" subs-fetch; rm -f "$1"' "$SELF" "$C/subs.lock" >/dev/null 2>&1 </dev/null; }
count_short() { awk -v n="${1:-0}" 'BEGIN { if (n >= 1e6) printf "%.1fM", n / 1e6; else if (n >= 1e3) printf "%dK", n / 1e3; else printf "%d", n }' | sed 's/\.0M/M/'; }

versions() {  # yt-dlp's and mpv's versions, asked again only when either binary changed
  local key; key=$(stat -Lc %Y "$(command -v yt-dlp)" "$(command -v mpv)" 2>/dev/null | tr '\n' ' ')
  if [ "$(head -1 "$C/versions" 2>/dev/null)" != "$key" ]; then
    printf '%s\n%s\t%s' "$key" "$(yt-dlp --version 2>/dev/null)" "$(mpv --version 2>/dev/null | awk 'NR == 1 { print $2 }')" > "$C/versions"
  fi
  sed -n 2p "$C/versions" | tr -d '\n'; }
data() {
  local ok=ok note="" v
  if [ -e "$C/installing" ]; then ok=installing
  elif ! command -v mpv >/dev/null || ! command -v yt-dlp >/dev/null; then ok=missing
  elif [ -s "$C/error" ]; then ok=$(head -1 "$C/error"); note=$(clean "$(sed -n 2p "$C/error" | head -c 300)"); fi
  v=$(versions)
  printf 'S\t%s\t%s\t%s\n' "$ok" "$note" "$v"
  local vk vid vname   # the view: a search, or a channel's videos (opened from it)
  IFS=$'\t' read -r vk vid vname 2>/dev/null < "$C/view"
  [ -s "$C/query" ] && printf 'Q\t%s\t%s\t%s\t%s\t%s\n' "$(clean "$(cat "$C/query")")" "$(wc -l < "$C/results.tsv" 2>/dev/null || echo 0)" "$(cat "$C/took" 2>/dev/null)" "${vk:-search}" "$vname"
  if [ -s "$C/query" ] && [ "${vk:-search}" = search ] && [ -s "$C/channel.tsv" ]; then   # the search was a channel's name: it, first
    local cid cname chandle cfol; IFS=$'\t' read -r cid cname chandle cfol _ < "$C/channel.tsv"
    printf 'C\t%s\t%s\t%s\t%s\t%s\n' "$cid" "$cname" "$chandle" "${cfol:-0}" "$([ -s "$C/thumbs/ch-$cid.img" ] && echo "$C/thumbs/ch-$cid.img")"
  fi
  local id t ch d views
  while IFS=$'\037' read -r id t ch d views; do
    printf 'V\t%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$t" "$ch" "$d" "$views" "$(thumb "$id")"
  done < <(tr '\t' '\037' 2>/dev/null < "$C/results.tsv")
  if [ ! -s "$C/query" ] && [ "$ok" = ok ]; then   # nothing searched: the home page
    [ -e "$C/home.state" ] || home_maybe   # (none yet; a stale one is fetched again when the window opens, not under the scroll)
    local hs hwhy; IFS=$'\t' read -r hs hwhy < "$C/home.state" 2>/dev/null
    printf 'F\t%s\t%s\t%s\n' "${hs:-loading}" "$(browser)" "$hwhy"
    while IFS=$'\037' read -r id t ch d views; do
      printf 'W\t%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$t" "$ch" "$d" "$views" "$(thumb "$id")"
    done < <(tr '\t' '\037' 2>/dev/null < "$C/home.tsv")
  fi
  if running; then
    local r pause pos dur title hidden=shown pl
    r=$(ipc '{"command":["get_property","playlist"],"request_id":1}' '{"command":["get_property","pause"],"request_id":2}' \
            '{"command":["get_property","time-pos"],"request_id":3}' '{"command":["get_property","duration"],"request_id":4}' \
            '{"command":["get_property","media-title"],"request_id":5}')
    get() { jq -c --argjson n "$1" 'select(.request_id == $n) | .data' <<<"$r" 2>/dev/null; }
    pl=$(get 1); pause=$(get 2); pos=$(get 3); dur=$(get 4); title=$(get 5 | jq -r '. // ""')
    hidden && hidden=hidden
    local i=0 cur="" f c
    while IFS=$'\t' read -r f c; do
      id=$(id_of "$f"); IFS=$'\037' read -r t ch d <<<"$(meta "$id")"
      [ "$c" = true ] && { cur=$id; [ -n "$t" ] || t=$title; }
      printf 'P\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$i" "$id" "$(clean "${t:-$f}")" "$ch" "$d" "$([ "$c" = true ] && echo 1 || echo 0)" "$(thumb "$id")"
      i=$((i + 1))
    done < <(jq -r '.[]? | "\(.filename)\t\(.current // false)"' <<<"$pl")
    if [ -n "$cur" ]; then
      IFS=$'\037' read -r t ch d <<<"$(meta "$cur")"
      printf 'N\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$cur" "$(clean "${t:-$title}")" "$ch" "$([ "$pause" = true ] && echo pause || echo play)" \
        "$(printf '%.0f' "${pos:-0}" 2>/dev/null || echo 0)" "$(printf '%.0f' "${dur:-0}" 2>/dev/null || echo 0)" "$hidden" "$(thumb "$cur")"
    fi
  fi
  local ts p md
  while IFS=$'\t' read -r ts id p d; do   # what you watched, newest first, where it stopped
    IFS=$'\037' read -r t ch md <<<"$(meta "$id")"
    [ "${d:-0}" -gt 0 ] || d=${md:-0}
    printf 'H\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$ts" "$id" "$(clean "${t:-$id}")" "$ch" "${d:-0}" "$(thumb "$id")" "${p:-0}"
  done < <(watched 40)
  printf 'R\t%s act\nL\t%s data\n' "$SELF" "$SELF"; }

# ---------- actions ----------

norm() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -cd '[:alnum:]'; }
channel_match() {  # channel_match QUERY: the channel the search names (its name or @handle, as typed) into channel.tsv
  local q; q=$(norm "$1")
  [ ${#q} -ge 3 ] || { : > "$C/channel.tsv"; return; }
  local sid sname shandle sfol
  while IFS=$'\t' read -r sid sname shandle sfol; do   # one you subscribe to: no search needed
    if [ "$(norm "$sname")" = "$q" ] || [ "$(norm "${shandle#@}")" = "$q" ]; then
      printf '%s\t%s\t%s\t%s\t\n' "$sid" "$sname" "$shandle" "$sfol" > "$C/channel.tsv"; channel_avatar "$sid"; return 0; fi
  done < "$C/subs.tsv" 2>/dev/null
  timeout 20 yt-dlp --flat-playlist -J --no-warnings --playlist-end 5 "https://www.youtube.com/results?search_query=$(jq -rn --arg q "$1" '$q | @uri')&sp=EgIQAg%253D%253D" 2>/dev/null \
    | jq -r '.entries[]? | select(.id != null) | [.id, (.title // .channel // ""), (.uploader_id // ""), (.channel_follower_count // 0), ((.thumbnails // []) | last | .url // "")] | map(tostring | gsub("[\t\n\r]"; " ")) | @tsv' \
    | while IFS=$'\t' read -r id name handle fol av; do
        if [ "$(norm "$name")" = "$q" ] || [ "$(norm "${handle#@}")" = "$q" ]; then printf '%s\t%s\t%s\t%s\t%s\n' "$id" "$name" "$handle" "$fol" "$av"; break; fi
      done > "$C/channel.tsv"
  local id av; IFS=$'\t' read -r id _ _ _ av < "$C/channel.tsv" 2>/dev/null
  [ -n "$id" ] && channel_avatar "$id" "$av"
  return 0; }
channel_avatar() {  # channel_avatar ID [URL]: its picture into thumbs/ch-ID.img (no URL: asked of the channel's page)
  local id="$1" av="${2:-}"
  [ -s "$C/thumbs/ch-$id.img" ] && return 0
  [ -n "$av" ] || av=$(curl -fsSL --max-time 8 "https://www.youtube.com/channel/$id" 2>/dev/null | grep -o '<meta property="og:image" content="[^"]*"' | head -1 | sed 's/.*content="//; s/"$//')
  [ -n "$av" ] && {   # its picture (a WebP made a PNG: k4 reads no WebP)
    case "$av" in //*) av="https:$av" ;; esac
    curl -fsSL --max-time 8 "$av" -o "$C/thumbs/ch-$id.part" 2>/dev/null &&
      if head -c 4 "$C/thumbs/ch-$id.part" | grep -q 'RIFF'; then ffmpeg -v quiet -y -i "$C/thumbs/ch-$id.part" "$C/thumbs/ch-$id.png" && mv "$C/thumbs/ch-$id.png" "$C/thumbs/ch-$id.img"; rm -f "$C/thumbs/ch-$id.part"
      else mv "$C/thumbs/ch-$id.part" "$C/thumbs/ch-$id.img"; fi
  }
  return 0; }

search() {  # search QUERY: yt-dlp's first 24 (no key, no account), their thumbnails fetched meanwhile; a channel named so, besides
  local q="$*" out err t0
  printf '%s' "$q" > "$C/query"; t0=$(date +%s%N)
  rm -f "$C/view" "$C/results.search.tsv"
  channel_match "$q" & local cpid=$!   # (at the same time: a second second at most)
  err=$(mktemp)
  if ! out=$(yt-dlp --flat-playlist -J --no-warnings "ytsearch24:$q" 2>"$err"); then
    local why; why=$(grep -m1 -i 'error' "$err" | sed 's/^ERROR: //'); rm -f "$err"
    if grep -qiE 'resol|unreachable|timed out|connection|network|offline' <<<"${why:-network}"; then printf 'offline\n%s\n' "${why:-yt-dlp could not reach YouTube}" > "$C/error"
    else printf 'error\n%s\n' "${why:-yt-dlp failed}" > "$C/error"; fi
    : > "$C/results.tsv"
    echo "Search failed · $(clean "${why:-no connection}" | head -c 100)"; echo k4:tone yellow; return
  fi
  rm -f "$err" "$C/error"
  jq -r '.entries[]? | select(.id != null) | [.id, (.title // ""), (.channel // .uploader // ""), ((.duration // 0) | floor), (.view_count // 0)] | map(tostring | gsub("[\t\n\r]"; " ")) | @tsv' <<<"$out" > "$C/results.tsv"
  wait "$cpid" 2>/dev/null
  cut -f1-4 "$C/results.tsv" >> "$ST/meta.tsv"
  local n took; n=$(wc -l < "$C/results.tsv"); took=$(awk -v d="$(( $(date +%s%N) - t0 ))" 'BEGIN { printf "%.1f", d / 1e9 }')
  printf '%s' "$took" > "$C/took"
  while IFS=$'\t' read -r id _; do thumb "$id" >/dev/null; done < "$C/results.tsv"
  local cn; IFS=$'\t' read -r _ cn _ < "$C/channel.tsv" 2>/dev/null
  [ "$n" -gt 0 ] && echo "$n results · $took s${cn:+ · the channel $cn first}" || echo "Nothing for “$q”"; }

channel() {  # channel ID: its newest 30 videos in place of the search (back: the search again)
  local id="$1" name="${2:-}" out
  [ -n "$name" ] || IFS=$'\t' read -r _ name _ 2>/dev/null < "$C/channel.tsv"
  out=$(timeout 30 yt-dlp --flat-playlist -J --no-warnings --playlist-end 30 "https://www.youtube.com/channel/$id/videos" 2>/dev/null)
  [ -n "$out" ] || { echo "Could not open the channel"; echo k4:tone yellow; return; }
  [ -s "$C/results.search.tsv" ] || cp "$C/results.tsv" "$C/results.search.tsv"
  jq -r --arg ch "$name" '.entries[]? | select(.id != null) | [.id, (.title // ""), (.channel // $ch), ((.duration // 0) | floor), (.view_count // 0)] | map(tostring | gsub("[\t\n\r]"; " ")) | @tsv' <<<"$out" > "$C/results.tsv"
  cut -f1-4 "$C/results.tsv" >> "$ST/meta.tsv"
  printf 'channel\t%s\t%s\n' "$id" "$name" > "$C/view"
  while IFS=$'\t' read -r v _; do thumb "$v" >/dev/null; done < "$C/results.tsv"
  echo "$name · $(wc -l < "$C/results.tsv") newest videos · Esc goes back"; }

play() {  # play ID [resume]: now, from where it stopped when asked; the player started when it is not running
  case "$1" in   # a plain video link (a Steam trailer's mp4): played as it is, no history
    http*://*youtube.com/*|http*://youtu.be/*) ;;
    http://*|https://*)
      if running; then cmd loadfile "$1" replace; else start "$1" ""; fi
      echo "Playing in the corner player"; return ;;
  esac
  local id at=""; id=$(id_of "$1")
  [ -n "$id" ] || { echo "Not a YouTube link"; echo k4:tone red; return; }
  [ "${2:-}" = resume ] && at=$(resume_at "$id")
  if running; then
    if [ -n "$at" ]; then cmd loadfile "$(url_of "$id")" replace -1 "start=$at"; else cmd loadfile "$(url_of "$id")" replace; fi
  else start "$(url_of "$id")" "$at"; fi
  [ -n "$(meta "$id" | cut -d$'\037' -f1)" ] || printf '%s\t\t\t\n' "$id" >> "$ST/meta.tsv"
  local m="Playing in the corner player"
  [ -n "$at" ] && m="$m · resumes where you stopped"
  hidden && m="$m · hidden, y shows it"
  echo "$m"; }

queue() {  # queue ID: after the rest (already playing or queued: says so)
  local id; id=$(id_of "$1")
  if ! running; then play "$id" >/dev/null; echo "Queued · plays now, the queue was empty"; return; fi
  local pl cur at
  pl=$(prop playlist | jq -c . 2>/dev/null)
  cur=$(jq -r '[.[] | .current // false] | index(true) // 0' <<<"$pl" 2>/dev/null)
  at=$(jq -r --arg u "$id" '[.[] | .filename | contains($u)] | index(true) // -1' <<<"$pl" 2>/dev/null)
  if [ "${at:--1}" = "$cur" ]; then echo "Already playing"; return; fi
  if [ "${at:--1}" -ge 0 ]; then echo "Already in the queue · $(nth $(( at - cur )))"; return; fi
  cmd loadfile "$(url_of "$id")" append-play
  [ -n "$(meta "$id" | cut -d$'\037' -f1)" ] || printf '%s\t\t\t\n' "$id" >> "$ST/meta.tsv"
  echo "Queued · $(nth $(( $(prop playlist-count) - cur - 1 ))) up next"; }

act() {
  local verb="${1:-}"; shift || true
  case "$verb" in
    search) search "$@" ;;
    home-more) home_more ;;
    channel) channel "$1" "${2:-}" ;;
    back) if [ -e "$C/from-launcher" ]; then rm -f "$C/query" "$C/results.tsv" "$C/error" "$C/took" "$C/view" "$C/channel.tsv" "$C/results.search.tsv" "$C/from-launcher"; echo "Your home page"; return; fi
          [ -s "$C/results.search.tsv" ] && mv "$C/results.search.tsv" "$C/results.tsv"; rm -f "$C/view"; echo "Back to “$(cat "$C/query")”" ;;
    clear) rm -f "$C/query" "$C/results.tsv" "$C/error" "$C/took" "$C/view" "$C/channel.tsv" "$C/results.search.tsv" "$C/from-launcher"; echo "Your home page" ;;
    home) rm -f "$C/home.state"; home_fetch; IFS=$'\t' read -r hs _ < "$C/home.state"
          case "$hs" in ok) echo "Home page · $(wc -l < "$C/home.tsv") videos" ;; signedout) echo "Not signed in to YouTube in $(browser)"; echo k4:tone yellow ;; *) echo "Could not fetch the home page"; echo k4:tone yellow ;; esac ;;
    play) play "$1" "${2:-}"; echo k4:close ;;   # a video starts: the window goes (the player is the corner one)
    queue) queue "$1" ;;
    pause) running || { echo "Nothing playing"; return; }
           cmd cycle pause; [ "$(prop pause)" = true ] && echo "Paused · the bar module shows ‖" || echo "Playing" ;;
    next) running || { echo "Queue is empty"; return; }
          local n c; n=$(prop playlist-count); c=$(prop playlist-pos)
          if [ $(( c + 1 )) -ge "${n:-1}" ]; then echo "End of the queue · the player closes when this one ends"
          else cmd playlist-next; sleep 0.2; echo "Next · $(clean "$(prop media-title)")"; fi ;;
    prev) running || return
          if [ "$(printf '%.0f' "$(prop time-pos)")" -gt 3 ]; then cmd seek 0 absolute; echo "From the start · p again within 3 s for the previous video"
          else cmd playlist-prev; echo "Previous video"; fi ;;
    jump) running && cmd playlist-play-index "$1"; echo k4:close ;;
    remove) running && cmd playlist-remove "$1"; echo "Removed from the queue" ;;
    browser) case "$1" in UC*) open_url "https://www.youtube.com/channel/$1"; echo k4:noreload; echo "Opened the channel in the browser" ;;   # (a channel)
             *) open_url "$(url_of "$1")"; running && cmd set pause yes; echo "Opened in the browser · the player pauses" ;; esac ;;
    pip) pip_toggle || echo "The player opens when something plays" ;;
    close) running && cmd quit; echo "Stopped" ;;
    forget) : > "$ST/history.log"; echo "History cleared" ;;
    install) touch "$C/installing"   # the window shows it; the terminal asks for the password
             tui_wait "$(install_cmd "yt-dlp mpv" "yt-dlp mpv")"
             local n=0; while [ $n -lt 900 ] && ! { command -v yt-dlp && command -v mpv; } >/dev/null; do sleep 1; n=$((n + 1)); done
             rm -f "$C/installing"
             if available; then echo "yt-dlp installed · ready"; echo k4:tone green; else echo "Not installed · the terminal says why"; echo k4:tone red; fi ;;
  esac; }

# ---------- the Apps section, the launcher ----------

available() { command -v mpv >/dev/null && command -v yt-dlp >/dev/null; }
missing() {
  notice "YouTube needs yt-dlp" "yt-dlp searches and fetches the videos (3 MB). mpv, the player, $(command -v mpv >/dev/null && echo "is already installed" || echo "comes with it"). No account, nothing to sign in to."
  item "Install yt-dlp" "tui_wait $(printf %q "$(install_cmd "yt-dlp mpv" "yt-dlp mpv")")" "3 MB · ↵" "" "mark=↓;markc=accent"
  item "What it does" "open_url https://github.com/yt-dlp/yt-dlp" "github.com/yt-dlp" "" "mark=?"; }
ago_short() {  # today, yesterday, Mon, 12 Oct
  local now=${EPOCHSECONDS:-$(date +%s)}
  if [ "$(date -d "@$1" +%F)" = "$(date +%F)" ]; then echo today
  elif [ "$(date -d "@$1" +%F)" = "$(date -d "@$(( now - 86400 ))" +%F)" ]; then echo yesterday
  elif [ $(( now - $1 )) -lt $(( 7 * 86400 )) ]; then LC_ALL=C date -d "@$1" +%a
  else LC_ALL=C date -d "@$1" '+%-d %b'; fi; }
summary() {
  if running; then local q; q=$(( $(prop playlist-count) - $(prop playlist-pos) - 1 )); echo "1 playing$([ "$q" -gt 0 ] && echo " · $q queued")"
  else echo "nothing playing"; fi; }
section() {
  local w="bg $(printf %q "$SELF") window"
  desc "$(running && echo "↵ on a video plays it in the corner player · a queues it" || echo "the corner player opens when a video starts")" "$(summary)" "Search YouTube…"
  item "Search YouTube…" "$w" "opens the window · Super+Shift+Alt+Y" "" "mark=›;markc=accent"
  local id t ch d ts p
  if running; then
    hints "↑↓" Move "↵" Run "⌫" Back
    id=$(id_of "$(prop path)"); IFS=$'\037' read -r t ch d <<<"$(meta "$id")"
    local pos dur pa; pos=$(printf '%.0f' "$(prop time-pos)" 2>/dev/null); dur=$(printf '%.0f' "$(prop duration)" 2>/dev/null); pa=$(prop pause)
    card "$([ "$pa" = true ] && echo ‖ || echo ▶)" "$([ "$pa" = true ] && echo PAUSED || echo PLAYING)" "${t:-$(prop media-title)}" "$ch · $(mmss "${pos:-0}") / $(mmss "${dur:-0}")" "$(hidden && echo "hidden · audio keeps playing" || echo "in the corner player, top left")" "$([ "$pa" = true ] || echo 1)"
    stay "$(hidden && echo "Show PiP" || echo "Hide PiP")" "$(printf %q "$SELF") act pip" "Super+Alt+Y · audio keeps playing" "" "mark=▭;markc=accent"
    local n c; n=$(prop playlist-count); c=$(prop playlist-pos)
    if [ $(( n - c - 1 )) -gt 0 ]; then
      hdr "Up next" $(( n - c - 1 ))
      id=$(id_of "$(prop "playlist/$(( c + 1 ))/filename")"); IFS=$'\037' read -r t ch d <<<"$(meta "$id")"
      stay "${t:-$id}" "$(printf %q "$SELF") act next" "$(mmss "${d:-0}") · n plays it" "" "sub=  $(k4flag "$ch")$([ -s "$C/thumbs/$id.jpg" ] && echo ";thumb=$C/thumbs/$id.jpg")"
    fi
  else
    hints "↑↓" Move "↵" Play "⌫" Back
  fi
  local n=0
  while IFS=$'\t' read -r ts id p d; do
    [ $n -eq 0 ] && hdr "Recent" "$(watched 5 | wc -l)"; n=$((n + 1))
    IFS=$'\037' read -r t ch _ <<<"$(meta "$id")"
    local when; when=$(ago_short "$ts")
    [ -n "$(resume_at "$id")" ] && when="$(( ${p%.*} * 100 / (${d:-1} > 0 ? ${d:-1} : 1) ))% · $when"
    item "${t:-$id}" "$(printf %q "$SELF") act play $(printf %q "$id") resume" "$when" "" "sub=  $(k4flag "$ch")$([ -s "$C/thumbs/$id.jpg" ] && echo ";thumb=$C/thumbs/$id.jpg")"
  done < <(watched 5)
  if ! running && [ $n -gt 0 ]; then
    hdr "More"
    item "History" "$w" "$(watched 100000 | wc -l) videos · kept $KEEP_DAYS days" "" "mark=»"
    stay "Clear history" "$(printf %q "$SELF") act forget" ""
  fi; }
mmss() { local s=${1:-0}; [ "$s" -ge 3600 ] && printf '%d:%02d:%02d' $((s / 3600)) $((s / 60 % 60)) $((s % 60)) || printf '%d:%02d' $((s / 60)) $((s % 60)); }
find_rows() {  # what you watched: typing 3 letters of its title (or channel) plays it again; under apps
  local ts id p d t ch md w
  while IFS=$'\t' read -r ts id p d; do
    IFS=$'\037' read -r t ch md <<<"$(meta "$id")"
    [ -n "$t" ] || continue
    [ "${d:-0}" -gt 0 ] || d=${md:-0}
    w="watched"; [ -n "$(resume_at "$id")" ] && w="watched $(( ${p%.*} * 100 / (${d:-1} > 0 ? ${d:-1} : 1) ))%"
    item "$t" "$(printf %q "$SELF") act play $(printf %q "$id") resume" "$ch · $(mmss "${d:-0}") · $w" "" "search;words;min=3;rank=90;tag=YouTube;icon=󰗃;find=$(k4flag "$ch")"
  done < <(watched 100)
  local sid sname shandle sfol   # the channels you subscribe to: their name (or @handle) opens their videos
  while IFS=$'\t' read -r sid sname shandle sfol; do
    [ -n "$sname" ] || continue
    item "$sname" "bg $(printf %q "$SELF") window channel $(printf %q "$sid") $(printf %q "$sname")" "channel · subscribed${sfol:+ · $(count_short "$sfol") subscribers}" "" "search;words;min=2;rank=95;tag=YouTube;icon=󰗃;find=$(k4flag "$shandle")"
  done < "$C/subs.tsv" 2>/dev/null
  subs_maybe; }

window() {  # window [channel ID NAME]: on that channel's videos (the launcher's search: a channel you subscribe to)
  if [ "${1:-}" = channel ]; then
    pkill -f '^k4 --youtub[e]'
    rm -f "$C/error" "$C/took" "$C/channel.tsv" "$C/results.search.tsv"
    printf '%s' "$3" > "$C/query"; : > "$C/results.tsv"; touch "$C/from-launcher"
    channel "$2" "$3" >/dev/null || { notify YouTube "Could not open $3"; return; }
  else
    pkill -f '^k4 --youtub[e]' && exit 0
    rm -f "$C/query" "$C/results.tsv" "$C/error" "$C/took" "$C/view" "$C/channel.tsv" "$C/results.search.tsv" "$C/from-launcher"   # each time it opens: the home page,
  fi
  compact
  home_maybe force                                                                                          # fetched again (the last one shows meanwhile)
  local pop=()
  [ -n "${K4_BAR_MX:-}" ] && [ "${K4_BAR_WIDTH:-0}" -gt 0 ] && pop=(--popup "$K4_BAR_MX,$K4_BAR_MW,$K4_BAR_WIDTH,${K4_BAR_SIDE:-right},${K4_BAR_POS:-top}")
  data | k4 --youtube "${pop[@]}" >/dev/null; }

case "${1:-}" in
  window) shift; window "$@"; exit 0 ;;
  subs-fetch) subs_fetch; exit 0 ;;
  export-cookies) export_cookies "${2:?file}"; exit ;;
  data) data; exit 0 ;;
  act) shift; act "$@"; exit 0 ;;
  play) play "${2:?url or id}"; exit 0 ;;
  toggle) pip_toggle >/dev/null || window; exit 0 ;;
  close) running && cmd quit; exit 0 ;;
  find) find_rows; exit 0 ;;
  home-fetch) home_fetch; exit 0 ;;
esac
k4_dispatch "$@"

#!/usr/bin/env bash
# steam-menu: Steam in the k4 launcher, from Steam's local files (no account access).
#   steam-menu              open k4 inside the Steam section (Omarchy: Super+Ctrl+G)
#   steam-menu section      the section's lines for k4 --menu
#   steam-menu view         the games gallery for k4 (I lines, cover art)
#   steam-menu tree         the full k4 input (section, gallery, runner)
#   steam-menu part         the section's records (for k4-apps; K4_AS_PAGE=1: a page for the Sway menu)
#   steam-menu summary      one line for the Apps menu
#   steam-menu run ID       run a row's action
#   steam-menu games        appid<TAB>name<TAB>last played (epoch)<TAB>minutes<TAB>art, newest first
# Games come from every library folder's appmanifest_*.acf; Proton, the Steam Linux Runtimes
# and redistributables are left out. Last played and playtime come from the logged-in user's
# localconfig.vdf, art from Steam's library cache.
set -u
K4_NAME=steam-menu K4_ID=steam K4_TITLE=Steam K4_KEY=G K4_ICON=󰓓 K4_DESC="Your games, from Steam's local library"
. "$HOME/.local/share/k4/lib.sh"
STEAM_DIR="${STEAM_DIR:-$HOME/.local/share/Steam}"
[ -d "$STEAM_DIR" ] || STEAM_DIR="$HOME/.steam/steam"
STATUS_FILE="$K4_STATE/steam-status"   # Steam does not expose the persona state; the last one set here
steam_url() { bg steam "$1"; }   # hands the URL to the running client (or starts it)
available() { command -v steam >/dev/null; }
running() { pgrep -x steam >/dev/null || pgrep -f 'ubuntu12_32/steam' >/dev/null; }
extra() { printf 'G\tgames\tLibrary\tNewest played first · covers from Steam'"'"'s local cache\tsteam-menu view\n'; }
missing() { missing_body "launch your games from here" "$(install_cmd steam steam-installer)" "https://store.steampowered.com"; }

games() {
  python3 - "$STEAM_DIR" <<'PY'
import glob, os, re, sys
root = sys.argv[1]

def vdf(text):
    # minimal KeyValues parser: nested dicts of strings
    toks = re.findall(r'"((?:[^"\\]|\\.)*)"|([{}])', text)
    stack = [{}]; key = None
    for s, brace in toks:
        if brace == "{":
            d = {}; stack[-1][key] = d; stack.append(d); key = None
        elif brace == "}":
            stack.pop(); key = None
        elif key is None:
            key = s
        else:
            stack[-1][key] = s; key = None
    return stack[0]

def read(p):
    try:
        with open(p, encoding="utf-8", errors="replace") as f: return vdf(f.read())
    except OSError: return {}

libs = {root}
lf = read(os.path.join(root, "steamapps", "libraryfolders.vdf")).get("libraryfolders", {})
for v in lf.values():
    if isinstance(v, dict) and v.get("path"): libs.add(v["path"])

# last played / playtime of the most recently active local user
stats = {}
best = 0
for cfg in glob.glob(os.path.join(root, "userdata", "*", "config", "localconfig.vdf")):
    apps = read(cfg).get("UserLocalConfigStore", {}).get("Software", {}).get("Valve", {}).get("Steam", {}).get("apps", {})
    latest = max((int(a.get("LastPlayed", 0) or 0) for a in apps.values() if isinstance(a, dict)), default=0)
    if latest >= best:
        best = latest
        stats = {k: (int(v.get("LastPlayed", 0) or 0), int(v.get("Playtime", 0) or 0)) for k, v in apps.items() if isinstance(v, dict)}

skip = re.compile(r"^(Proton|Steam Linux Runtime|Steamworks Common|Steam ?VR|SteamVR)", re.I)
rows = []
for lib in libs:
    for m in glob.glob(os.path.join(lib, "steamapps", "appmanifest_*.acf")):
        st = read(m).get("AppState", {})
        appid, name = st.get("appid", ""), st.get("name", "")
        if not appid or not name or skip.match(name): continue
        last, mins = stats.get(appid, (int(st.get("LastPlayed", 0) or 0), 0))
        cache = os.path.join(root, "appcache", "librarycache", appid)
        art = ""
        for pat in ("header.jpg", "*/header.jpg", "library_hero.jpg", "*/library_hero.jpg", "library_600x900.jpg", "*/library_600x900.jpg", "*.jpg"):
            hits = sorted(glob.glob(os.path.join(cache, pat)))
            if hits: art = hits[0]; break
        rows.append((last, appid, name, mins, art))
for last, appid, name, mins, art in sorted(rows, key=lambda r: (-r[0], r[2].lower())):
    print(f"{appid}\t{name}\t{last}\t{mins}\t{art}")
PY
}

hours() { [ "${1:-0}" -gt 0 ] || return 0; printf '%s h' "$(thousands $(( (${1} + 30) / 60 )))"; }
played() {  # played EPOCH MINUTES -> "12 182 h · 2 d ago" (the design's tile and row meta)
  local h; h=$(hours "$2"); [ "$1" -gt 0 ] && h="${h:+$h · }$(ago "$1")"; printf '%s' "${h:-never played}"; }
status_now() { cat "$STATUS_FILE" 2>/dev/null || echo Online; }
set_status() {  # set_status Online|Away|Invisible|Offline (the stepper)
  local v="${K4_VALUE:-$1}"; mkdir -p "$K4_STATE"; echo "$v" > "$STATUS_FILE"
  steam_url "steam://friends/status/$(printf '%s' "$v" | tr '[:upper:]' '[:lower:]')"; notify Status "$v"; }
game_row() { item "$2" "steam_url steam://rungameid/$1; close_k4" "$(played "$3" "$4")" "" "app;mark=▸"; }

summary() { local id name t m art; IFS=$'\t' read -r id name t m art < <(games | head -1)
  [ -n "${name:-}" ] && printf '%s%s\n' "$name" "$([ "$t" -gt 0 ] && echo " · $(ago "$t")")" || echo "no games"; }

section() { local id name t m art n i=0 rows=()
  mapfile -t rows < <(games); n=${#rows[@]}
  if ! running; then
    desc "Steam isn't running" "$(plural "$n" games)" "Search games…"
    notice "Steam isn't running" "Games still launch (Steam starts first). Status needs Steam open." muted
    stay "Start Steam" 'bg steam; notify Starting Steam' "" current
  else
    desc "$n installed · newest played first" "$(plural "$n" games)" "Search games…"
  fi
  hints "↑↓" Move "↵" Launch "← →" Status "⌫" Back
  hdr "Recently played"
  if [ "$n" -eq 0 ]; then
    empty "No games installed yet"; item "Open the Store" "steam_url steam://store; close_k4" "opens Steam"
  else
    for i in "${!rows[@]}"; do [ "$i" -lt "$(running && echo 4 || echo 3)" ] || break
      IFS=$'\t' read -r id name t m art <<<"${rows[$i]}"; game_row "$id" "$name" "$t" "$m"; done
    running && item "All games" : "$n · grid" games
  fi
  hdr "Status"
  if running; then choice "Status" set_status "$(status_now)" "Online|Away|Invisible|Offline" "mark=●;markc=accent"
  else stay "Status" 'notify Status "needs Steam"' "needs Steam" "mark=○;dim"; fi
  running || return 0
  hdr "Open in Steam"
  item "Library" 'steam_url steam://open/games; close_k4'
  [ "$n" -gt 0 ] && item "Store" 'steam_url steam://store; close_k4'
  item "Friends" 'steam_url steam://open/friends; close_k4'
  item "Downloads" 'steam_url steam://open/downloads; close_k4'
}

view() { local id name t m art
  while IFS=$'\t' read -r id name t m art; do
    iview "$name" "steam_url steam://rungameid/$id" "$art" "" "wide;sub=$(k4flag "$(played "$t" "$m")");alt=Store page|$(k4id "steam_url steam://store/$id")"
  done < <(games)
}

case "${1:-}" in
  games) games ;;
  *) k4_dispatch "$@" ;;
esac

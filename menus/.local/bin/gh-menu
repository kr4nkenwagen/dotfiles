#!/usr/bin/env bash
# gh-menu: GitHub in the k4 launcher via the gh CLI (uses its login, no extra token):
# review requests, your open pull requests, assigned issues and notifications.
K4_NAME=gh-menu
. "$HOME/.local/share/k4/lib.sh"
# A real gh binary: Omarchy's ~/.local/bin/gh is a wrapper that prints mise status to stdout.
GH=""
for c in /usr/bin/gh /usr/local/bin/gh "$(mise which gh 2>/dev/null)" "$(command -v gh)"; do [ -x "$c" ] && { GH=$c; break; }; done
gh() { "$GH" "$@"; }
available() { [ -n "$GH" ]; }
part() { printf 'S\tgithub\tGitHub\tR\tReview requests, pull requests and notifications\t󰊤\nL\tgh-menu section\n'; }

prs() {  # prs FLAG: "repo#n<TAB>title<TAB>url<TAB>meta"
  gh search prs "$1" --state=open --limit 20 --json repository,number,title,url,isDraft,updatedAt \
    --jq '.[] | "\(.repository.nameWithOwner)#\(.number)\t\(.title)\t\(.url)\t\(if .isDraft then "draft" else "" end)"' 2>/dev/null; }
section() {
  if ! gh auth status >/dev/null 2>&1; then item "Log in to GitHub" 'tui gh auth login' "gh auth login"; return; fi
  local ref title url meta n
  hdr "Review requests"; n=0
  while IFS=$'\t' read -r ref title url meta; do item "$title" "open_url '$url'" "$ref${meta:+ · $meta}"; n=$((n+1)); done < <(prs --review-requested=@me)
  [ $n -gt 0 ] || item "Nothing to review" ':'
  hdr "Your pull requests"; n=0
  while IFS=$'\t' read -r ref title url meta; do item "$title" "open_url '$url'" "$ref${meta:+ · $meta}"; n=$((n+1)); done < <(prs --author=@me)
  [ $n -gt 0 ] || item "No open pull requests" ':'
  hdr "Assigned issues"; n=0
  while IFS=$'\t' read -r ref title url; do item "$title" "open_url '$url'" "$ref"; n=$((n+1)); done < <(gh search issues --assignee=@me --state=open --limit 20 \
      --json repository,number,title,url --jq '.[] | "\(.repository.nameWithOwner)#\(.number)\t\(.title)\t\(.url)"' 2>/dev/null)
  [ $n -gt 0 ] || item "No assigned issues" ':'
  hdr "Notifications"; n=0
  while IFS=$'\t' read -r repo title url reason; do item "$title" "open_url '$url'" "$repo · $reason"; n=$((n+1)); done < <(gh api notifications --jq '.[] |
      "\(.repository.name)\t\(.subject.title)\t\((.subject.url // .repository.html_url) | sub("api.github.com/repos"; "github.com") | sub("/pulls/"; "/pull/"))\t\({ci_activity: "CI", review_requested: "review", mention: "mention", team_mention: "team", assign: "assigned", author: "yours", comment: "comment", state_change: "state", subscribed: "watching", security_alert: "security"}[.reason] // .reason)"' 2>/dev/null | head -20)
  if [ $n -gt 0 ]; then stay "Mark all as read" 'gh api -X PUT notifications -f read=true >/dev/null && notify GitHub "notifications marked as read"' "" "confirm=Mark all notifications as read?|They stay on github.com but leave your inbox."
  else item "No unread notifications" ':'; fi
  hdr "Open"
  item "github.com" "open_url https://github.com"
  item "Your repositories" "open_url 'https://github.com/$(gh api user --jq .login 2>/dev/null)?tab=repositories'"
}
k4_dispatch "$@"

#!/usr/bin/env bash
# k4-vault: this machine's logins and keys, kept in the pass store (encrypted to your GPG key,
# pushed with it to its private repo) and brought back on a new machine by init.sh.
#   k4-vault backup [--key]    save them under machine/ in the store; the GPG key itself goes in
#                              .vault/gpg-key.asc.gpg, encrypted again with a passphrase of its own
#                              (made the first time, or again with --key); asks before pushing
#   k4-vault restore [--force] a GitHub login in the browser, the store cloned, the passphrase:
#                              then all of it back in place (each step skipped when already done;
#                              --force overwrites files that differ). Run again after logging in to
#                              the desktop for what needs the keyring.
#   k4-vault status            what the store holds, and when it was saved (names only)
# Kept: the SSH key and its config, gh's token, k4's keyring items (Wi-Fi, VPN, the Trafiklab
# key, the mail passwords), the Google sign-ins (Calendar, Gmail), Messenger's login cookies,
# YouTube's sign-in cookies, a few files (google-client.json, the keymap repo, the bus stop,
# aerc's accounts.conf). No value is ever printed or passed on a command line.
set -o pipefail
export PATH="$HOME/.local/bin:$PATH"
STORE="${PASSWORD_STORE_DIR:-$HOME/.password-store}"
export PASSWORD_STORE_DIR="$STORE"
REPO="${K4_VAULT_REPO:-kr4nkenwagen/pass}"
KEYFILE="$STORE/.vault/gpg-key.asc.gpg"
M=machine
FILES=(.config/k4/google-client.json .config/k4/keymap .local/state/k4/bus.json .config/aerc/accounts.conf .config/k4/blizzard-client.json .config/k4/wow .local/state/k4/wow/raids.json .local/state/k4/wow/addons.json .local/state/k4/wow/sessions.tsv .local/state/k4/clock/state.json .config/k4/discord-client.json .local/state/k4/parcels.json .local/state/k4/events/suggestions.json .local/state/k4/releases/follow.json .config/k4/jellyfin.json .config/k4/pihole.json)
umask 077

info() { printf '\033[1;34m:: %s\033[0m\n' "$1"; }
ok()   { printf '\033[1;32m:: %s\033[0m\n' "$1"; DONE+=("$1"); }
skip() { printf '\033[1;33m:: %s\033[0m\n' "$1" >&2; SKIPPED+=("$1"); }
die()  { printf '\033[1;31m:: %s\033[0m\n' "$1" >&2; exit 1; }
DONE=() SKIPPED=()

tmpf() { mktemp "${XDG_RUNTIME_DIR:-/tmp}/k4-vault.XXXXXX"; }
gone() { [ -e "$1" ] && { shred -u "$1" 2>/dev/null || rm -f "$1"; }; }
enc() { local s=${1//%/%25}; printf '%s' "${s//\//%2F}"; }   # a keyring name as one path part
dec() { local s=${1//%2F//}; printf '%s' "${s//%25/%}"; }
has() { [ -f "$STORE/$1.gpg" ]; }
key_ids() { cat "$STORE/.gpg-id" 2>/dev/null; }
have_key() { local ids; ids=$(key_ids); [ -n "$ids" ] && gpg --list-secret-keys $ids >/dev/null 2>&1; }

put() {  # put NAME: stdin into the store, when it is new or changed (empty input: nothing)
  local t; t=$(tmpf); cat > "$t"
  if [ ! -s "$t" ]; then gone "$t"; return 1; fi
  if has "$1" && pass show "$1" 2>/dev/null | cmp -s - "$t"; then gone "$t"; return 0; fi
  pass insert -m -f "$1" < "$t" >/dev/null; local r=$?; gone "$t"; return $r; }

# ---------- backup ----------
backup() {
  local newkey=0; [ "${1:-}" = --key ] && newkey=1
  [ -d "$STORE/.git" ] || die "No pass store at $STORE"
  have_key || die "The store's GPG key ($(key_ids)) is not in this keyring"
  local n f kind name
  for f in id_ed25519 id_ed25519.pub config; do
    [ -f "$HOME/.ssh/$f" ] && put "$M/ssh/$f" < "$HOME/.ssh/$f"
  done && ok "SSH key"
  if command -v gh >/dev/null && gh auth token >/dev/null 2>&1; then gh auth token 2>/dev/null | put "$M/gh/token" && ok "gh login"
  else skip "gh: not logged in"; fi
  if command -v k4-secret >/dev/null && ! k4-secret locked; then
    n=0
    for kind in wifi vpn token mail; do
      while IFS= read -r name; do
        [ -n "$name" ] || continue
        k4-secret lookup "$kind" "$name" | put "$M/k4/$kind/$(enc "$name")" && n=$((n + 1))
      done < <(k4-secret names "$kind")
    done
    ok "k4 keyring: $n items$(k4-secret lookup token trafiklab >/dev/null && echo ' (the Trafiklab key among them)')"
  else skip "k4 keyring: locked or missing"; fi
  n=0   # the Google sign-ins (k4-cal, k4-mail, k4-todo): their refresh tokens in the keyring
  for svc in calendar mail tasks; do
    secret-tool lookup service "k4-google-$svc" 2>/dev/null | put "$M/google/$svc" && n=$((n + 1))
  done
  [ "$n" -gt 0 ] && ok "Google sign-ins: $n" || skip "Google: no sign-in (Calendar, Gmail, Tasks)"
  local db="$HOME/.local/share/k4-messenger/meta.db"
  if [ -f "$db" ] && command -v sqlite3 >/dev/null; then
    sqlite3 -readonly "$db" "select json(json_extract(json(metadata), '\$.cookies')) from user_login limit 1" 2>/dev/null \
      | put "$M/messenger/cookies" && ok "Messenger login" || skip "Messenger: not logged in"
  else skip "Messenger: not set up"; fi
  local jar; jar=$(tmpf)
  if command -v k4-youtube >/dev/null && k4-youtube export-cookies "$jar" && put "$M/youtube/cookies.txt" < "$jar"; then ok "YouTube sign-in"
  else skip "YouTube: no sign-in in the browser"; fi
  gone "$jar"
  n=0; for f in "${FILES[@]}"; do [ -f "$HOME/$f" ] && put "$M/files/$f" < "$HOME/$f" && n=$((n + 1)); done
  ok "$n k4 files"
  if [ "$newkey" = 1 ] || [ ! -s "$KEYFILE" ]; then
    info "The GPG key goes in the repo encrypted with a passphrase: that passphrase is all that guards it on GitHub. Pick a long one."
    mkdir -p "${KEYFILE%/*}"
    local t; t=$(tmpf)
    if gpg --export-secret-keys --armor $(key_ids) > "$t" && [ -s "$t" ] &&
       gpg --yes --symmetric --cipher-algo AES256 --s2k-digest-algo SHA512 --s2k-count 65011712 -o "$KEYFILE" "$t"; then
      git -C "$STORE" add .vault && git -C "$STORE" commit -qm "k4-vault: the GPG key, passphrase-encrypted" && ok "GPG key (passphrase-encrypted)"
    else skip "GPG key: not saved"; fi
    gone "$t"
  fi
  summary
  if [ -n "$(git -C "$STORE" log '@{u}..' --oneline 2>/dev/null)" ]; then
    local a=""; [ -t 0 ] && read -rp "Push to $REPO? [y/N] " a
    case "$a" in y|Y) pass git push -q && ok "Pushed" ;; *) info "Not pushed · pass git push when ready" ;; esac
  fi; }

# ---------- restore ----------
write_back() {  # write_back NAME PATH [MODE]: the entry to a file, unless a different one is there
  local t; t=$(tmpf)
  pass show "$1" > "$t" 2>/dev/null || { gone "$t"; return 1; }
  if [ -f "$2" ] && ! cmp -s "$t" "$2" && [ "$FORCE" != 1 ]; then gone "$t"; skip "${2/#$HOME/\~} differs · kept (--force replaces it)"; return 2; fi
  mkdir -p "${2%/*}"; cat "$t" > "$2"; chmod "${3:-600}" "$2"; gone "$t"; }

restore() {
  FORCE=0; [ "${1:-}" = --force ] && FORCE=1
  if [ ! -d "$STORE/.git" ]; then
    command -v gh >/dev/null || die "gh is needed to fetch the store (github-cli)"
    gh auth status >/dev/null 2>&1 || gh auth login --web --git-protocol https -h github.com || die "Not logged in to GitHub"
    gh repo clone "$REPO" "$STORE" -- -q || die "Could not clone $REPO"
    ok "Pass store from $REPO"
  fi
  if ! have_key; then
    [ -s "$KEYFILE" ] || die "No GPG key in the store (k4-vault backup on the old machine)"
    info "The vault passphrase:"
    gpg --decrypt "$KEYFILE" 2>/dev/null | gpg --import -q 2>/dev/null
    have_key || die "The GPG key did not import (wrong passphrase?)"
    local fpr; for fpr in $(gpg --list-secret-keys --with-colons $(key_ids) | awk -F: '$1 == "fpr" { print $10 }'); do echo "$fpr:6:"; done | gpg --import-ownertrust 2>/dev/null
    ok "GPG key"
  fi
  local f
  if has "$M/ssh/id_ed25519"; then
    mkdir -p "$HOME/.ssh"; chmod 700 "$HOME/.ssh"
    write_back "$M/ssh/id_ed25519" "$HOME/.ssh/id_ed25519" 600
    write_back "$M/ssh/id_ed25519.pub" "$HOME/.ssh/id_ed25519.pub" 644
    has "$M/ssh/config" && write_back "$M/ssh/config" "$HOME/.ssh/config" 600
    git -C "$STORE" remote set-url origin "git@github.com:$REPO.git"
    ok "SSH key"
  fi
  if command -v gh >/dev/null && ! gh auth status >/dev/null 2>&1 && has "$M/gh/token"; then
    pass show "$M/gh/token" | gh auth login --with-token -h github.com && gh config set git_protocol ssh -h github.com && ok "gh login"
  fi
  if [ -d "$STORE/$M/k4" ]; then
    if command -v k4-secret >/dev/null && ! k4-secret locked; then
      local p kind name n=0
      while IFS= read -r p; do
        p=${p#"$STORE/$M/k4/"}; p=${p%.gpg}; kind=${p%%/*}; name=$(dec "${p#*/}")
        pass show "$M/k4/$p" | k4-secret store "$kind" "$name" && n=$((n + 1))
      done < <(find "$STORE/$M/k4" -name '*.gpg' -type f)
      ok "k4 keyring: $n items"
    else skip "k4 keyring: locked or not running (k4-vault restore again after logging in)"; fi
  fi
  if [ -d "$STORE/$M/google" ]; then
    if command -v secret-tool >/dev/null && command -v k4-secret >/dev/null && ! k4-secret locked; then
      local svc n=0
      for svc in calendar mail tasks; do
        has "$M/google/$svc" || continue
        pass show "$M/google/$svc" | secret-tool store --label="k4 Google ${svc^}" service "k4-google-$svc" && n=$((n + 1))
      done
      ok "Google sign-ins: $n"
    else skip "Google sign-ins: keyring locked or not running (k4-vault restore again after logging in)"; fi
  fi
  has "$M/youtube/cookies.txt" && write_back "$M/youtube/cookies.txt" "$HOME/.local/state/k4/youtube/cookies.txt" && ok "YouTube sign-in"
  if has "$M/messenger/cookies"; then
    local mr="$HOME/.local/state/k4/messenger-restore.json"
    FORCE=1 write_back "$M/messenger/cookies" "$mr"   # (a handoff to k4-messenger: always the saved one)
    if command -v k4-messenger >/dev/null && k4-messenger restore-login >/dev/null 2>&1; then ok "Messenger login"
    else ok "Messenger login (used when Messenger is set up)"; fi
  fi
  local n=0
  for f in "${FILES[@]}"; do has "$M/files/$f" && write_back "$M/files/$f" "$HOME/$f" && n=$((n + 1)); done
  [ "$n" -gt 0 ] && ok "$n k4 files"
  summary; }

status() {
  [ -d "$STORE/.git" ] || die "No pass store at $STORE"
  printf 'GPG key  %s\n' "$([ -s "$KEYFILE" ] && git -C "$STORE" log -1 --format='saved %cr' -- .vault || echo 'not saved (k4-vault backup)')"
  local p; while IFS= read -r p; do
    p=${p#"$STORE/"}
    printf '%-44s %s\n' "${p%.gpg}" "$(git -C "$STORE" log -1 --format='%cr' -- "$p")"
  done < <(find "$STORE/$M" -name '*.gpg' -type f 2>/dev/null | sort); }

summary() {
  [ ${#SKIPPED[@]} -gt 0 ] && { printf '\nSkipped:\n'; printf '  %s\n' "${SKIPPED[@]}"; }
  return 0; }

case "${1:-}" in
  backup) shift; backup "$@" ;;
  restore) shift; restore "$@" ;;
  status) status ;;
  *) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac

#!/usr/bin/env bash
# k4-bar: the status bar drawn by k4 (k4 --bar), one per output, the modules of Omarchy's
# Quickshell bar; clicks open the matching k4 page as a popup under the module.
#   k4-bar                 (re)start a bar on every active output (the sway config / Hyprland autostart runs it)
#   k4-bar stop
#   k4-bar spec            the module list k4 --bar reads
#   k4-bar status MODULE   one module's line (Waybar JSON); --follow keeps printing on changes
# Modules (left · center · right): menu, workspaces, window · clock, media · indicators (do not
# disturb, night light, recording, stay awake: each shown only when on), updates, weather,
# microphone, audio, network, bluetooth, brightness, battery, keyboard (the Kestrel bar design).
set -u
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:/snap/bin:$PATH"
SELF=$(readlink -f "$0")
STATE="$HOME/.local/state/sway"
OMARCHY=""; command -v omarchy-theme-set >/dev/null 2>&1 && OMARCHY=1
HYPR=""; [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && HYPR=1

# one module line: k4's JSON (Waybar's text/tooltip/class plus icon, tones, text2, level, battery)
# out KEY VALUE…: percentage, level and battery are numbers; no pairs prints {} (hidden)
out() { local args=() expr="" k v
  while [ $# -ge 2 ]; do k=$1 v=$2; shift 2
    [ -n "$v" ] || continue
    case "$k" in percentage|level|battery) args+=(--argjson "$k" "$v") ;; *) args+=(--arg "$k" "$v") ;; esac
    expr+="$k: \$$k, "
  done
  jq -cn "${args[@]}" "{${expr%, }}"; }
follow() {  # follow CMD-THAT-PRINTS-EVENTS: print the module now and after every burst of events
  "$SELF" status "$MOD"
  "$@" 2>/dev/null | while read -r -t 86400 _; do
    while read -r -t 0.15 _; do :; done   # coalesce a burst
    "$SELF" status "$MOD"
  done; }
vol_icon() { if [ "$1" -ge 66 ]; then echo 󰕾; elif [ "$1" -ge 33 ]; then echo 󰖀; else echo 󰕿; fi; }

status() {
  MOD=$1
  case "$1" in
  media)  # any MPRIS player: note and title · artist; paused dims; nothing playing hides
    command -v playerctl >/dev/null || { out; return; }
    local st t a
    st=$(playerctl status 2>/dev/null) || { out; return; }
    t=$(playerctl metadata title 2>/dev/null); a=$(playerctl metadata artist 2>/dev/null)
    [ -n "$t" ] || { out; return; }
    if [ "$st" = Playing ]; then out icon 󰝚 icon_tone accent text "$t" text2 "$a" tooltip "$t — $a"
    else out icon 󰏤 text "$t" text2 "$a" class dim tooltip "Paused · $t — $a"; fi ;;
  dnd)  # k4's notifications: the bell with the unread count (crossed out with do not disturb)
    local st n d
    if st=$(k4 --notify-ctl status 2>/dev/null); then
      n=${st%%$'\t'*}; d=${st##*$'\t'}
      if [ "$d" = 1 ]; then out icon 󰂛 icon_tone dim text "$([ "$n" -gt 0 ] && echo "$n")" class dim tooltip "Do not disturb · $n notifications · right click turns it off"
      elif [ "$n" -gt 0 ]; then out icon 󰂚 icon_tone accent text "$n" text_tone accent tooltip "$n notifications · Super+N"
      else out icon 󰂜 icon_tone dim tooltip "No notifications · Super+N"; fi
      return
    fi
    if [ -n "$OMARCHY" ]; then case "$(omarchy-shell notifications isDnd 2>/dev/null)" in on|true) ;; *) out; return ;; esac
    else makoctl mode 2>/dev/null | grep -qx do-not-disturb || { out; return; }; fi
    out icon 󰍶 tooltip "Do not disturb · click turns it off" ;;
  night)
    if [ -n "$OMARCHY" ]; then local t; t=$(hyprctl hyprsunset temperature 2>/dev/null | grep -oE '^[0-9]+' | head -1); [ -n "$t" ] && [ "$t" -lt 6000 ] || { out; return; }
    else pgrep -x wlsunset >/dev/null || { out; return; }; fi
    out icon 󰖔 tooltip "Night light · click turns it off" ;;
  rec)  # counts up while recording
    local pid=""
    if [ -n "$OMARCHY" ]; then pid=$(pgrep -f '^gpu-screen-recorder' | head -1)
    elif [ -f "$HOME/.cache/sway-menu/recording.pid" ]; then pid=$(cat "$HOME/.cache/sway-menu/recording.pid"); kill -0 "$pid" 2>/dev/null || pid=""; fi
    [ -n "$pid" ] || { out; return; }
    local s; s=$(ps -o etimes= -p "$pid" 2>/dev/null | tr -d ' '); s=${s:-0}
    out icon 󰑋 icon_tone red text "$(printf '%02d:%02d' $((s / 60)) $((s % 60)))" text_tone red tooltip "Recording · click stops it" ;;
  reminder)  # a meeting within 10 minutes (Google Calendar, k4-cal): the bell, its time; notified once
    command -v k4-cal >/dev/null || { out; return; }
    local now st en title video
    now=$(date +%s)
    while IFS=$'\t' read -r st en title video; do
      [ -n "$st" ] && [ "$st" -gt "$now" ] && [ $((st - now)) -le 600 ] || continue
      local seen="$HOME/.cache/k4/cal/notified"
      if ! grep -qx "$st $title" "$seen" 2>/dev/null; then
        mkdir -p "${seen%/*}"; echo "$st $title" >> "$seen"
        notify-send -a k4 "$title" "In $(( (st - now + 59) / 60 )) min${video:+ · $video}" 2>/dev/null
      fi
      out icon 󰂚 icon_tone yellow text "$(date -d "@$st" +%H:%M)" text_tone yellow tooltip "$title in $(( (st - now + 59) / 60 )) min · click opens the calendar"
      return
    done < <(k4-cal next 2>/dev/null)
    out ;;
  calsync)  # Google Calendar every 5 minutes (hidden; the clock and the reminder read what it wrote)
    command -v k4-cal >/dev/null && k4-cal sync --quiet >/dev/null 2>&1
    out ;;
  awake)
    if [ -n "$OMARCHY" ]; then [ -f "$HOME/.local/state/omarchy/indicators/stay-awake" ] || { out; return; }
    else pgrep -x swayidle >/dev/null && { out; return; }; fi
    out icon 󰅶 tooltip "Stay awake (idle lock off) · click turns the lock back on" ;;
  updates)
    local n
    if command -v checkupdates >/dev/null; then n=$(checkupdates --nocolor 2>/dev/null | wc -l)
    else n=$(apt list --upgradable 2>/dev/null | grep -c upgradable) || true; fi
    [ "${n:-0}" -gt 0 ] || { out; return; }
    out icon 󰇚 icon_tone blue text "$([ "$n" -gt 99 ] && echo 99+ || echo "$n")" tooltip "$n updates waiting · click updates · right click checks now" ;;
  weather)  # icon and temperature; offline: the last value, dim, with a yellow !
    local j; j=$(sway-weather 2>/dev/null) || { out icon 󰑓 text "–°" class dim; return; }
    local text cls tip icon temp
    text=$(jq -r '.text // ""' <<<"$j"); cls=$(jq -r '.class // ""' <<<"$j"); tip=$(jq -r '.tooltip // ""' <<<"$j")
    icon=${text%% *}; temp=${text#* }; [ "$temp" = "$text" ] && temp=""
    case "$cls" in
      stale) out icon "$icon" text "$temp" class dim text2 "!" text2_tone yellow tooltip "$(sed -n '2p;$p' <<<"$tip")" ;;
      error) out icon 󰼯 text "–°" class dim tooltip "Weather unavailable" ;;
      *) out icon "$icon" text "$temp" tooltip "$(sed -n 2p <<<"$tip" | sed 's/^[^ ]* //') · fetched $(date -r "$HOME/.cache/sway-weather.json" +%H:%M 2>/dev/null)" ;;
    esac ;;
  microphone)  # icon only; the wheel shows the level for a moment (flash)
    local v p; v=$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null) || { out; return; }
    p=$(printf '%s' "$v" | awk '{ printf "%d", $2 * 100 + 0.5 }')
    if [[ $v == *MUTED* ]]; then out icon 󰍭 icon_tone red tooltip "Microphone muted · click unmutes" percentage "$p"
    else out icon 󰍬 tooltip "Microphone $p% · click mutes · scroll changes it" percentage "$p"; fi ;;
  audio)
    local v p name; v=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null) || { out icon 󰝟 text "no output" class dim tooltip "No output device"; return; }
    p=$(printf '%s' "$v" | awk '{ printf "%d", $2 * 100 + 0.5 }')
    name=$(wpctl inspect @DEFAULT_AUDIO_SINK@ 2>/dev/null | sed -n 's/.*node.description = "\(.*\)"/\1/p' | head -1)
    if [[ $v == *MUTED* ]]; then out icon 󰝟 icon_tone red text muted text_tone dim tooltip "$name · muted" percentage "$p"
    elif [ "$p" -eq 0 ]; then out icon 󰕿 text "0%" class dim tooltip "$name · 0%" percentage 0
    elif [ "$p" -gt 100 ]; then out icon 󰕾 text "$p%" text_tone yellow tooltip "$name · $p% (boosted)  ·  scroll to change" percentage "$p"
    else out icon "$(vol_icon "$p")" text "$p%" tooltip "$name · $p%  ·  scroll to change" percentage "$p"; fi ;;
  network)  # icon only; SSID, signal and IP in the tooltip; a VPN adds the shield
    local dev type state ssid sig ip vpn=""
    IFS=: read -r dev type state < <(nmcli -t -f DEVICE,TYPE,STATE dev 2>/dev/null | awk -F: '$3 == "connected" && ($2 == "wifi" || $2 == "ethernet") { print; exit }')
    nmcli -t -f TYPE,STATE connection show --active 2>/dev/null | grep -qE '^(vpn|wireguard):' && vpn=󰒃
    ip=$( [ -n "${dev:-}" ] && ip -4 -br addr show "$dev" 2>/dev/null | awk '{ sub(/\/.*/, "", $3); print $3 }')
    if [ "${type:-}" = wifi ]; then
      IFS=: read -r ssid sig < <(nmcli -t -f ACTIVE,SSID,SIGNAL dev wifi 2>/dev/null | awk -F: '$1 == "yes" { print $2 ":" $3; exit }')
      local i=󰤟; [ "${sig:-0}" -ge 25 ] && i=󰤢; [ "${sig:-0}" -ge 50 ] && i=󰤥; [ "${sig:-0}" -ge 75 ] && i=󰤨
      out icon "$i" text2 "$vpn" text2_tone accent tooltip "$ssid · $sig% · $ip${vpn:+ · VPN on}"
    elif [ "${type:-}" = ethernet ]; then out icon 󰈀 text2 "$vpn" text2_tone accent tooltip "Ethernet ($dev) · $ip${vpn:+ · VPN on}"
    elif [ "$(nmcli radio wifi 2>/dev/null)" = disabled ]; then out icon 󰤮 class dim tooltip "Wi-Fi off · right click turns it on"
    else out icon 󰤭 icon_tone red tooltip Disconnected; fi ;;
  bluetooth)
    command -v bluetoothctl >/dev/null || { out; return; }
    if ! bluetoothctl show 2>/dev/null | grep -q "Powered: yes"; then out icon 󰂲 class dim tooltip "Bluetooth off · right click turns it on"; return; fi
    local mac name n=0 tips="" low=""
    while read -r _ mac name; do
      n=$((n + 1))
      local b; b=$(bluetoothctl info "$mac" 2>/dev/null | sed -n 's/.*Battery Percentage: 0x[0-9a-f]* (\([0-9]*\)).*/\1/p')
      tips+="$name${b:+ · $b%}"$'\n'
      [ -n "$b" ] && [ "$b" -le 20 ] && low="$b%"
    done < <(bluetoothctl devices Connected 2>/dev/null | grep '^Device')
    if [ "$n" -eq 0 ]; then out icon 󰂯 tooltip "Bluetooth on · nothing connected"
    else out icon 󰂱 icon_tone accent text "$([ "$n" -gt 1 ] && echo "$n")" text2 "$low" text2_tone yellow tooltip "${tips%$'\n'}"; fi ;;
  brightness)  # icon with a level bar; the wheel shows the number for a moment
    ls /sys/class/backlight/* >/dev/null 2>&1 || { out; return; }
    local p; p=$(brightnessctl -m 2>/dev/null | awk -F, 'NR == 1 { gsub(/%/, "", $4); print $4 }')
    [ -n "$p" ] || { out; return; }
    out icon 󰃠 level "$p" percentage "$p" tooltip "Brightness $p%  ·  scroll to change" ;;
  keyboard)  # the layout code, dim; with more than two layouts its position follows
    local name idx n
    if [ -n "$HYPR" ]; then
      IFS=$'\t' read -r name idx n < <(hyprctl -j devices 2>/dev/null | jq -r '[.keyboards[] | select(.main)] | first // {} | [.active_keymap // "", (.active_layout_index // 0), ((.layout // "") | split(",") | length)] | @tsv')
    else
      IFS=$'\t' read -r name idx n < <(swaymsg -t get_inputs 2>/dev/null | jq -r '[.[] | select(.type == "keyboard" and .xkb_active_layout_name)] | first // {} | [.xkb_active_layout_name // "", (.xkb_active_layout_index // 0), ((.xkb_layout_names // []) | length)] | @tsv')
    fi
    [ -n "${name:-}" ] || { out; return; }
    out text "$(printf '%s' "$name" | cut -c1-2 | tr '[:upper:]' '[:lower:]')" class dim text2 "$([ "${n:-0}" -gt 2 ] && echo "$((idx + 1))/$n")" tooltip "$name · click for the next layout" ;;
  battery)  # the glyph and percentage; yellow at 25%, a red block at 10%; hidden without one
    local b; b=$(ls -d /sys/class/power_supply/BAT* 2>/dev/null | head -1)
    [ -n "$b" ] || { out; return; }
    local c st cls=""; c=$(cat "$b/capacity"); st=$(cat "$b/status")
    case "$st" in
      Charging) out icon 󱐋 icon_tone accent battery "$c" text "$c%" tooltip "Charging · $c%" ;;
      Full|"Not charging") out icon 󰚥 icon_tone dim battery "$c" text full text_tone dim tooltip "Full · on AC" ;;
      *) [ "$c" -le 10 ] && cls=critical || { [ "$c" -le 25 ] && cls=warning; }
         out battery "$c" text "$c%" class "$cls" tooltip "$st · $c%" ;;
    esac ;;
  esac; }

follow_status() {  # status, then again on every change of what it shows
  MOD=$1
  case "$1" in
    media) follow playerctl --follow status ;;
    microphone|audio) follow sh -c 'pactl subscribe | grep --line-buffered -E "sink|source|server"' ;;
    network) follow nmcli monitor ;;
    keyboard) if [ -n "$HYPR" ]; then follow sh -c 'socat -U - "UNIX-CONNECT:$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock" | grep --line-buffered "^activelayout>>"'
              else follow swaymsg -m -t subscribe '["input"]'; fi ;;
    *) status "$1" ;;
  esac; }

# id side kind arg interval tone left right middle up down flags ("-" = none)
spec() {
  local p="$SELF popup" c="sway-menu call"
  printf 'B\theight=26\tposition=%s\ttransparent=%s\n' "$(cat "$STATE/bar-position" 2>/dev/null || echo top)" "$([ "$(cat "$STATE/bar-background" 2>/dev/null)" = transparent ] && echo 1 || echo 0)"
  m() { local IFS=$'\t'; printf 'M\t%s\n' "$*"; }
  m menu left icon 󰕰 0 accent "$p menu" "${TERMINAL:-ghostty}" - - - "px=9"
  m workspaces left workspaces - 0 - - - - - - -
  m window left window - 0 - - - - - - -
  m clock center clock "%H:%M;%a %d %b|%Y-%m-%d %H:%M:%S;w%V" 0 - "$p calendar" - - - - "px=10;next=~/.cache/k4/cal/today.tsv"
  m media center exec "$SELF status media --follow" 0 - "$p spotify" - "playerctl play-pause" "playerctl previous" "playerctl next" "maxw=200;maxw2=140;compact"
  m dnd right exec "$SELF status dnd" 1 - "k4-notify center" "$c toggle_dnd" - - - - "px=5"
  m night right exec "$SELF status night" 3 - "$c toggle_night" - - - - "px=5"
  m rec right exec "$SELF status rec" 1 - "$c record_toggle" - - - - "px=5"
  m awake right exec "$SELF status awake" 3 - "$c toggle_idle" - - - - "px=5"
  m reminder right exec "$SELF status reminder" 30 - "$p calendar" - - - - "px=5"
  m calsync right exec "$SELF status calsync" 300 - - - - - - -
  m share right exec "k4-share bar" 1 - "k4-share bar-click" "k4-share cancel" - - - "px=6"   # a LocalSend transfer, only while one moves
  m pin0 right exec "k4-tray pinned 0" 3 - "k4-tray pin-click 0" "k4-tray pin-click 0 menu" - - - "px=4"   # tray apps pinned to the bar
  m pin1 right exec "k4-tray pinned 1" 3 - "k4-tray pin-click 1" "k4-tray pin-click 1 menu" - - - "px=4"
  m pin2 right exec "k4-tray pinned 2" 3 - "k4-tray pin-click 2" "k4-tray pin-click 2 menu" - - - "px=4"
  m tray right exec "k4-tray status" 3 - "k4-tray popup" "k4-tray popup" - - - "px=6"   # the tray: chevron, count, red count needing you
  m updates right exec "$SELF status updates" 3600 - "$p update" "$SELF status updates >/dev/null" - - - -
  m perf right exec "k4-perf bar" 2 - "k4-perf popup" "k4-perf util btop" - - - "px=7"   # CPU and memory in use; the System popup
  m weather right exec "$SELF status weather" 900 - "$p weather" "rm -f ~/.cache/sway-weather.json" - - - -
  m microphone right exec "$SELF status microphone --follow" 0 - "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle" - "$p audio" "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SOURCE@ 5%+" "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-" "flash"
  m audio right exec "$SELF status audio --follow" 0 - "$p audio" "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" - "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+" "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-" -
  m network right exec "$SELF status network --follow" 0 - "$p wifi" "nmcli radio wifi \"\$(nmcli radio wifi | grep -q enabled && echo off || echo on)\"" - - - -
  m bluetooth right exec "$SELF status bluetooth" 5 - "$p bt" "bluetoothctl power \"\$(bluetoothctl show | grep -q 'Powered: yes' && echo off || echo on)\"" - - - -
  m brightness right exec "$SELF status brightness" 2 - "$p display" - - "brightnessctl set 5%+" "brightnessctl set 5%-" "flash"
  m battery right exec "$SELF status battery" 30 - "$p battery" - - - - -
  m keyboard right exec "$SELF status keyboard --follow" 0 - "$c kb_cycle" - - - - -
}

popup() {  # popup PAGE: the k4 page under the clicked module; a second click closes it, another
  # module's click swaps it for that one
  local cur="${XDG_RUNTIME_DIR:-/tmp}/k4-popup"
  if pgrep -f "^k4 --menu" >/dev/null; then
    pkill -f "^k4 --menu"
    [ "$(cat "$cur" 2>/dev/null)" = "$1" ] && { rm -f "$cur"; exit 0; }
    sleep 0.1
  fi
  echo "$1" > "$cur"
  case "$1" in
    spotify) command -v spotify-menu >/dev/null && exec spotify-menu ;;
    *) exec sway-menu "$1" ;;
  esac; }

start() {
  stop
  command -v k4 >/dev/null || { echo "k4-bar: k4 is not installed" >&2; exit 1; }
  local o spec; spec=$(spec)
  # on Omarchy its own Quickshell bar steps aside (omarchy-toggle-bar on = hidden)
  [ -n "$OMARCHY" ] && omarchy-toggle-bar on >/dev/null 2>&1
  for o in $(outputs); do
    printf '%s\n' "$spec" | setsid -f k4 --bar --output "$o" >/dev/null 2>&1
  done; }
outputs() {
  if [ -n "$HYPR" ]; then hyprctl -j monitors 2>/dev/null | jq -r '.[].name'
  else swaymsg -t get_outputs 2>/dev/null | jq -r '.[] | select(.active) | .name'; fi; }
stop() { pkill -f '^k4 --bar' 2>/dev/null; return 0; }

case "${1:-}" in
  "") start ;;
  stop) stop ;;
  spec) spec ;;
  status) if [ "${3:-}" = --follow ]; then follow_status "${2:?module}"; else status "${2:?module}"; fi ;;
  popup) popup "${2:?page}" ;;
  *) sed -n '2,9p' "$0" >&2; exit 2 ;;
esac

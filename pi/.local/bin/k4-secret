#!/usr/bin/env bash
# k4-secret on the Pi: the same interface as the desktop's (lookup, store, clear, names, count, locked),
# without a keyring: one file per secret, 0600, in ~/.local/state/k4/secrets/KIND/ (named by the name in
# base64url). k4-pi enroll fills it from the desktop's keyring over ssh; nothing is ever printed but a lookup.
#   k4-secret lookup KIND NAME | store KIND NAME (stdin) | clear KIND NAME | names KIND | count | locked
D="${K4_SECRETS_DIR:-$HOME/.local/state/k4/secrets}"
enc() { printf '%s' "$1" | base64 -w0 | tr '+/' '-_' | tr -d '='; }
dec() { local s; s=$(printf '%s' "$1" | tr -- '-_' '+/'); while [ $(( ${#s} % 4 )) -ne 0 ]; do s="$s="; done; printf '%s' "$s" | base64 -d; }
f() { printf '%s/%s/%s' "$D" "$1" "$(enc "$2")"; }
case "${1:-}" in
  lookup) [ -s "$(f "$2" "$3")" ] || exit 1; cat "$(f "$2" "$3")" ;;
  store) umask 077; mkdir -p "$D/$2"; cat > "$(f "$2" "$3").tmp" && mv "$(f "$2" "$3").tmp" "$(f "$2" "$3")" ;;
  clear) rm -f "$(f "$2" "$3")" ;;
  names) for x in "$D/${2:?kind}"/*; do [ -e "$x" ] && { dec "$(basename "$x")"; echo; }; done ;;
  count) find "$D" -type f 2>/dev/null | wc -l ;;
  locked) exit 1 ;;   # never locked: the files are the store
  unlock) exit 0 ;;
  *) sed -n '2,6p' "$0" >&2; exit 2 ;;
esac

#!/usr/bin/env bash
# sway-weather: weather for waybar's custom/weather module, the stand-in for the
# omarchy-shell weather panel. Same sources as Omarchy: location from a saved file
# or wttr.in's IP lookup, conditions and a 4-day forecast from open-meteo.
#   sway-weather                 print one waybar JSON line (text, tooltip, class)
#   sway-weather --tooltip       print the tooltip text (menu rows, notifications)
#   sway-weather --unit          print metric|imperial
#   sway-weather --toggle-units
#   sway-weather --search QUERY  geocode: lines "Name, Region, Country · lat, lon"
#   sway-weather --set-location "Name, Region, Country · lat, lon"
#   sway-weather --clear-location   back to automatic (IP) location
#   sway-weather --refresh       make waybar re-run this script (signal 8)
#   sway-weather --report now|day|week   plain text: current, next 24 hours, 7-day forecast
#   sway-weather --rows          now/today/tomorrow<TAB>summary, from the last fetch (menu rows)
#   sway-weather --location      the location name, or "Automatic"
#   sway-weather --k4 [refresh]   the k4 Weather dashboard: WN/WD/WH/WY records (current, details,
#                                 hourly, 7 days) from a fetch cached for 10 minutes
set -u
# sway launches us with the login environment, which lacks the dirs init.sh installs
# into (awww, theme-color, bluetui, wiremix, lazygit). Fish adds them for terminals only.
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$HOME/go/bin:/usr/local/go/bin:$PATH"

STATE="$HOME/.local/state/sway/weather.json"        # {name, latitude, longitude, unit}
CACHE="$HOME/.cache/sway-weather.json"              # last successful waybar output
AUTO="$HOME/.cache/sway-weather-location.json"      # IP-detected location
CURL=(curl -fs --max-time 8)   # quiet: failures fall back to the cache

jqs() { jq -r "$1" "$2" 2>/dev/null; }
unit() { local u; u=$(jqs '.unit // empty' "$STATE"); [ "$u" = imperial ] && echo imperial || echo metric; }
state_set() {  # state_set JQ-FILTER
  mkdir -p "$(dirname "$STATE")"
  local cur; cur=$(cat "$STATE" 2>/dev/null); [ -n "$cur" ] || cur='{}'
  printf '%s' "$cur" | jq "$1" > "$STATE.tmp" && mv "$STATE.tmp" "$STATE"
}
refresh() { pkill -RTMIN+8 -x waybar 2>/dev/null; return 0; }   # (the k4 bar runs its module again after a click)

location() {  # prints "name<TAB>lat<TAB>lon"
  local n la lo
  n=$(jqs '.name // empty' "$STATE"); la=$(jqs '.latitude // empty' "$STATE"); lo=$(jqs '.longitude // empty' "$STATE")
  if [ -n "$la" ] && [ -n "$lo" ]; then printf '%s\t%s\t%s\n' "${n:-$la,$lo}" "$la" "$lo"; return; fi
  # automatic: cached for a day, otherwise ask wttr.in which area the IP is in
  if [ -f "$AUTO" ] && [ "$(( $(date +%s) - $(stat -c %Y "$AUTO") ))" -lt 86400 ]; then
    jq -r '[.name, .latitude, .longitude] | @tsv' "$AUTO" 2>/dev/null && return
  fi
  local j
  mkdir -p "$(dirname "$AUTO")"
  j=$("${CURL[@]}" --max-time 5 'https://wttr.in/?format=j1') || return 1
  printf '%s' "$j" | jq -e '.nearest_area[0] | {name: (.areaName[0].value + ", " + .country[0].value), latitude: (.latitude|tonumber), longitude: (.longitude|tonumber)}' > "$AUTO.tmp" 2>/dev/null || return 1
  mv "$AUTO.tmp" "$AUTO"
  jq -r '[.name, .latitude, .longitude] | @tsv' "$AUTO"
}

wmo() {  # wmo CODE IS_DAY -> "icon<TAB>description"
  local c=$1 day=${2:-1} i d
  case $c in
    0)        d="Clear";          i=$([ "$day" = 1 ] && printf '󰖙' || printf '󰖔') ;;
    1|2)      d="Partly cloudy";  i=$([ "$day" = 1 ] && printf '󰖕' || printf '󰼱') ;;
    3)        d="Overcast";       i='󰖐' ;;
    45|48)    d="Fog";            i='󰖑' ;;
    51|53|55|56|57) d="Drizzle";  i='󰖗' ;;
    61|63|65|66|67) d="Rain";     i='󰖖' ;;
    71|73|75|77)    d="Snow";     i='󰖘' ;;
    80|81|82) d="Showers";        i='󰖖' ;;
    85|86)    d="Snow showers";   i='󰖘' ;;
    95|96|99) d="Thunderstorm";   i='󰖓' ;;
    *)        d="Unknown";        i='󰖐' ;;
  esac
  printf '%s\t%s\n' "$i" "$d"
}

fetch() {  # writes $CACHE and prints it; returns 1 on failure
  local name la lo u url j tunit wunit
  IFS=$'\t' read -r name la lo < <(location) || return 1
  [ -n "${la:-}" ] || return 1
  u=$(unit); tunit="°C"; wunit="km/h"
  url="https://api.open-meteo.com/v1/forecast?latitude=$la&longitude=$lo&daily=weather_code,temperature_2m_max,temperature_2m_min&current=temperature_2m,apparent_temperature,relative_humidity_2m,wind_speed_10m,weather_code,is_day&forecast_days=4&timezone=auto"
  if [ "$u" = imperial ]; then url="$url&temperature_unit=fahrenheit&wind_speed_unit=mph"; tunit="°F"; wunit="mph"; fi
  j=$("${CURL[@]}" "$url") || return 1
  mkdir -p "$(dirname "$CACHE")"; printf '%s' "$j" > "$CACHE.raw"   # for --rows

  local temp feels hum wind code isday icon desc
  IFS=$'\t' read -r temp feels hum wind code isday < <(printf '%s' "$j" | jq -r '.current | [(.temperature_2m|round), (.apparent_temperature|round), .relative_humidity_2m, (.wind_speed_10m|round), .weather_code, .is_day] | @tsv') || return 1
  [ -n "${code:-}" ] || return 1
  IFS=$'\t' read -r icon desc < <(wmo "$code" "$isday")

  local tooltip forecast="" d dcode dmax dmin dicon ddesc
  tooltip=$(printf '󰍎 %s\n%s %s  %s°  (feels %s°)\n󰖝 %s %s   󰖎 %s%%' "$name" "$icon" "$desc" "$temp" "$feels" "$wind" "$wunit" "$hum")
  while IFS=$'\t' read -r d dcode dmax dmin; do
    IFS=$'\t' read -r dicon ddesc < <(wmo "$dcode" 1)
    forecast+=$(printf '\n%s  %s %-13s %3s° / %s°' "$(date -d "$d" +%a)" "$dicon" "$ddesc" "$dmin" "$dmax")
  done < <(printf '%s' "$j" | jq -r '.daily | [.time, .weather_code, (.temperature_2m_max|map(round)), (.temperature_2m_min|map(round))] | transpose[] | @tsv')
  tooltip+=$'\n'"${forecast#$'\n'}"

  mkdir -p "$(dirname "$CACHE")"
  jq -n --arg text "$icon ${temp}°" --arg tooltip "$tooltip" --arg alt "$desc" --arg tunit "$tunit" \
    '{text: $text, tooltip: $tooltip, alt: $alt, class: "ok", unit: $tunit, fetched: now}' > "$CACHE.tmp" && mv "$CACHE.tmp" "$CACHE"
  cat "$CACHE"
}

K4CACHE="$HOME/.cache/sway-weather-k4.json"
k4_dashboard() {  # k4_dashboard [refresh]: the design's Weather tab as k4 records
  local name la lo u url j
  if [ "${1:-}" != refresh ] && [ -s "$K4CACHE" ] && [ "$(( $(date +%s) - $(stat -c %Y "$K4CACHE") ))" -lt 600 ]; then j=$(cat "$K4CACHE")
  else
    IFS=$'\t' read -r name la lo < <(location) || return 1
    [ -n "${la:-}" ] || return 1
    u=$(unit)
    url="https://api.open-meteo.com/v1/forecast?latitude=$la&longitude=$lo&timezone=auto&forecast_days=7"
    url+="&current=temperature_2m,apparent_temperature,relative_humidity_2m,wind_speed_10m,wind_direction_10m,weather_code,is_day,uv_index"
    url+="&hourly=temperature_2m,weather_code,precipitation_probability,is_day&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,sunrise,sunset"
    if [ "$u" = imperial ]; then url+="&temperature_unit=fahrenheit&wind_speed_unit=mph"; else url+="&wind_speed_unit=ms"; fi
    j=$("${CURL[@]}" "$url") || { [ -s "$K4CACHE" ] && j=$(cat "$K4CACHE"); } || return 1
    j=$(printf '%s' "$j" | jq -c --arg name "$name" --arg auto "$([ -n "$(jqs '.latitude // empty' "$STATE")" ] && echo fixed || echo automatic)" --arg unit "$u" \
      '. + {k4_name: $name, k4_loc: $auto, k4_unit: $unit, k4_fetched: now}')
    mkdir -p "$(dirname "$K4CACHE")"; printf '%s' "$j" > "$K4CACHE"
  fi
  [ -s "$K4CACHE" ] || printf '%s' "$j" > "$K4CACHE"
  python3 - "$K4CACHE" <<'PY'
import json, sys, datetime as dt
j = json.load(open(sys.argv[1]))
cur, hr, dy = j["current"], j["hourly"], j["daily"]
def kind(code, day=1):   # WMO code -> the icon kind k4 draws
    if code == 0: return "sun" if day else "moon"
    if code in (1, 2): return "part" if day else "partnight"
    if code == 3: return "cloud"
    if code in (45, 48): return "fog"
    if code in (51, 53, 55, 56, 57, 61, 63, 65, 66, 67, 80, 81, 82): return "rain"
    if code in (71, 73, 75, 77, 85, 86): return "snow"
    if code in (95, 96, 99): return "storm"
    return "cloud"
COND = {0: "Clear", 1: "Mostly clear", 2: "Partly cloudy", 3: "Overcast", 45: "Fog", 48: "Fog", 51: "Light drizzle", 53: "Drizzle", 55: "Drizzle",
        61: "Light rain", 63: "Rain", 65: "Heavy rain", 66: "Freezing rain", 67: "Freezing rain", 71: "Light snow", 73: "Snow", 75: "Heavy snow",
        77: "Snow grains", 80: "Showers", 81: "Showers", 82: "Heavy showers", 85: "Snow showers", 86: "Snow showers", 95: "Thunderstorm", 96: "Thunderstorm", 99: "Thunderstorm"}
r = round
def t(v): return f"{r(v)}°"
def out(*f): print("\t".join(str(x) for x in f))
imperial = j.get("k4_unit") == "imperial"
dirs = ["N", "NE", "E", "SE", "S", "SW", "W", "NW"]
wind = f"{r(cur["wind_speed_10m"])} {"mph" if imperial else "m/s"} {dirs[int((cur["wind_direction_10m"] + 22.5) % 360 // 45)]}"
uv = cur.get("uv_index") or 0
uvl = "low" if uv < 3 else "moderate" if uv < 6 else "high" if uv < 8 else "very high"
hm = lambda s: s[11:16]
out("WN", j.get("k4_name", ""), (j.get("k4_loc") or "automatic") + " location", kind(cur["weather_code"], cur["is_day"]), t(cur["temperature_2m"]),
    COND.get(cur["weather_code"], "Unknown"), f"Feels {t(cur["apparent_temperature"])} · H {t(dy["temperature_2m_max"][0])} L {t(dy["temperature_2m_min"][0])}")
for k, v in (("Wind", wind), ("Humidity", f"{cur["relative_humidity_2m"]}%"), ("Rain", f"{dy["precipitation_probability_max"][0] or 0}%"),
             ("UV", f"{r(uv)} {uvl}"), ("Sunrise", hm(dy["sunrise"][0])), ("Sunset", hm(dy["sunset"][0]))):
    out("WD", k, v)
now = cur["time"][:13]
times = hr["time"]
start = next((i for i, x in enumerate(times) if x[:13] >= now), 0)
for d in range(7):
    if d == 0: idx = [start + 2 * k for k in range(8)]
    else:
        day = dy["time"][d]
        base = next((i for i, x in enumerate(times) if x.startswith(day + "T06")), None)
        if base is None: continue
        idx = [base + 2 * k for k in range(8)]
    for i in idx:
        if i >= len(times): break
        out("WH", d, times[i][11:13], kind(hr["weather_code"][i], hr["is_day"][i]), t(hr["temperature_2m"][i]), hr["precipitation_probability"][i] or 0)
for d in range(len(dy["time"])):
    name = "Today" if d == 0 else dt.date.fromisoformat(dy["time"][d]).strftime("%a %-d")
    lo, hi = dy["temperature_2m_min"][d], dy["temperature_2m_max"][d]
    out("WY", name, kind(dy["weather_code"][d]), dy["precipitation_probability_max"][d] or 0, t(lo), t(hi), r(lo), r(hi))
out("WU", dt.datetime.fromtimestamp(j.get("k4_fetched", 0)).strftime("%H:%M"))
PY
}

output() {  # the waybar JSON line; stale cache rather than an empty module
  local out
  if out=$(fetch); then printf '%s\n' "$out" | jq -c '{text, tooltip, alt, class}'
  elif [ -f "$CACHE" ]; then jq -c '{text, tooltip: (.tooltip + "\n(offline, last update " + (.fetched | strflocaltime("%H:%M")) + ")"), alt, class: "stale"}' "$CACHE"
  else printf '{"text":"󰼯","tooltip":"Weather unavailable","class":"error"}\n'; fi
}

search() {
  "${CURL[@]}" "https://geocoding-api.open-meteo.com/v1/search?name=$(printf '%s' "$1" | jq -sRr @uri)&count=5&language=en&format=json" \
    | jq -r '.results[]? | [.name, .admin1, .country] | map(select(. != null and . != "")) | join(", ")' 2>/dev/null | paste -d'\0' - <("${CURL[@]}" "https://geocoding-api.open-meteo.com/v1/search?name=$(printf '%s' "$1" | jq -sRr @uri)&count=5&language=en&format=json" | jq -r '.results[]? | " · \(.latitude), \(.longitude)"')
}

report() {  # report now|day|week
  local name la lo u url j tunit
  IFS=$'\t' read -r name la lo < <(location) || { echo "Location unknown"; return 1; }
  u=$(unit); tunit="°"
  url="https://api.open-meteo.com/v1/forecast?latitude=$la&longitude=$lo&timezone=auto"
  [ "$u" = imperial ] && url="$url&temperature_unit=fahrenheit&wind_speed_unit=mph"
  case "$1" in
    now)
      [ -f "$CACHE" ] || fetch >/dev/null
      jq -r '.tooltip' "$CACHE" 2>/dev/null | head -3 ;;
    day)
      j=$("${CURL[@]}" "$url&hourly=temperature_2m,weather_code,precipitation_probability&forecast_hours=24") || { echo "Weather unavailable"; return 1; }
      printf '󰍎 %s, next 24 hours\n' "$name"
      while IFS=$'\t' read -r t temp code rain; do
        IFS=$'\t' read -r icon desc < <(wmo "$code" 1)
        printf '%s  %s %-13s %4s%s  %s%%\n' "$(date -d "$t" +%H:%M)" "$icon" "$desc" "$temp" "$tunit" "$rain"
      done < <(printf '%s' "$j" | jq -r '.hourly | [.time, (.temperature_2m|map(round)), .weather_code, .precipitation_probability] | transpose[] | @tsv' | awk 'NR % 3 == 1') ;;
    week)
      j=$("${CURL[@]}" "$url&daily=weather_code,temperature_2m_max,temperature_2m_min&forecast_days=7") || { echo "Weather unavailable"; return 1; }
      printf '󰍎 %s, 7 days\n' "$name"
      while IFS=$'\t' read -r d code hi lo; do
        IFS=$'\t' read -r icon desc < <(wmo "$code" 1)
        printf '%s  %s %-13s %3s%s / %s%s\n' "$(date -d "$d" +%a)" "$icon" "$desc" "$lo" "$tunit" "$hi" "$tunit"
      done < <(printf '%s' "$j" | jq -r '.daily | [.time, .weather_code, (.temperature_2m_max|map(round)), (.temperature_2m_min|map(round))] | transpose[] | @tsv') ;;
  esac
}

case "${1:-}" in
  "")               output ;;
  --report)         report "${2:-now}" ;;
  --rows)           [ -f "$CACHE.raw" ] || fetch >/dev/null
                    jq -r '(.current | ["now", (.temperature_2m|round|tostring) + "°", .weather_code, .is_day]),
                           (.daily | ["today", ((.temperature_2m_min[0]|round|tostring) + "° / " + (.temperature_2m_max[0]|round|tostring) + "°"), .weather_code[0], 1],
                                     ["tomorrow", ((.temperature_2m_min[1]|round|tostring) + "° / " + (.temperature_2m_max[1]|round|tostring) + "°"), .weather_code[1], 1]) | @tsv' "$CACHE.raw" 2>/dev/null \
                    | while IFS=$'\t' read -r k temp code day; do IFS=$'\t' read -r icon desc < <(wmo "$code" "$day"); printf '%s\t%s %s  %s\n' "$k" "$icon" "$temp" "$desc"; done ;;
  --k4)             k4_dashboard "${2:-}" ;;
  --location)       n=$(jqs '.latitude // empty' "$STATE"); if [ -n "$n" ]; then jqs '.name' "$STATE"; else echo Automatic; fi ;;
  --tooltip)        { [ -f "$CACHE" ] || fetch >/dev/null; jq -r '.tooltip' "$CACHE" 2>/dev/null; } ;;
  --unit)           unit ;;
  --toggle-units)   if [ "$(unit)" = metric ]; then state_set '.unit = "imperial"'; else state_set '.unit = "metric"'; fi; rm -f "$CACHE"; refresh ;;
  --search)         search "${2:?query}" ;;
  --set-location)   sel="${2:?line}"; name="${sel%% · *}"; coords="${sel##* · }"; la="${coords%%,*}"; lo="${coords##*, }"
                    [[ $la =~ ^-?[0-9.]+$ && $lo =~ ^-?[0-9.]+$ ]] || { echo "sway-weather: cannot parse '$sel'" >&2; exit 1; }
                    state_set --arg n "$name" --argjson la "$la" --argjson lo "$lo" '.name = $n | .latitude = $la | .longitude = $lo' 2>/dev/null \
                      || state_set ".name = \"$name\" | .latitude = $la | .longitude = $lo"
                    rm -f "$CACHE"; refresh ;;
  --clear-location) state_set 'del(.name, .latitude, .longitude)'; rm -f "$CACHE" "$AUTO"; refresh ;;
  --refresh)        refresh ;;
  *) sed -n '2,13p' "$0" >&2; exit 2 ;;
esac

#!/usr/bin/env bash
# sway-menu: Omarchy-style system menu on fuzzel (dmenu mode) for the Ubuntu/Sway profile.
#   sway-menu        open the menu (bound to Super+Alt+Space)
#   sway-menu lock   lock the screen (used by the sway config and swayidle)
#   sway-menu idle   start swayidle (used by the sway config)
# The top level lists the sections, every action of every section ("Section › Action"),
# and every installed app, so typing searches all of it. Picking a section opens its submenu.
set -u

DOTFILES="${DOTFILES_DIR:-$HOME/repos/dotfiles}"
SWAY_CONFIG="$HOME/.config/sway/config"
STATE="$HOME/.local/state/sway"          # included by the sway config: *.conf
SHOTS="$HOME/Pictures/Screenshots"
RECS="$HOME/Videos/Recordings"
DEFAULT_WALLPAPER="$DOTFILES/wallpapers/neon-city.png"

# ---------- tiny menu framework: parallel arrays of labels and actions ----------
L=(); A=()
reset() { L=(); A=(); }
add() { L+=("$1"); A+=("$2"); }                  # add "icon  Label" 'action'
show() {                                          # show PROMPT: run the chosen entry's action
  local prompt="$1" n=${#L[@]} i
  [ "$n" -gt 0 ] || return 0
  i=$(printf '%s\n' "${L[@]}" | fuzzel --dmenu --index --prompt "$prompt ❯ " \
        --lines "$(( n < 25 ? n : 25 ))" --width 60)
  [[ "${i:-}" =~ ^[0-9]+$ ]] && [ "$i" -lt "$n" ] || return 0
  eval "${A[$i]}"
}
pick() {                                          # pick PROMPT ENTRY... -> prints chosen label (icon stripped)
  local prompt="$1"; shift
  printf '%s\n' "$@" | fuzzel --dmenu --prompt "$prompt ❯ " --lines "$#" --width 40 \
    | sed -E 's/^[^[:alnum:]]*[[:space:]]+//'
}
confirm() { [ "$(pick "$1" "󰄬  Yes" "󰅖  No")" = Yes ]; }
notify() { command -v notify-send >/dev/null && notify-send "$@"; }
tui() { xdg-terminal-exec --app-id=TUI.float -e "$@"; }
tui_wait() { tui sh -c "$1; printf '\n[done] press enter to close'; read -r _"; }
bg() { "$@" >/dev/null 2>&1 & disown; }

# ---------- lock / idle / wallpaper ----------
wallpaper() {
  local f; f=$(sed -n 's/^output \* bg "\(.*\)" fill$/\1/p' "$STATE/background.conf" 2>/dev/null)
  [ -f "${f:-}" ] && printf '%s' "$f" || printf '%s' "$DEFAULT_WALLPAPER"
}
lock() { swaylock -f -i "$(wallpaper)" -s fill; }
idle() {
  exec swayidle -w \
    timeout 300 "$0 lock" \
    timeout 330 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
    before-sleep "$0 lock"
}

# ---------- Capture ----------
shot() { mkdir -p "$SHOTS"; local f="$SHOTS/$(date +%Y-%m-%d_%H-%M-%S).png"
  grim "$@" "$f" && wl-copy < "$f" && notify "Screenshot" "Saved and copied: ${f##*/}"; }
shot_region() { local g; g=$(slurp) || return; shot -g "$g"; }
shot_window() { local g; g=$(swaymsg -t get_tree | jq -r '.. | select(.pid? and .visible?) | .rect | "\(.x),\(.y) \(.width)x\(.height)"' | slurp) || return; shot -g "$g"; }
record_toggle() {
  if pgrep -x wf-recorder >/dev/null; then
    pkill -INT -x wf-recorder; notify "Screen recording" "Stopped. Saved in ${RECS/#$HOME/~}"
  else
    mkdir -p "$RECS"; local f="$RECS/$(date +%Y-%m-%d_%H-%M-%S).mp4" g=""
    if [ "${1:-}" = region ]; then g=$(slurp) || return; fi
    if [ -n "$g" ]; then bg wf-recorder -g "$g" -f "$f"; else bg wf-recorder -f "$f"; fi
    notify "Screen recording" "Started. Pick Record again to stop."
  fi
}
color_picker() { local p hex; p=$(slurp -p) || return
  hex=$(grim -g "$p" -t ppm - | tail -c 3 | od -An -tx1 | tr -d ' \n')
  printf '#%s' "$hex" | wl-copy; notify "Color picked" "#$hex copied"; }
leaves_capture() { local p="${1:-}" rec="Start"; pgrep -x wf-recorder >/dev/null && rec="Stop"
  add "󰹑  ${p}Screenshot region" shot_region
  add "󱣴  ${p}Screenshot window" shot_window
  add "󰍹  ${p}Screenshot screen" shot
  add "󰻃  ${p}Record region ($rec)" 'record_toggle region'
  add "󰻂  ${p}Record screen ($rec)" record_toggle
  add "󰈋  ${p}Color picker" color_picker; }

# ---------- Toggle ----------
toggle_night() { if pgrep -x wlsunset >/dev/null; then pkill -x wlsunset; else bg wlsunset -t 4000; fi; }
toggle_idle()  { if pgrep -x swayidle >/dev/null; then pkill -x swayidle; notify "Idle lock" "Off"; else bg "$0" idle; notify "Idle lock" "On"; fi; }
toggle_bar()   { if pgrep -x waybar >/dev/null; then pkill -x waybar; else bg waybar; fi; }
toggle_dnd()   { if makoctl mode | grep -qx do-not-disturb; then makoctl mode -r do-not-disturb; else makoctl mode -a do-not-disturb; fi >/dev/null; }
onoff() { "$@" >/dev/null 2>&1 && echo on || echo off; }
leaves_toggle() { local p="${1:-}"
  add "󰖔  ${p}Night light ($(onoff pgrep -x wlsunset))" toggle_night
  add "󰌾  ${p}Idle lock ($(onoff pgrep -x swayidle))" toggle_idle
  add "󰍜  ${p}Bar ($(onoff pgrep -x waybar))" toggle_bar
  add "󰂛  ${p}Do not disturb ($(onoff sh -c 'makoctl mode | grep -qx do-not-disturb'))" toggle_dnd; }

# ---------- Style ----------
set_background() { local f="$1"; mkdir -p "$STATE"
  printf 'output * bg "%s" fill\n' "$f" > "$STATE/background.conf"
  swaymsg output '*' bg "$f" fill >/dev/null; }
leaves_style() { local p="${1:-}" f
  for f in "$DOTFILES"/wallpapers/*; do [ -f "$f" ] && add "󰋩  ${p}Background: ${f##*/}" "set_background $(printf %q "$f")"; done; }

# ---------- Setup ----------
set_layout() { swaymsg input type:keyboard xkb_layout "$1" >/dev/null && notify "Keyboard" "Layout: $1"; }
set_power() { powerprofilesctl set "$1" && notify "Power profile" "$1"; }
leaves_setup() { local p="${1:-}" cur; cur=$(powerprofilesctl get 2>/dev/null || echo "?")
  add "󰕾  ${p}Audio" 'bg pavucontrol'
  add "󰤨  ${p}Wifi" 'tui nmtui'
  add "󰂯  ${p}Bluetooth" 'bg blueman-manager'
  add "󰓅  ${p}Power profile: performance (now: $cur)" 'set_power performance'
  add "󰾅  ${p}Power profile: balanced (now: $cur)" 'set_power balanced'
  add "󰾆  ${p}Power profile: power-saver (now: $cur)" 'set_power power-saver'
  add "󰍹  ${p}Monitors" 'bg wdisplays'
  add "󰌌  ${p}Keyboard layout: us" 'set_layout us'
  add "󰌌  ${p}Keyboard layout: se" 'set_layout se'
  add "󰒓  ${p}Edit sway config" "tui nvim $(printf %q "$SWAY_CONFIG")"; }

# ---------- Install / Update / Learn / About / System ----------
leaves_install() { local p="${1:-}"
  add "󰏖  ${p}Install package" "tui_wait 'printf \"Package(s) to install: \"; read -r p; [ -n \"\$p\" ] && sudo apt install \$p'"
  add "󰆴  ${p}Remove package"  "tui_wait 'printf \"Package(s) to remove: \"; read -r p; [ -n \"\$p\" ] && sudo apt remove \$p'"; }
leaves_update() { local p="${1:-}"
  add "󰚰  ${p}Update system (apt)" "tui_wait 'sudo apt update && sudo apt full-upgrade'"
  add "󰊢  ${p}Update dotfiles (git pull + init.sh)" "tui_wait \"cd $(printf %q "$DOTFILES") && git pull --ff-only && bash init.sh\""; }
show_keybindings() {
  grep -E '^\s*bindsym' "$SWAY_CONFIG" \
    | sed -E 's/^\s*bindsym\s+(--[a-z-]+\s+)*//; s/\$mod/Super/g; s/Mod1/Alt/g; s/\s+exec\s+/  →  /; s/^([^ ]+)\s+/\1  →  /' \
    | fuzzel --dmenu --prompt "Keybindings ❯ " --lines 25 --width 80 >/dev/null; }
leaves_learn() { local p="${1:-}"
  add "󰌌  ${p}Keybindings" show_keybindings
  add "󰖟  ${p}Sway wiki" 'bg xdg-open https://github.com/swaywm/sway/wiki'
  add "󰊢  ${p}Dotfiles repo" 'bg xdg-open https://github.com/kr4nkenwagen/dotfiles'; }
about() { tui_wait 'command -v fastfetch >/dev/null && fastfetch || { uname -a; lsb_release -a; sway --version; }'; }
leaves_system() { local p="${1:-}"
  add "󰌾  ${p}Lock" lock
  add "󰤄  ${p}Suspend" 'systemctl suspend'
  add "󰑓  ${p}Reload sway" 'swaymsg reload >/dev/null'
  add "󰍃  ${p}Logout" 'confirm "Log out?" && swaymsg exit'
  add "󰜉  ${p}Reboot" 'confirm "Reboot?" && systemctl reboot'
  add "󰐥  ${p}Shutdown" 'confirm "Shut down?" && systemctl poweroff'; }

# ---------- Apps from .desktop files ----------
apps_add() {
  local name id
  while IFS=$'\t' read -r name id; do
    add "󰀻  App: $name" "bg gtk-launch $(printf %q "$id")"
  done < <(apps_list)
}
apps_list() {
  local dirs=("$HOME/.local/share/applications" /usr/local/share/applications /usr/share/applications /var/lib/flatpak/exports/share/applications /var/lib/snapd/desktop/applications)
  local d files=()
  for d in "${dirs[@]}"; do [ -d "$d" ] && files+=("$d"/*.desktop); done
  [ ${#files[@]} -gt 0 ] || return 0
  awk '
    FNR == 1 { flush(); sec = ""; name = ""; skip = 0; n = split(FILENAME, parts, "/"); id = parts[n]; sub(/\.desktop$/, "", id) }
    /^\[/ { sec = $0; next }
    sec != "[Desktop Entry]" { next }
    /^Name=/ && name == "" { name = substr($0, 6) }
    /^NoDisplay=true/ || /^Hidden=true/ { skip = 1 }
    /^Type=/ && $0 != "Type=Application" { skip = 1 }
    /^OnlyShowIn=/ { skip = 1 }
    END { flush() }
    function flush() { if (name != "" && !skip && !(id in seen)) { seen[id] = 1; printf "%s\t%s\n", name, id } }
  ' "${files[@]}" 2>/dev/null | sort -f -t $'\t' -k1,1
}

# ---------- menus ----------
sections=(learn capture toggle style setup install update system)
section_icon() { case "$1" in learn) echo 󰧑;; capture) echo 󰄀;; toggle) echo 󰔎;; style) echo 󰸌;; setup) echo 󰒓;; install) echo 󰏖;; update) echo 󰚰;; system) echo 󰐥;; esac; }
section_title() { printf '%s' "${1^}"; }
submenu() {                                       # submenu SECTION
  reset; "leaves_$1" ""; add "󰁍  Back" main_menu; show "$(section_title "$1")"
}
main_menu() {
  reset
  local s
  add "󰀻  Apps" 'bg fuzzel'
  for s in "${sections[@]}"; do add "$(section_icon "$s")  $(section_title "$s")" "submenu $s"; done
  add "󰋽  About" about
  for s in "${sections[@]}"; do "leaves_$s" "$(section_title "$s") › "; done
  apps_add
  show Menu
}

case "${1:-}" in
  lock) lock ;;
  idle) idle ;;
  "") main_menu ;;
  *) echo "usage: sway-menu [lock|idle]" >&2; exit 2 ;;
esac

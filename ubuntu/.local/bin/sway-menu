#!/usr/bin/env bash
# sway-menu: Omarchy-style system menu on fuzzel (dmenu mode) for the Ubuntu/Sway profile.
#   sway-menu        open the menu (bound to Super+Alt+Space)
#   sway-menu lock   lock the screen (used by the sway config and swayidle)
#   sway-menu idle   start swayidle (used by the sway config)
#   sway-menu pkg-install | pkg-remove   fzf over apt packages (run in the floating terminal)
#   sway-menu wallpaper | wallpaper-next | wallpaper-random   fuzzel wallpaper picker (thumbnails)
#   sway-menu wallpaper-restore           repaint the saved wallpaper (sway config runs it at start)
#   sway-menu thumbs-warm                 build thumbnails for the current theme's wallpapers
#   sway-menu wifi                        nmcli Wi-Fi picker (fuzzel)
#   sway-menu vpn-connect NAME | vpn-pick FortiClient VPN (run in the floating terminal)
#   sway-menu theme NAME | theme-next | theme-pick   switch the Omarchy-format theme (sway-theme-set)
#   sway-menu background FILE             set the wallpaper (also used by sway-theme-set)
#   sway-menu display|network|audio|bluetooth|weather   the waybar module menus (omarchy-shell panels)
#   sway-menu timezone                     pick a timezone (clock middle click)
# SWAY_MENU_DRY_RUN=1 prints a menu's entries instead of showing it.
# The top level lists the sections, every action of every section ("Section › Action"),
# and every installed app, so typing searches all of it. Picking a section opens its submenu.
set -u

SELF=$(readlink -f "$0")
DOTFILES="${DOTFILES_DIR:-$HOME/repos/dotfiles}"
SWAY_CONFIG="$HOME/.config/sway/config"
STATE="$HOME/.local/state/sway"          # included by the sway config: *.conf
SHOTS="$HOME/Pictures/Screenshots"
RECS="$HOME/Videos/Recordings"
THEME="$HOME/.local/state/omarchy/current/theme"   # rendered by sway-theme-set
BG_LINK="$HOME/.local/state/omarchy/current/background"   # current wallpaper, same symlink Omarchy keeps
DEFAULT_WALLPAPER="$DOTFILES/wallpapers/neon-city.png"
WALLPAPER_DIRS=("$THEME/backgrounds" "$HOME/.config/omarchy/backgrounds/$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null)" "$DOTFILES/wallpapers")  # theme + extras from theme-bg-sync
THUMBS="$HOME/.cache/sway-menu/thumbs"
PICK_LOG="$HOME/.cache/sway-menu/pick.log"   # every pick and paint step, for diagnosing the picker
plog() { mkdir -p "${PICK_LOG%/*}"; printf '%s %s\n' "$(date +%H:%M:%S)" "$*" >> "$PICK_LOG"; }

# ---------- tiny menu framework: parallel arrays of labels and actions ----------
fz() { fuzzel --config "$THEME/fuzzel.ini" "$@"; }
fz_img() { fuzzel --config "$THEME/fuzzel-images.ini" "$@"; }   # tall rows with thumbnail icons
L=(); A=()
reset() { L=(); A=(); }
add() { L+=("$1"); A+=("$2"); }                  # add "icon  Label" 'action'
show() {                                          # show PROMPT [ROWS]: run the chosen entry's action
  local prompt="$1" n=${#L[@]} rows="${2:-25}" i
  [ "$n" -gt 0 ] || return 0
  if [ -n "${SWAY_MENU_DRY_RUN:-}" ]; then for i in "${!L[@]}"; do printf '%s\t%s\n' "${L[$i]}" "${A[$i]}"; done; return 0; fi
  i=$(printf '%s\n' "${L[@]}" | fz --dmenu --index --prompt "$prompt ❯ " \
        --lines "$(( n < rows ? n : rows ))" --width 60)
  [[ "${i:-}" =~ ^[0-9]+$ ]] && [ "$i" -lt "$n" ] || return 0
  eval "${A[$i]}"
}
pick() {                                          # pick PROMPT ENTRY... -> prints chosen label (icon stripped)
  local prompt="$1"; shift
  printf '%s\n' "$@" | fz --dmenu --prompt "$prompt ❯ " --lines "$#" --width 40 \
    | sed -E 's/^[^[:alnum:]]*[[:space:]]+//'
}
confirm() { [ "$(pick "$1" "󰄬  Yes" "󰅖  No")" = Yes ]; }
notify() { command -v notify-send >/dev/null && notify-send "$@"; }
tui() {  # floating terminal (matches the TUI.float window rule in the sway config)
  if command -v ghostty >/dev/null; then ghostty --class=TUI.float -e "$@" >/dev/null 2>&1 & disown
  else xdg-terminal-exec "$@" >/dev/null 2>&1 & disown; fi
}
tui_wait() { tui sh -c "$1; printf '\n[done] press enter to close'; read -r _"; }
bg() { "$@" >/dev/null 2>&1 & disown; }

# ---------- lock / idle / wallpaper ----------
wallpaper() {  # current wallpaper: the Omarchy-style symlink, else the default
  local f; f=$(readlink -f "$BG_LINK" 2>/dev/null)
  [ -f "${f:-}" ] && printf '%s' "$f" || printf '%s' "$DEFAULT_WALLPAPER"
}
lock() { swaylock -f -C "$THEME/swaylock.conf" -i "$(wallpaper)" -s fill; }
# awww (ex-swww) paints with a transition when installed; otherwise sway's own swaybg.
bg_tool() { command -v awww || command -v swww || true; }
apply_bg() {  # apply_bg FILE
  local t; t=$(bg_tool); plog "apply_bg: $1 tool=${t:-swaybg}"
  if [ -n "$t" ]; then
    if ! "$t" query >/dev/null 2>&1; then
      "${t}-daemon" >/dev/null 2>&1 & disown
      local i; for i in $(seq 30); do "$t" query >/dev/null 2>&1 && break; sleep 0.1; done
    fi
    # with a transition first, then plain (older/newer CLIs differ in flags); stderr goes to the pick log
    if "$t" img "$1" --transition-type grow --transition-pos center --transition-duration 1 --transition-fps 60 2>>"$PICK_LOG" \
       || { plog "apply_bg: $t img with transition failed, retrying plain"; "$t" img "$1" 2>>"$PICK_LOG"; }; then
      # a swaybg left from an older config or from the fallback below would sit on top of
      # awww's surface and hide every later change; sway does not respawn it
      pkill -x swaybg 2>/dev/null || true
    else
      # awww cannot paint: stop its daemon so the swaybg fallback is actually visible
      plog "apply_bg: $t img failed, stopping the daemon and using swaybg"
      "$t" kill >/dev/null 2>&1 || pkill -x "${t}-daemon" 2>/dev/null
      swaymsg output '*' bg "$1" fill >/dev/null || plog "apply_bg: swaymsg failed"
    fi
  else
    swaymsg output '*' bg "$1" fill >/dev/null || plog "apply_bg: swaymsg failed"
  fi
}
set_background() { local f; f=$(readlink -f "$1"); [ -f "$f" ] || { plog "set_background: not a file: $1"; return; }
  mkdir -p "$(dirname "$BG_LINK")"; ln -nsf "$f" "$BG_LINK"; apply_bg "$f"; }
wallpaper_restore() { rm -f "$STATE/background.conf"; apply_bg "$(wallpaper)"; }   # background.conf: older versions persisted the choice there
idle() {
  exec swayidle -w \
    timeout 300 "$0 lock" \
    timeout 330 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
    before-sleep "$0 lock"
}

# ---------- Capture ----------
shot() { mkdir -p "$SHOTS"; local f="$SHOTS/$(date +%Y-%m-%d_%H-%M-%S).png"
  grim "$@" "$f" && wl-copy < "$f" && notify "Screenshot" "Saved and copied: ${f##*/}"; }
shot_region() { local g; g=$(slurp) || return; shot -g "$g"; }
shot_window() { local g; g=$(swaymsg -t get_tree | jq -r '.. | select(.pid? and .visible?) | .rect | "\(.x),\(.y) \(.width)x\(.height)"' | slurp) || return; shot -g "$g"; }
REC_PID="$STATE/recording.pid"
recording() { [ -f "$REC_PID" ] && kill -0 "$(<"$REC_PID")" 2>/dev/null; }   # pidfile: pgrep costs ~40 ms per menu open
record_toggle() {
  if recording; then
    kill -INT "$(<"$REC_PID")" 2>/dev/null; rm -f "$REC_PID"; notify "Screen recording" "Stopped. Saved in ${RECS/#$HOME/~}"
  else
    mkdir -p "$RECS" "$STATE"; local f="$RECS/$(date +%Y-%m-%d_%H-%M-%S).mp4" g=""
    if [ "${1:-}" = region ]; then g=$(slurp) || return; fi
    if [ -n "$g" ]; then wf-recorder -g "$g" -f "$f" >/dev/null 2>&1 & else wf-recorder -f "$f" >/dev/null 2>&1 & fi
    echo $! > "$REC_PID"; disown
    notify "Screen recording" "Started. Pick Record again to stop."
  fi
}
color_picker() { local p hex; p=$(slurp -p) || return
  hex=$(grim -g "$p" -t ppm - | tail -c 3 | od -An -tx1 | tr -d ' \n')
  printf '#%s' "$hex" | wl-copy; notify "Color picked" "#$hex copied"; }
leaves_capture() { local p="${1:-}" rec="Start"; recording && rec="Stop"
  add "󰹑  ${p}Screenshot region" shot_region
  add "󱣴  ${p}Screenshot window" shot_window
  add "󰍹  ${p}Screenshot screen" shot
  add "󰻃  ${p}Record region ($rec)" 'record_toggle region'
  add "󰻂  ${p}Record screen ($rec)" record_toggle
  add "󰈋  ${p}Color picker" color_picker; }

# ---------- Toggle ----------
toggle_night() { if pgrep -x wlsunset >/dev/null; then pkill -x wlsunset; else bg wlsunset -t 4000; fi; }
toggle_idle()  { if pgrep -x swayidle >/dev/null; then pkill -x swayidle; notify "Idle lock" "Off"; else bg "$0" idle; notify "Idle lock" "On"; fi; }
toggle_bar()   { if pgrep -x waybar >/dev/null; then pkill -x waybar; else bg waybar; fi; }
toggle_dnd()   { if makoctl mode | grep -qx do-not-disturb; then makoctl mode -r do-not-disturb; else makoctl mode -a do-not-disturb; fi >/dev/null; }
onoff() { "$@" >/dev/null 2>&1 && echo on || echo off; }
leaves_toggle() { local p="${1:-}"
  add "󰖔  ${p}Night light ($(onoff pgrep -x wlsunset))" toggle_night
  add "󰌾  ${p}Idle lock ($(onoff pgrep -x swayidle))" toggle_idle
  add "󰍜  ${p}Bar ($(onoff pgrep -x waybar))" toggle_bar
  add "󰂛  ${p}Do not disturb ($(onoff sh -c 'makoctl mode | grep -qx do-not-disturb'))" toggle_dnd; }

# ---------- Style ----------
bg_list() { find -L "${WALLPAPER_DIRS[@]}" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) 2>/dev/null | sort -u; }
bg_next() { local cur list; cur=$(wallpaper); mapfile -t list < <(bg_list); [ ${#list[@]} -gt 0 ] || return
  local i n=${#list[@]} next="${list[0]}"
  for i in "${!list[@]}"; do [ "$(readlink -f "${list[$i]}")" = "$cur" ] && next="${list[$(( (i + 1) % n ))]}"; done
  set_background "$next"; }
bg_random() { local f; f=$(bg_list | shuf -n1); [ -n "$f" ] && set_background "$f"; }
# Thumbnails (PNG, the only raster fuzzel loads) cached by path+size+mtime, like omarchy-menu-images.
thumb_path() { printf '%s/%s.png' "$THUMBS" "$(printf '%s:%s' "$1" "$(stat -c '%s:%Y' "$1" 2>/dev/null)" | md5sum | cut -c1-32)"; }
thumb_make() {  # thumb_make FILE OUT
  if command -v vipsthumbnail >/dev/null; then vipsthumbnail "$1" --size 480x270 --smartcrop centre -o "$2[strip]" 2>/dev/null
  elif command -v magick >/dev/null; then magick "$1" -thumbnail 480x270^ -gravity center -extent 480x270 "$2" 2>/dev/null
  elif command -v convert >/dev/null; then convert "$1" -thumbnail 480x270^ -gravity center -extent 480x270 "$2" 2>/dev/null
  elif command -v ffmpeg >/dev/null; then ffmpeg -loglevel error -y -i "$1" -vf 'scale=480:270:force_original_aspect_ratio=increase,crop=480:270' -frames:v 1 "$2" 2>/dev/null
  else return 1; fi
}
thumbs_warm() {  # thumbs_warm [FILE...]: missing thumbnails for the given (default: current) wallpapers, in parallel
  mkdir -p "$THUMBS"; local f t
  { if [ $# -gt 0 ]; then printf '%s\n' "$@"; else bg_list; fi; } | while IFS= read -r f; do
      t=$(thumb_path "$f"); [ -f "$t" ] || printf '%s\0%s\0' "$f" "$t"
    done | xargs -0 -r -n2 -P "$(nproc)" sh -c '"$0" thumb-make "$1" "$2"' "$SELF"
  # drop thumbnails older than 60 days that nothing listed (cache hygiene)
  find "$THUMBS" -type f -mtime +60 -delete 2>/dev/null
}
image_pick() {  # image_pick PROMPT CURRENT FILE... -> prints the chosen file
  # Rows are "label\0icon\x1fthumb"; fuzzel prints the chosen label, which is mapped back
  # to the file (labels are unique), so nothing depends on --index semantics.
  local prompt="$1" cur="$2"; shift 2; local f t label chosen n=$#
  [ "$n" -gt 0 ] || return 1
  thumbs_warm "$@"
  local -A count=()
  for f in "$@"; do count[${f##*/}]=$(( ${count[${f##*/}]:-0} + 1 )); done
  row_label() { local base=${1##*/} dir=${1%/*}; [ "${count[$base]}" -gt 1 ] && printf '%s/%s' "${dir##*/}" "$base" || printf '%s' "$base"; }
  chosen=$(for f in "$@"; do
      label=$(row_label "$f"); [ "$(readlink -f "$f")" = "$cur" ] && label="$label  (current)"
      t=$(thumb_path "$f")
      if [ -f "$t" ]; then printf '%s\0icon\x1f%s\n' "$label" "$t"; else printf '%s\n' "$label"; fi
    done | fz_img --dmenu --prompt "$prompt ❯ ")
  plog "pick: fuzzel returned '${chosen:-}'"
  [ -n "${chosen:-}" ] || return 1
  chosen=${chosen%  (current)}
  for f in "$@"; do [ "$(row_label "$f")" = "$chosen" ] && { printf '%s' "$f"; return 0; }; done
  plog "pick: no file matches '$chosen'"; return 1
}
wallpaper_picker() { local f; mapfile -t list < <(bg_list)
  if [ -n "${SWAY_MENU_DRY_RUN:-}" ]; then thumbs_warm "${list[@]}"; for f in "${list[@]}"; do printf '%s\t%s\n' "$f" "$(thumb_path "$f")"; done; return; fi
  f=$(image_pick Background "$(wallpaper)" "${list[@]}") || return 0; [ -n "$f" ] && set_background "$f"; }
# Themes: sway-theme-set lists "name<TAB>dir"; the picker shows each theme's preview.png.
theme_name() { local f="$HOME/.local/state/omarchy/current/theme.name"; [ -f "$f" ] && printf '%s' "$(<"$f")"; }
theme_list() {  # name<TAB>dir, like `sway-theme-set list` but without the fork; user themes shadow repo themes
  local -A seen=(); local d t n
  for d in "$HOME/.config/omarchy/themes" "$DOTFILES/themes"; do
    for t in "$d"/*/; do t=${t%/}; n=${t##*/}; [ -f "$t/colors.toml" ] && [ -z "${seen[$n]:-}" ] && { seen[$n]=1; printf '%s\t%s\n' "$n" "$t"; }; done
  done
}
theme_pretty() { local w out=""; for w in ${1//-/ }; do out+="${w^} "; done; printf '%s' "${out% }"; }   # no fork: the top level calls this per theme
theme_pick() { local names=() previews=() n d cur i t
  cur=$(theme_name)
  while IFS=$'\t' read -r n d; do names+=("$n"); previews+=("$d/preview.png"); done < <(theme_list)
  [ ${#names[@]} -gt 0 ] || return 0
  thumbs_warm "${previews[@]}"
  i=$(for i in "${!names[@]}"; do t=$(thumb_path "${previews[$i]}"); n="$(theme_pretty "${names[$i]}")$([ "${names[$i]}" = "$cur" ] && printf '  (current)')"
        if [ -f "$t" ]; then printf '%s\0icon\x1f%s\n' "$n" "$t"; else printf '%s\n' "$n"; fi
      done | fz_img --dmenu --index --prompt "Theme ❯ ") || return 0
  [[ "${i:-}" =~ ^[0-9]+$ ]] && sway-theme-set "${names[$i]}"
}
leaves_style() { local p="${1:-}" d n cur; cur=$(theme_name)
  add "󰸌  ${p}Theme picker (previews)" theme_pick
  add "󰸌  ${p}Theme: next" 'sway-theme-set next'
  while IFS=$'\t' read -r n d; do
    add "󰸌  ${p}Theme: $(theme_pretty "$n")$([ "$n" = "$cur" ] && printf '  (current)')" "sway-theme-set ${n@Q}"
  done < <(theme_list)
  add "󰸉  ${p}Background picker (thumbnails)" wallpaper_picker
  add "󰸉  ${p}Background: next" bg_next
  add "󰸉  ${p}Background: random" bg_random; }

# ---------- Setup ----------
set_layout() { swaymsg input type:keyboard xkb_layout "$1" >/dev/null && notify "Keyboard" "Layout: $1"; }
set_power() { powerprofilesctl set "$1" && notify "Power profile" "$1"; }
leaves_setup() { local p="${1:-}" cur; cur=$(powerprofilesctl get 2>/dev/null || echo "?")
  add "󰕾  ${p}Audio…" 'submenu audio'
  add "󰤨  ${p}Network…" 'submenu network'
  add "󰂯  ${p}Bluetooth…" 'submenu bluetooth'
  add "󰍹  ${p}Display…" 'submenu display'
  add "󰓅  ${p}Power profile: performance (now: $cur)" 'set_power performance'
  add "󰾅  ${p}Power profile: balanced (now: $cur)" 'set_power balanced'
  add "󰾆  ${p}Power profile: power-saver (now: $cur)" 'set_power power-saver'
  add "󰍹  ${p}Monitors" 'bg wdisplays'
  add "󰌌  ${p}Keyboard layout: us" 'set_layout us'
  add "󰌌  ${p}Keyboard layout: se" 'set_layout se'
  add "󰒓  ${p}Edit sway config" "tui nvim $(printf %q "$SWAY_CONFIG")"; }

# ---------- Wi-Fi (nmcli + fuzzel; impala-like picker without iwd) ----------
wifi_bars() { local n=${1:-0}; if [ "$n" -ge 75 ]; then printf '▂▄▆█'; elif [ "$n" -ge 50 ]; then printf '▂▄▆_'; elif [ "$n" -ge 25 ]; then printf '▂▄__'; else printf '▂___'; fi; }
wifi_list() {  # prints "*|-<TAB>ssid<TAB>signal<TAB>security" (never an empty first field: read would drop it), strongest first
  nmcli -t -f IN-USE,SSID,SIGNAL,SECURITY dev wifi list --rescan "${1:-no}" 2>/dev/null \
    | sed 's/\\:/\x01/g' | awk -F: '$2 != "" && !seen[$2]++ { gsub(/\x01/, ":", $2); printf "%s\t%s\t%s\t%s\n", ($1 == "*" ? "*" : "-"), $2, $3, $4 }' \
    | sort -t$'\t' -k3,3nr
}
wifi_prompt() { fz --dmenu --prompt "$1 ❯ " --lines 0 --width 40 ${2:+--password} < /dev/null; }
wifi_connect() {  # wifi_connect SSID SECURITY [hidden]
  local ssid="$1" sec="$2" hidden="${3:-}" pw="" out
  if nmcli -g NAME con show 2>/dev/null | grep -qxF -- "$ssid"; then
    out=$(nmcli con up id "$ssid" 2>&1) && { notify "Wi-Fi" "Connected to $ssid"; return; }
    notify "Wi-Fi" "Saved connection failed, trying with a new password"
  fi
  if [ -n "$sec" ] && [ "$sec" != "--" ]; then pw=$(wifi_prompt "Password for $ssid" hide) || return; [ -n "$pw" ] || return; fi
  if out=$(nmcli dev wifi connect "$ssid" ${pw:+password "$pw"} ${hidden:+hidden yes} 2>&1); then notify "Wi-Fi" "Connected to $ssid"
  else notify -u critical "Wi-Fi" "$(printf '%s' "$out" | tail -2)"; fi
}
wifi_menu() {  # wifi_menu [rescan]
  local inuse ssid sig sec entries=() ssids=() secs=() i
  while IFS=$'\t' read -r inuse ssid sig sec; do
    entries+=("$([ "$inuse" = '*' ] && printf '󰤨' || printf '󰤟')  ${ssid}  $(wifi_bars "$sig") ${sig}%  ${sec:---}$([ "$inuse" = '*' ] && printf '  (connected)')")
    ssids+=("$ssid"); secs+=("$sec")
  done < <(wifi_list "${1:-no}")
  local n=${#entries[@]}
  i=$(printf '%s\n' "${entries[@]}" "󰑓  Rescan" "󰤫  Hidden network…" "󰤭  Disconnect" | fz --dmenu --index --prompt "Wi-Fi ❯ " --lines "$(( n + 3 < 20 ? n + 3 : 20 ))" --width 60)
  [[ "${i:-}" =~ ^[0-9]+$ ]] || return 0
  if [ "$i" -lt "$n" ]; then wifi_connect "${ssids[$i]}" "${secs[$i]}"
  elif [ "$i" -eq "$n" ]; then wifi_menu yes
  elif [ "$i" -eq $((n + 1)) ]; then local h; h=$(wifi_prompt "Hidden SSID") || return; [ -n "$h" ] && wifi_connect "$h" WPA hidden
  else nmcli dev disconnect "$(nmcli -t -f DEVICE,TYPE dev | awk -F: '$2=="wifi"{print $1; exit}')" >/dev/null 2>&1; notify "Wi-Fi" "Disconnected"; fi
}

# ---------- VPN (FortiClient CLI: forticlient vpn list|connect|disconnect|status) ----------
vpn_profiles() {  # one profile name per line, from the NAME column of forticlient's table output
  forticlient vpn list 2>/dev/null | awk -F'|' '
    /^\|/ {
      if (!col) { for (i = 1; i <= NF; i++) { h = $i; gsub(/^ +| +$/, "", h); if (h == "NAME") col = i }; next }
      n = $col; gsub(/^ +| +$/, "", n); if (n != "") print n
    }'
}
vpn_state() {
  local st; st=$(forticlient vpn status 2>/dev/null)
  if printf '%s' "$st" | grep -qi disconnected; then echo off
  elif printf '%s' "$st" | grep -qi connected; then echo on
  else echo "?"; fi
}
vpn_connect() {  # run inside the floating terminal so password/SAML prompts are visible
  local name="$1"
  forticlient vpn connect "$name"; forticlient vpn status
  printf '\n[done] press enter to close'; read -r _
}
vpn_status() { notify "VPN" "$(forticlient vpn status 2>&1 | head -5)"; }
vpn_gui() {
  local id; id=$(ls /usr/share/applications 2>/dev/null | grep -i -m1 forticlient | sed 's/\.desktop$//')
  if [ -n "$id" ]; then bg gtk-launch "$id"; else notify "VPN" "FortiClient GUI desktop entry not found"; fi
}
leaves_vpn() { local p="${1:-}" n
  command -v forticlient >/dev/null || { add "󰖂  ${p}FortiClient not installed" 'notify VPN "forticlient command not found"'; return; }
  # connect runs in the background: FortiClient brings up its own GUI for the login
  while IFS= read -r n; do [ -n "$n" ] && add "󰖂  ${p}Connect: $n" "bg forticlient vpn connect $(printf %q "$n"); notify VPN $(printf %q "Connecting to $n")"; done < <(vpn_profiles)
  add "󰖂  ${p}Connect in terminal (shows CLI output)" "tui $(printf %q "$SELF") vpn-pick"
  add "󰖂  ${p}Disconnect ($(vpn_state))" 'forticlient vpn disconnect >/dev/null 2>&1; notify VPN "Disconnected"'
  add "󰖂  ${p}Status" vpn_status
  add "󰖂  ${p}FortiClient GUI" vpn_gui; }
vpn_pick() {  # fzf over profiles, in the floating terminal
  local n; n=$(vpn_profiles | fzf --prompt 'VPN ❯ ' --header 'enter: connect · esc: cancel') || exit 0
  [ -n "$n" ] && vpn_connect "$n"
}

# ---------- Bookmarks (Chrome folder "$BOOKMARK_FOLDER", from profile files and managed policy) ----------
# Chrome bookmarks folder to list (profiles + managed policy). Empty = every bookmark.
# Override with SWAY_MENU_BOOKMARK_FOLDER in the session environment (not fish: sway launches this directly).
BOOKMARK_FOLDER="${SWAY_MENU_BOOKMARK_FOLDER-Fortnox}"
bookmarks_list() {  # prints "url<TAB>title<TAB>path"; url first because a leading empty field would be eaten by read
  python3 - "$BOOKMARK_FOLDER" "$HOME" <<'PY'
import glob, json, os, sys
want, home = sys.argv[1].lower(), sys.argv[2]
ALL = (want == "")
seen = set()
def emit(path, title, url):
    if url and (url not in seen):
        seen.add(url); print(f"{url}\t{title}\t{path}")
def walk_profile(node, path, inside):
    t = node.get("type")
    if t == "url" and inside:
        emit(path, node.get("name", ""), node.get("url", ""))
    elif t == "folder":
        here = inside or node.get("name", "").lower() == want
        sub = (path + " › " + node["name"]) if (inside and path) else (node["name"] if inside else "")
        for c in node.get("children", []): walk_profile(c, sub, here)
def walk_root(root):  # ALL mode: start inside, but do not prefix with the root folder name
    for c in root.get("children", []): walk_profile(c, "", True)
def walk_policy(items, path, inside):
    for it in items:
        if "url" in it and inside: emit(path, it.get("name", ""), it["url"])
        elif "children" in it:
            here = inside or it.get("name", "").lower() == want
            sub = (path + " › " + it["name"]) if (inside and path) else (it["name"] if inside else "")
            walk_policy(it["children"], sub, here)
for f in glob.glob(f"{home}/.config/google-chrome*/*/Bookmarks") + glob.glob(f"{home}/.config/chromium/*/Bookmarks") + glob.glob(f"{home}/snap/chromium/common/chromium/*/Bookmarks") + glob.glob(f"{home}/.var/app/*/config/*chrom*/*/Bookmarks"):
    try:
        with open(f, encoding="utf-8") as fh: roots = json.load(fh).get("roots", {})
    except Exception: continue
    for r in roots.values():
        if isinstance(r, dict): (walk_root(r) if ALL else walk_profile(r, "", False))
def policy_items(mb):
    top = next((x.get("toplevel_name") for x in mb if isinstance(x, dict) and "toplevel_name" in x), "")
    items = [x for x in mb if isinstance(x, dict) and "toplevel_name" not in x]
    before = len(seen)
    walk_policy(items, "", ALL or (top or "").lower() == want)
    if len(seen) == before:  # no folder by that name: managed bookmarks are all company links, show them all
        walk_policy(items, "", True)
for f in glob.glob("/etc/opt/chrome/policies/managed/*.json") + glob.glob("/etc/chromium/policies/managed/*.json"):
    try:
        with open(f, encoding="utf-8") as fh: policy_items(json.load(fh).get("ManagedBookmarks", []))
    except Exception: continue
# Cloud-managed Chrome (CBCM) caches policy as protobuf; the ManagedBookmarks value inside is a JSON string.
def json_arrays(data):
    i = 0
    while True:
        i = data.find(b'[', i)
        if i < 0: return
        k = i + 1
        while k < len(data) and data[k] in b' \t\r\n': k += 1
        if k >= len(data) or data[k] != 0x7B: i += 1; continue
        depth = 0; j = i; instr = False; esc = False
        while j < len(data):
            c = data[j]
            if instr:
                if esc: esc = False
                elif c == 0x5C: esc = True
                elif c == 0x22: instr = False
            else:
                if c == 0x22: instr = True
                elif c in (0x5B, 0x7B): depth += 1
                elif c in (0x5D, 0x7D):
                    depth -= 1
                    if depth == 0: break
            j += 1
        try: obj = json.loads(data[i:j + 1].decode("utf-8"))
        except Exception: obj = None
        if isinstance(obj, list) and any(isinstance(x, dict) and ("url" in x or "children" in x or "toplevel_name" in x) for x in obj):
            yield obj; i = j + 1
        else:
            i += 1
for f in glob.glob(f"{home}/.config/google-chrome*/Policy/*Cloud Policy") + glob.glob(f"{home}/.config/google-chrome*/*/Policy/User Policy") \
       + glob.glob(f"{home}/.config/chromium/Policy/*Cloud Policy") + glob.glob(f"{home}/.config/chromium/*/Policy/User Policy"):
    try:
        with open(f, "rb") as fh: data = fh.read()
    except Exception: continue
    for arr in json_arrays(data): policy_items(arr)
PY
}
open_url() {  # bookmarks come from Chrome, but open in qutebrowser (the session's browser)
  if command -v qutebrowser >/dev/null; then bg qutebrowser "$1"; else bg xdg-open "$1"; fi
}
leaves_bookmarks() { local p="${1:-}" path title url n=0
  while IFS=$'\t' read -r url title path; do
    [ -n "$url" ] || continue; n=$((n+1))
    add "󰃀  ${p}${path:+$path › }$title" "open_url $(printf %q "$url")"
  done < <(bookmarks_list)
  [ "$n" -gt 0 ] || add "󰃀  ${p}No Chrome bookmarks found${BOOKMARK_FOLDER:+ in folder '$BOOKMARK_FOLDER'}" 'notify Bookmarks "Nothing found in Chrome profiles or managed policy"'; }


# ---------- Display (omarchy-shell monitor panel) ----------
copy() { printf '%s' "$1" | wl-copy; notify "Copied" "$1"; }
bright_pct() { brightnessctl -m 2>/dev/null | awk -F, 'NR==1 { gsub(/%/, "", $4); print $4 }'; }
set_bright() { brightnessctl set "$1" >/dev/null 2>&1; submenu display; }
focused_output() { swaymsg -t get_outputs 2>/dev/null | jq -r '.[] | select(.focused) | .name'; }
set_scale() {  # persisted in ~/.local/state/sway/display.conf, included by the sway config
  local o; o=$(focused_output); [ -n "$o" ] || return
  swaymsg output "$o" scale "$1" >/dev/null; mkdir -p "$STATE"
  { grep -v "^output $o scale" "$STATE/display.conf" 2>/dev/null; echo "output $o scale $1"; } > "$STATE/display.conf.new" && mv "$STATE/display.conf.new" "$STATE/display.conf"
  submenu display
}
toggle_output() {  # toggle_output NAME true|false
  local n; n=$(swaymsg -t get_outputs | jq '[.[] | select(.active)] | length')
  if [ "$2" = true ]; then
    if [ "$n" -le 1 ]; then notify "Display" "Cannot disable the last active display"; else swaymsg output "$1" disable >/dev/null; fi
  else swaymsg output "$1" enable >/dev/null; fi
  submenu display
}
leaves_display() { local p="${1:-}" b o l s name active mode
  b=$(bright_pct)
  if [ -n "$b" ]; then
    add "󰃠  ${p}Brightness ${b}%  (+10)" 'set_bright 10%+'
    add "󰃞  ${p}Brightness ${b}%  (−10)" 'set_bright 10%-'
    for l in 10 25 50 75 100; do add "󰃟  ${p}Brightness $l%" "set_bright $l%"; done
  fi
  o=$(focused_output)
  for s in 1 1.25 1.5 2; do add "󰍹  ${p}Scale $s${o:+ ($o)}" "set_scale $s"; done
  while IFS=$'\t' read -r name active mode; do
    add "$([ "$active" = true ] && printf '󰍹' || printf '󰶐')  ${p}Display $name · $mode · $([ "$active" = true ] && echo on || echo off)" "toggle_output $(printf %q "$name") $active"
  done < <(swaymsg -t get_outputs 2>/dev/null | jq -r '.[] | [.name, (.active|tostring), ((.current_mode // {}) | "\(.width // "?")x\(.height // "?")")] | @tsv')
  add "󰖔  ${p}Night light ($(onoff pgrep -x wlsunset))" 'toggle_night; submenu display'
  add "󰍹  ${p}Monitors (wdisplays)" 'bg wdisplays'; }

# ---------- Network (omarchy-shell network panel; nmcli) ----------
primary_dev() { nmcli -t -f DEVICE,TYPE,STATE dev 2>/dev/null | awk -F: '$3 == "connected" && ($2 == "wifi" || $2 == "ethernet") { print $1; exit }'; }
active_con() { nmcli -t -f NAME,DEVICE con show --active 2>/dev/null | awk -F: -v d="$1" '$2 == d { print $1; exit }'; }
net_ping() { local r1 r2
  r1=$(ping -c1 -W1 "$1" 2>/dev/null | awk -F'time=' '/time=/ { print $2 }'); r2=$(ping -c1 -W1 1.1.1.1 2>/dev/null | awk -F'time=' '/time=/ { print $2 }')
  notify "Ping" "gateway: ${r1:-timeout}
1.1.1.1: ${r2:-timeout}"; }
set_dns() {  # set_dns CONNECTION ''|'servers'|ask
  local con="$1" servers="$2"
  if [ "$servers" = ask ]; then servers=$(fz --dmenu --prompt "DNS servers ❯ " --lines 0 --width 40 </dev/null) || return; fi
  if [ -z "$servers" ]; then nmcli con mod "$con" ipv4.dns "" ipv4.ignore-auto-dns no
  else nmcli con mod "$con" ipv4.dns "$servers" ipv4.ignore-auto-dns yes; fi >/dev/null 2>&1
  nmcli con up "$con" >/dev/null 2>&1 && notify "DNS" "${servers:-automatic (DHCP)}"
  submenu network
}
set_band() { local b="$2"; [ "$b" = auto ] && b=""
  nmcli con mod "$1" 802-11-wireless.band "$b" >/dev/null 2>&1 && nmcli con up "$1" >/dev/null 2>&1 && notify "Wi-Fi band" "$2"
  submenu network; }
wifi_qr() { local psk; psk=$(nmcli -s -g 802-11-wireless-security.psk con show "$1" 2>/dev/null)
  WIFI_QR="WIFI:T:WPA;S:$2;P:$psk;;" tui_wait 'qrencode -t ansiutf8 "$WIFI_QR"; printf "\n%s\n" "'"$2"'"'; }
leaves_network() { local p="${1:-}" dev con ip gw dns act sig freq ssid n b
  dev=$(primary_dev); con=${dev:+$(active_con "$dev")}
  if [ -n "$dev" ]; then
    ip=$(nmcli -g IP4.ADDRESS dev show "$dev" 2>/dev/null | head -1); gw=$(nmcli -g IP4.GATEWAY dev show "$dev" 2>/dev/null)
    dns=$(nmcli -g IP4.DNS dev show "$dev" 2>/dev/null | paste -sd' ')
    IFS=: read -r act sig freq ssid < <(nmcli -t -f ACTIVE,SIGNAL,FREQ,SSID dev wifi list 2>/dev/null | awk -F: '$1 == "yes" { print; exit }')
    [ -n "${ssid:-}" ] && add "󰤨  ${p}$ssid  ${sig}%  $freq" "copy $(printf %q "$ssid")"
    add "󰩟  ${p}$dev  $ip" "copy $(printf %q "${ip%%/*}")"
    add "󰑩  ${p}Gateway $gw" "copy $(printf %q "$gw")"
    add "󰇖  ${p}DNS ${dns:-automatic}" "copy $(printf %q "$dns")"
    add "󰓅  ${p}Ping gateway and 1.1.1.1" "net_ping $(printf %q "$gw")"
  fi
  add "󰤨  ${p}Wi-Fi power: $(nmcli radio wifi 2>/dev/null || echo ?)" 'nmcli radio wifi "$([ "$(nmcli radio wifi)" = enabled ] && echo off || echo on)"; submenu network'
  add "󰤨  ${p}Wi-Fi networks…" wifi_menu
  if [ -n "$con" ]; then
    add "󰇖  ${p}DNS: automatic (DHCP)" "set_dns $(printf %q "$con") ''"
    add "󰇖  ${p}DNS: Cloudflare" "set_dns $(printf %q "$con") '1.1.1.1 1.0.0.1'"
    add "󰇖  ${p}DNS: Google" "set_dns $(printf %q "$con") '8.8.8.8 8.8.4.4'"
    add "󰇖  ${p}DNS: custom…" "set_dns $(printf %q "$con") ask"
    if [ -n "${ssid:-}" ]; then
      for b in auto a bg; do add "󰤨  ${p}Band: $b" "set_band $(printf %q "$con") $b"; done
      command -v qrencode >/dev/null && add "󰐲  ${p}Share Wi-Fi (QR)" "wifi_qr $(printf %q "$con") $(printf %q "$ssid")"
    fi
  fi
  while IFS= read -r n; do [ -n "$n" ] && add "󰅖  ${p}Forget: $n" "nmcli con delete $(printf %q "$n") >/dev/null; submenu network"; done < <(nmcli -t -f NAME,TYPE con show 2>/dev/null | awk -F: '$2 == "802-11-wireless" { print $1 }')
  add "󰤨  ${p}Wifi (nmtui)" 'tui nmtui'; }

# ---------- Audio (omarchy-shell audio panel; wpctl) ----------
wp_list() {  # wp_list Sinks|Sources|Streams -> "id<TAB>*|-<TAB>name<TAB>vol"
  wpctl status 2>/dev/null | awk -v sec="$1" '
    /^Audio/ { a = 1 } /^Video/ { a = 0 }
    a && /^ [├└]─ / { insec = index($0, sec ":") > 0; next }
    a && insec && match($0, /^ │ +\*? *[0-9]+\. /) {
      if ($0 ~ / [<>] /) next                                   # stream port lines
      def = ($0 ~ /^ │ +\*/) ? "*" : "-"
      id = substr($0, 1, RLENGTH); sub(/\. $/, "", id); sub(/.*[^0-9]/, "", id)
      name = substr($0, RLENGTH + 1); vol = ""
      if (match(name, /\[vol: [0-9.]+( MUTED)?\]/)) { vol = substr(name, RSTART + 6, RLENGTH - 7); name = substr(name, 1, RSTART - 1) }
      sub(/ +$/, "", name)
      printf "%s\t%s\t%s\t%s\n", id, def, name, vol
    }'
}
vol_pct() { wpctl get-volume "$1" 2>/dev/null | awk '{ printf "%d%%%s", $2 * 100 + 0.5, ($3 == "[MUTED]" ? " muted" : "") }'; }
set_vol() { wpctl set-volume -l 1 "$1" "$2" >/dev/null 2>&1; submenu audio; }
leaves_audio() { local p="${1:-}" o i l id def name vol
  o=$(vol_pct @DEFAULT_AUDIO_SINK@); i=$(vol_pct @DEFAULT_AUDIO_SOURCE@)
  add "󰕾  ${p}Output ${o:-?}  (+10)" 'set_vol @DEFAULT_AUDIO_SINK@ 10%+'
  add "󰕿  ${p}Output ${o:-?}  (−10)" 'set_vol @DEFAULT_AUDIO_SINK@ 10%-'
  add "󰝟  ${p}Output mute toggle" 'wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle; submenu audio'
  for l in 0 25 50 75 100; do add "󰕾  ${p}Output $l%" "set_vol @DEFAULT_AUDIO_SINK@ $l%"; done
  while IFS=$'\t' read -r id def name vol; do
    add "$([ "$def" = '*' ] && printf '󰓃' || printf '󰓄')  ${p}Output device: $name$([ "$def" = '*' ] && printf '  (default)')" "wpctl set-default $id; submenu audio"
  done < <(wp_list Sinks)
  add "󰍬  ${p}Input ${i:-?}  (+10)" 'set_vol @DEFAULT_AUDIO_SOURCE@ 10%+'
  add "󰍬  ${p}Input ${i:-?}  (−10)" 'set_vol @DEFAULT_AUDIO_SOURCE@ 10%-'
  add "󰍭  ${p}Input mute toggle" 'wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle; submenu audio'
  while IFS=$'\t' read -r id def name vol; do
    add "$([ "$def" = '*' ] && printf '󰍬' || printf '󰍮')  ${p}Input device: $name$([ "$def" = '*' ] && printf '  (default)')" "wpctl set-default $id; submenu audio"
  done < <(wp_list Sources)
  while IFS=$'\t' read -r id def name vol; do
    add "󰎈  ${p}Stream: $name${vol:+  $vol}  (mute toggle)" "wpctl set-mute $id toggle; submenu audio"
  done < <(wp_list Streams)
  add "󰕾  ${p}Mixer (wiremix)" "tui sh -c 'command -v wiremix >/dev/null && exec wiremix || exec pavucontrol'"
  add "󰕾  ${p}Audio (GUI)" 'bg pavucontrol'; }

# ---------- Bluetooth (omarchy-shell bluetooth panel; bluetoothctl) ----------
bt_powered() { bluetoothctl show 2>/dev/null | grep -q "Powered: yes"; }
bt_devices() { bluetoothctl devices "$@" 2>/dev/null | awk '$1 == "Device" { mac = $2; $1 = $2 = ""; sub(/^ +/, ""); print mac "\t" $0 }'; }
bt_scan() { notify "Bluetooth" "Scanning for 8 s…"; bluetoothctl --timeout 8 scan on >/dev/null 2>&1; BT_SHOW_NEW=1 submenu bluetooth; }
bt_pair() {
  if bluetoothctl pair "$1" >/dev/null 2>&1 && bluetoothctl trust "$1" >/dev/null 2>&1 && bluetoothctl connect "$1" >/dev/null 2>&1; then notify "Bluetooth" "Connected"
  else notify -u critical "Bluetooth" "Pairing failed"; fi
  submenu bluetooth
}
leaves_bluetooth() { local p="${1:-}" mac name st; st=$(bt_powered && echo on || echo off)
  local -A connected=() known=()
  add "󰂯  ${p}Power: $st" "bluetoothctl power $([ "$st" = on ] && echo off || echo on) >/dev/null; submenu bluetooth"
  while IFS=$'\t' read -r mac name; do connected[$mac]=1; add "󰂱  ${p}Connected: $name  (disconnect)" "bluetoothctl disconnect $mac >/dev/null; submenu bluetooth"; done < <(bt_devices Connected)
  while IFS=$'\t' read -r mac name; do known[$mac]=1; [ -n "${connected[$mac]:-}" ] || add "󰂯  ${p}Connect: $name" "bluetoothctl connect $mac >/dev/null; submenu bluetooth"; done < <(bt_devices Paired)
  add "󰂰  ${p}Scan for new devices (8 s)…" bt_scan
  if [ -n "${BT_SHOW_NEW:-}" ]; then
    while IFS=$'\t' read -r mac name; do [ -n "${known[$mac]:-}" ] || add "󰂳  ${p}Pair: $name" "bt_pair $mac"; done < <(bt_devices)
  fi
  while IFS=$'\t' read -r mac name; do add "󰅖  ${p}Forget: $name" "bluetoothctl remove $mac >/dev/null; submenu bluetooth"; done < <(bt_devices Paired)
  add "󰂯  ${p}Bluetooth (bluetui)" 'tui bluetui'
  add "󰂯  ${p}Bluetooth (GUI)" 'bg blueman-manager'; }

# ---------- Weather (omarchy-shell weather panel; sway-weather) ----------
weather_set_location() { local q sel
  q=$(fz --dmenu --prompt "Location ❯ " --lines 0 --width 40 </dev/null) || return; [ -n "$q" ] || return
  sel=$(sway-weather --search "$q" | fz --dmenu --prompt "Pick ❯ " --lines 6 --width 70) || return
  [ -n "$sel" ] && sway-weather --set-location "$sel" && submenu weather; }
leaves_weather() { local p="${1:-}" line
  while IFS= read -r line; do [ -n "$line" ] && add "󰖐  ${p}$line" "copy $(printf %q "$line")"; done < <(sway-weather --tooltip 2>/dev/null)
  add "󰍎  ${p}Set location…" weather_set_location
  add "󰍎  ${p}Use automatic location" 'sway-weather --clear-location; submenu weather'
  add "󰔏  ${p}Units: $(sway-weather --unit)  (toggle)" 'sway-weather --toggle-units; submenu weather'
  add "󰑓  ${p}Refresh now" 'sway-weather --refresh; notify Weather "Refreshing"'; }
tz_menu() { local tz
  tz=$(timedatectl list-timezones 2>/dev/null | fz --dmenu --prompt "Timezone ❯ " --lines 20 --width 50) || return
  [ -n "$tz" ] && tui_wait "sudo timedatectl set-timezone $(printf %q "$tz") && echo Timezone: $(printf %q "$tz")"; }

# ---------- Install / Update / Learn / About / System ----------
# fzf over apt, like omarchy-pkg-install/-remove. Runs inside the floating terminal.
pkg_install() {
  local pkgs
  pkgs=$(apt-cache search --names-only . | sort \
    | fzf --multi --prompt 'Install ❯ ' --header 'tab: select several · enter: install · esc: cancel' \
          --preview 'apt-cache show {1} 2>/dev/null | grep -v -E "^(SHA|MD5|Filename|Size|Tag|Section|Priority)" | head -40' \
          --preview-window right:55%:wrap | cut -d' ' -f1) || exit 0
  [ -n "$pkgs" ] || exit 0
  # shellcheck disable=SC2086
  sudo apt install $pkgs; printf '\n[done] press enter to close'; read -r _
}
pkg_remove() {
  local pkgs
  pkgs=$(dpkg-query -W -f '${binary:Package} - ${Version}\n' | sort \
    | fzf --multi --prompt 'Remove ❯ ' --header 'tab: select several · enter: remove · esc: cancel' \
          --preview 'apt-cache show {1} 2>/dev/null | grep -v -E "^(SHA|MD5|Filename|Size|Tag|Section|Priority)" | head -40' \
          --preview-window right:55%:wrap | cut -d' ' -f1) || exit 0
  [ -n "$pkgs" ] || exit 0
  # shellcheck disable=SC2086
  sudo apt remove $pkgs; printf '\n[done] press enter to close'; read -r _
}
leaves_install() { local p="${1:-}"
  add "󰏖  ${p}Install package" "tui $(printf %q "$SELF") pkg-install"
  add "󰆴  ${p}Remove package"  "tui $(printf %q "$SELF") pkg-remove"; }
leaves_update() { local p="${1:-}"
  add "󰚰  ${p}Update system (apt)" "tui_wait 'sudo apt update && sudo apt full-upgrade'"
  add "󰊢  ${p}Update dotfiles (git pull + init.sh)" "tui_wait \"cd $(printf %q "$DOTFILES") && git pull --ff-only && bash init.sh\""; }
show_keybindings() {
  grep -E '^\s*bindsym' "$SWAY_CONFIG" \
    | sed -E 's/^\s*bindsym\s+(--[a-z-]+\s+)*//; s/\$mod/Super/g; s/Mod1/Alt/g; s/\s+exec\s+/  →  /; s/^([^ ]+)\s+/\1  →  /' \
    | fz --dmenu --prompt "Keybindings ❯ " --lines 25 --width 80 >/dev/null; }
leaves_learn() { local p="${1:-}"
  add "󰌌  ${p}Keybindings" show_keybindings
  add "󰖟  ${p}Sway wiki" 'bg xdg-open https://github.com/swaywm/sway/wiki'
  add "󰊢  ${p}Dotfiles repo" 'bg xdg-open https://github.com/kr4nkenwagen/dotfiles'; }
about() { tui_wait 'command -v fastfetch >/dev/null && fastfetch || { uname -a; lsb_release -a; sway --version; }'; }
leaves_system() { local p="${1:-}"
  add "󰌾  ${p}Lock" lock
  add "󰤄  ${p}Suspend" 'systemctl suspend'
  add "󰑓  ${p}Reload sway" 'swaymsg reload >/dev/null'
  add "󰍃  ${p}Logout" 'confirm "Log out?" && swaymsg exit'
  add "󰜉  ${p}Reboot" 'confirm "Reboot?" && systemctl reboot'
  add "󰐥  ${p}Shutdown" 'confirm "Shut down?" && systemctl poweroff'; }

# ---------- Apps from .desktop files ----------
apps_add() {
  local name id
  while IFS=$'\t' read -r name id; do
    add "󰀻  App: $name" "bg gtk-launch ${id@Q}"
  done < <(apps_list)
}
apps_list() {  # cached in ~/.cache/sway-menu/apps.tsv until any applications dir changes
  local dirs=("$HOME/.local/share/applications" /usr/local/share/applications /usr/share/applications /var/lib/flatpak/exports/share/applications /var/lib/snapd/desktop/applications)
  local d files=() cache="$HOME/.cache/sway-menu/apps.tsv" fresh=1
  for d in "${dirs[@]}"; do [ -d "$d" ] || continue; files+=("$d"/*.desktop); [ "$d" -nt "$cache" ] && fresh=0; done
  [ ${#files[@]} -gt 0 ] || return 0
  if [ "$fresh" = 1 ] && [ -s "$cache" ]; then cat "$cache"; return; fi
  mkdir -p "$(dirname "$cache")"
  apps_scan "${files[@]}" | tee "$cache"
}
apps_scan() {
  awk '
    FNR == 1 { flush(); sec = ""; name = ""; skip = 0; n = split(FILENAME, parts, "/"); id = parts[n]; sub(/\.desktop$/, "", id) }
    /^\[/ { sec = $0; next }
    sec != "[Desktop Entry]" { next }
    /^Name=/ && name == "" { name = substr($0, 6) }
    /^NoDisplay=true/ || /^Hidden=true/ { skip = 1 }
    /^Type=/ && $0 != "Type=Application" { skip = 1 }
    /^OnlyShowIn=/ { skip = 1 }
    END { flush() }
    function flush() { if (name != "" && !skip && !(id in seen)) { seen[id] = 1; printf "%s\t%s\n", name, id } }
  ' "$@" 2>/dev/null | sort -f -t $'\t' -k1,1
}

# ---------- menus ----------
sections=(learn capture toggle style display network audio bluetooth weather setup vpn bookmarks install update system)
# Sections whose rows are cheap to build (no device/network queries); only these are searchable
# from the top level. The others show as a section row and build their rows when opened, so
# the menu appears instantly instead of waiting on nmcli, wpctl, bluetoothctl, forticlient,
# powerprofilesctl, the weather cache and the Chrome bookmark parser.
fast_sections=(learn capture style install update system)
section_icon() { case "$1" in learn) echo 󰧑;; capture) echo 󰄀;; toggle) echo 󰔎;; style) echo 󰸌;; display) echo 󰍹;; network) echo 󰤨;; audio) echo 󰕾;; bluetooth) echo 󰂯;; weather) echo 󰖐;; setup) echo 󰒓;; vpn) echo 󰖂;; bookmarks) echo 󰃀;; install) echo 󰏖;; update) echo 󰚰;; system) echo 󰐥;; esac; }
section_title() { case "$1" in vpn) printf VPN;; *) printf '%s' "${1^}";; esac; }
submenu() {                                       # submenu SECTION
  reset; "leaves_$1" ""; add "󰁍  Back" main_menu; show "$(section_title "$1")"
}
main_menu() {
  reset
  local s
  add "󰀻  Apps" 'bg fz'
  for s in "${sections[@]}"; do add "$(section_icon "$s")  $(section_title "$s")" "submenu $s"; done
  add "󰋽  About" about
  local top=${#L[@]}
  # Leaves and apps come after the sections. Showing only $top rows keeps them out of
  # sight until you type; fuzzel still filters across all of them.
  for s in "${fast_sections[@]}"; do "leaves_$s" "$(section_title "$s") › "; done
  apps_add
  show Menu "$top"
}

case "${1:-}" in
  lock) lock ;;
  idle) idle ;;
  pkg-install) pkg_install ;;
  pkg-remove) pkg_remove ;;
  wallpaper) wallpaper_picker ;;
  wallpaper-next) bg_next ;;
  wallpaper-random) bg_random ;;
  wallpaper-restore) wallpaper_restore ;;
  thumbs-warm) thumbs_warm ;;
  thumb-make) mkdir -p "$(dirname "$3")"; thumb_make "${2:?file}" "${3:?out}" ;;
  wifi) wifi_menu ;;
  vpn-connect) vpn_connect "${2:?profile name}" ;;
  vpn-pick) vpn_pick ;;
  theme) sway-theme-set "${2:?theme name}" ;;
  theme-next) sway-theme-set next ;;
  theme-pick) theme_pick ;;
  background) set_background "${2:?image path}" ;;
  display|network|audio|bluetooth|weather) submenu "$1" ;;
  timezone) tz_menu ;;
  "") main_menu ;;
  *) echo "usage: sway-menu [lock|idle|pkg-install|pkg-remove|wallpaper|wifi|vpn-connect NAME|vpn-pick|theme NAME|theme-next|theme-pick|background FILE|display|network|audio|bluetooth|weather|timezone]" >&2; exit 2 ;;
esac

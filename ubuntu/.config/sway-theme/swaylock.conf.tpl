# Lock screen. Rendered by sway-theme-set; sway-menu runs swaylock -C on this file and
# passes the wallpaper on the command line.
font={{ font }}
color={{ background_strip }}
indicator-radius=100
indicator-thickness=8
inside-color={{ background_strip }}
ring-color={{ accent_strip }}
key-hl-color={{ green_strip }}
bs-hl-color={{ red_strip }}
text-color={{ foreground_strip }}
line-color={{ background_strip }}
separator-color={{ background_strip }}
inside-ver-color={{ background_strip }}
ring-ver-color={{ cyan_strip }}
text-ver-color={{ foreground_strip }}
inside-wrong-color={{ background_strip }}
ring-wrong-color={{ red_strip }}
text-wrong-color={{ red_strip }}
ignore-empty-password
show-failed-attempts

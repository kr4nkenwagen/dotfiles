# Notifications. Rendered by sway-theme-set; mako is started with -c on this file.
font={{ font }} 11
background-color={{ background }}
text-color={{ foreground }}
border-color={{ accent }}
border-size=2
border-radius=0
default-timeout=5000

[urgency=high]
border-color={{ red }}
default-timeout=0

[mode=do-not-disturb]
invisible=1

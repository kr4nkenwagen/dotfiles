#!/bin/bash
# Omarchy calls this with the snake-cased name of the theme that has just been set.
# The sync scripts come from the theme stow package (~/.local/bin) and are shared
# with the Ubuntu/Sway profile's sway-theme-set.

"$HOME/.local/bin/theme-sync-tmux" "$1"
"$HOME/.local/bin/theme-sync-qutebrowser"

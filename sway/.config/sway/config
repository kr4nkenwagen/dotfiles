# Sway config for the Ubuntu work-laptop profile. Mirrors the Omarchy Hyprland
# bindings as closely as Sway allows. Colours come from the current Omarchy-format
# theme: sway-theme-set renders them into $theme (see ~/.local/bin/sway-theme-set).
# Needs: sway swaylock swayidle swaybg waybar mako fuzzel lxpolkit xdg-terminal-exec
#        brightnessctl playerctl pavucontrol grim slurp wl-clipboard clipse

set $mod Mod4
set $term ghostty
set $browser qutebrowser
set $theme ~/.local/state/omarchy/current/theme
set $menu fuzzel --config $theme/fuzzel.ini
set $menu_sys ~/.local/bin/sway-menu
set $lock $menu_sys lock
set $tui $term --class=TUI.float -e

# font: set in $theme/sway.conf (sway-font-set)

# Window colours (client.*) and font, rendered by sway-theme-set
include $theme/sway.conf

default_border pixel 2
default_floating_border pixel 2
gaps inner 5
gaps outer 10
focus_follows_mouse yes
floating_modifier $mod normal

# Wallpaper: sway-menu repaints the saved choice (awww with a transition when installed, else swaybg).
exec $menu_sys wallpaper-restore
# Retina-class 2x display, matches hypr/monitors.conf. Comment out for 1080p/1440p.
# output * scale 2

# Input, matches hypr/input.conf
input type:keyboard {
    xkb_layout us
    xkb_options compose:caps
    xkb_numlock enabled
    repeat_rate 40
    repeat_delay 600
}
input type:touchpad {
    natural_scroll enabled
    scroll_factor 0.4
    accel_profile adaptive
    pointer_accel -0.2
}
input type:pointer {
    accel_profile adaptive
    pointer_accel -0.2
}

# Autostart
exec dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP=sway
# exec_always so a reload restarts the bar and picks up config changes.
# The status bar: k4's (k4-bar, one per output) unless Toggle › Status bar picked Waybar or k4 is missing
exec_always sh -c 'pkill -x waybar; pkill -f "^k4 --bar"; sleep 0.3; if [ "$(cat ~/.local/state/sway/bar 2>/dev/null || echo k4)" = k4 ] && [ -x ~/.local/bin/k4 ]; then exec ~/.local/bin/k4-bar; else exec waybar -c $theme/waybar.jsonc -s $theme/waybar.css; fi'
# notifications: k4's (k4-notify: popups, the Super+N centre), mako without k4
# (a mako already started by an early notification gives way: it doesn't let k4 take over)
exec sh -c 'if [ -x ~/.local/bin/k4 ]; then pkill -x mako; sleep 0.2; exec ~/.local/bin/k4-notify daemon; else exec mako -c $theme/mako.ini; fi'
exec ~/.local/bin/sway-menu displays-watch   # each set of screens gets the layout it had last time
exec ~/.local/bin/k4-share daemon   # LocalSend for k4: receive and send (port 53317 tcp/udp must be open)
exec lxpolkit
exec nm-applet
exec blueman-applet
exec clipse -listen
exec ~/.local/bin/k4-clip watch  # each copy's app; secrets leave the history after 12 s
exec $menu_sys idle

# Applications. Tools that live in ~/.local/bin or ~/.cargo/bin go through `sway-menu tui`,
# which fixes up PATH: sway's own environment is the login one, without those dirs.
bindsym $mod+Return exec $term
bindsym $mod+Mod1+Return exec $term -e tmux new-session -A -s main
bindsym $mod+space exec sh -c '[ -x ~/.local/bin/k4 ] && exec ~/.local/bin/sway-menu apps || exec fuzzel --config ~/.local/state/omarchy/current/theme/fuzzel.ini'   # apps (k4), fuzzel without it
bindsym $mod+Mod1+space exec $menu_sys
bindsym $mod+Shift+Ctrl+space exec $menu_sys theme-pick   # the theme page
bindsym $mod+Ctrl+space exec $menu_sys wallpaper          # the background switcher
bindsym $mod+Shift+space exec $menu_sys call toggle_bar
bindsym $mod+k exec $menu_sys keybindings
bindsym $mod+Shift+b exec $browser
bindsym $mod+Shift+Return exec $browser
bindsym $mod+Shift+Mod1+b exec $browser --private
bindsym $mod+Shift+n exec $term -e nvim
bindsym $mod+Shift+t exec $tui btop
bindsym $mod+Shift+e exec $tui ranger
bindsym $mod+Shift+v exec $tui clipse
bindsym $mod+Shift+d exec $menu_sys tui discordo
bindsym $mod+Shift+m exec $tui cmus
bindsym $mod+Shift+r exec $tui aerc
bindsym $mod+Shift+c exec $menu_sys tui chronos
bindsym $mod+Shift+o exec obsidian
bindsym $mod+Shift+z exec spotify
bindsym $mod+Shift+slash exec 1password
# web apps (Omarchy's), in the browser
bindsym $mod+Shift+a exec $browser https://gemini.google.com
bindsym $mod+Shift+Mod1+a exec $browser https://grok.com
bindsym $mod+Shift+y exec $browser https://youtube.com/
bindsym $mod+Shift+p exec $browser https://photos.google.com/
bindsym $mod+Shift+x exec $browser https://x.com/
bindsym $mod+Shift+Mod1+x exec $browser https://x.com/compose/post
bindsym $mod+Shift+Mod1+g exec $browser https://web.whatsapp.com/
bindsym $mod+Shift+Ctrl+g exec $browser https://messages.google.com/web
bindsym $mod+Ctrl+g exec ~/.local/bin/steam-menu
bindsym $mod+Ctrl+m exec ~/.local/bin/k4-apps
bindsym $mod+Ctrl+p exec ~/.local/bin/pass-menu
bindsym $mod+Ctrl+t exec $tui btop
# the launcher's pages, where Omarchy has its own menus
bindsym $mod+Ctrl+a exec $menu_sys audio
bindsym $mod+Ctrl+b exec $menu_sys bluetooth
bindsym $mod+Ctrl+w exec $menu_sys network
bindsym $mod+Ctrl+d exec $menu_sys display
bindsym $mod+Ctrl+Mod1+d exec $menu_sys calendar
bindsym $mod+Ctrl+Mod1+b exec $menu_sys battery
bindsym $mod+Ctrl+Mod1+w exec $menu_sys weather
# toggles
bindsym $mod+Ctrl+l exec $menu_sys lock
bindsym $mod+Ctrl+n exec $menu_sys call toggle_night
bindsym $mod+Ctrl+i exec $menu_sys call toggle_idle
bindsym $mod+Shift+BackSpace exec $menu_sys call toggle_gaps
# Universal copy and paste (Super+C / Super+V work in terminals too, as on Omarchy)
# on release, after a moment: the held Super would otherwise merge into the typed chord
bindsym --release $mod+c exec sh -c 'sleep 0.15; wtype -M ctrl -k Insert -m ctrl'
bindsym --release $mod+v exec sh -c 'sleep 0.15; wtype -M shift -k Insert -m shift'
bindsym $mod+Ctrl+e exec ~/.local/bin/emoji-menu   # emoji picker (k4), as Omarchy's Super+Ctrl+E
bindsym $mod+Ctrl+v exec ~/.local/bin/k4-clip  # clipboard history (k4 + clipse), as on Omarchy
bindsym $mod+Ctrl+c exec ~/.local/bin/sway-menu capture   # k4's Capture menu, as on Omarchy
bindsym $mod+n exec ~/.local/bin/k4-notify center     # k4's notification centre (k4-notify replaces mako)
bindsym $mod+Mod1+m exec ~/.local/bin/k4-messenger window  # Messenger (k4, over a bridge on this machine)
bindsym $mod+Mod1+n exec ~/.local/bin/k4-notify focus  # the popups take the keyboard: ↑↓ ↵ 1–3 Del Space r(eply) Esc
bindsym $mod+period exec ~/.local/bin/k4-tray popup   # the system tray's apps and menus (k4)
bindsym $mod+Ctrl+s exec ~/.local/bin/k4-share send clipboard   # Send to a nearby device (LocalSend, k4)
bindsym $mod+comma exec ~/.local/bin/k4-notify dismiss
bindsym $mod+Shift+comma exec ~/.local/bin/k4-notify clear
bindsym $mod+Ctrl+comma exec ~/.local/bin/k4-notify dnd
bindsym $mod+Mod1+comma exec ~/.local/bin/k4 --notify-ctl invoke-last
bindsym $mod+Mod1+Shift+comma exec ~/.local/bin/k4-notify center
bindsym $mod+Shift+g exec $menu_sys tui sh -c 'cd "$(~/scripts/get_last_tmux_pwd.sh)" && exec lazygit'
bindsym $mod+Shift+f exec $menu_sys tui sh -c 'command -v wiremix >/dev/null && exec wiremix || exec pavucontrol'
bindsym $mod+Shift+q exec $menu_sys tui bluetui
# impala needs iwd (see UBUNTU_WIFI_IWD in init.sh); otherwise the nmcli picker in sway-menu
bindsym $mod+Shift+w exec sh -c 'systemctl is-active -q iwd && [ -x ~/.local/bin/impala ] && exec ~/.local/bin/sway-menu tui impala || exec ~/.local/bin/sway-menu wifi'

# Windows
bindsym $mod+x kill
bindsym $mod+f fullscreen toggle
bindsym $mod+t floating toggle
bindsym $mod+j layout toggle split                     # as Hyprland's Super+J (toggle split)
bindsym $mod+l layout toggle tabbed split              # as Hyprland's Super+L (workspace layout)
bindsym $mod+o floating toggle, sticky toggle          # pop the window out: float and pin
bindsym Mod1+Tab focus next
bindsym Mod1+Shift+Tab focus prev
bindsym Ctrl+Mod1+Tab focus output right
bindsym Ctrl+Mod1+Shift+Tab focus output left

# Super+H/J/K/L: J, K and L do what they do on Hyprland (split, keybindings, layout)
bindsym $mod+h focus left
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+Mod1+Left move workspace to output left
bindsym $mod+Shift+Mod1+Right move workspace to output right
bindsym $mod+Shift+Mod1+Up move workspace to output up
bindsym $mod+Shift+Mod1+Down move workspace to output down

bindsym $mod+minus resize shrink width 100px
bindsym $mod+equal resize grow width 100px
bindsym $mod+Shift+minus resize shrink height 100px
bindsym $mod+Shift+equal resize grow height 100px
bindsym $mod+Mod1+minus resize shrink width 25px
bindsym $mod+Mod1+equal resize grow width 25px
bindsym $mod+Shift+Mod1+minus resize shrink height 25px
bindsym $mod+Shift+Mod1+equal resize grow height 25px
bindsym $mod+Ctrl+minus resize shrink width 300px
bindsym $mod+Ctrl+equal resize grow width 300px
bindsym $mod+Ctrl+Shift+minus resize shrink height 300px
bindsym $mod+Ctrl+Shift+equal resize grow height 300px

# Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
bindsym $mod+Shift+1 move container to workspace number 1, workspace number 1
bindsym $mod+Shift+Mod1+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2, workspace number 2
bindsym $mod+Shift+Mod1+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3, workspace number 3
bindsym $mod+Shift+Mod1+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4, workspace number 4
bindsym $mod+Shift+Mod1+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5, workspace number 5
bindsym $mod+Shift+Mod1+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6, workspace number 6
bindsym $mod+Shift+Mod1+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7, workspace number 7
bindsym $mod+Shift+Mod1+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8, workspace number 8
bindsym $mod+Shift+Mod1+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9, workspace number 9
bindsym $mod+Shift+Mod1+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10, workspace number 10
bindsym $mod+Shift+Mod1+0 move container to workspace number 10
bindsym $mod+Tab exec ~/.local/bin/k4-overview   # every workspace at once (k4); again closes it
bindsym $mod+Shift+Tab workspace prev_on_output
bindsym $mod+Ctrl+Tab workspace back_and_forth
bindsym --whole-window $mod+button4 workspace prev_on_output
bindsym --whole-window $mod+button5 workspace next_on_output
bindsym $mod+s scratchpad show
bindsym $mod+Mod1+s move scratchpad   # Super+Shift+S is SSH
bindsym $mod+Shift+s exec ~/.local/bin/k4-ssh open   # SSH hosts, this machine's server, keys (k4); again closes it

# Session
bindsym $mod+Escape exec ~/.local/bin/k4-power   # the system menu (k4): lock (L), suspend, … shut down; again closes it
bindsym $mod+Shift+Escape exec ~/.local/bin/k4-perf popup   # performance, processes and utilities (k4); log out is in Super+Esc
bindsym $mod+Ctrl+r reload

# Screenshots (copied to clipboard)
bindsym Print exec grim -g "$(slurp)" - | wl-copy
bindsym Shift+Print exec grim - | wl-copy
bindsym $mod+Print exec $menu_sys call color_picker
bindsym Mod1+Print exec $menu_sys call record_toggle

# Media and brightness
bindsym --locked XF86AudioRaiseVolume exec ~/.local/bin/k4-osd volume up
bindsym --locked XF86AudioLowerVolume exec ~/.local/bin/k4-osd volume down
bindsym --locked XF86AudioMute exec ~/.local/bin/k4-osd volume mute
bindsym --locked XF86AudioMicMute exec ~/.local/bin/k4-osd mic mute
bindsym --locked XF86MonBrightnessUp exec ~/.local/bin/k4-osd brightness up
bindsym --locked XF86MonBrightnessDown exec ~/.local/bin/k4-osd brightness down
bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioPause exec playerctl play-pause
bindsym --locked Mod1+XF86AudioPlay exec playerctl next
bindsym --locked Mod1+Shift+XF86AudioPlay exec playerctl previous
bindsym --locked Mod1+XF86AudioRaiseVolume exec wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 1%+
bindsym --locked Mod1+XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%-
bindsym --locked Mod1+XF86MonBrightnessUp exec brightnessctl set 1%+
bindsym --locked Mod1+XF86MonBrightnessDown exec brightnessctl set 1%-
bindsym --locked Shift+XF86MonBrightnessUp exec brightnessctl set 100%
bindsym --locked Shift+XF86MonBrightnessDown exec brightnessctl set 1%
bindsym --locked XF86KbdBrightnessUp exec brightnessctl -d '*::kbd_backlight' set 10%+
bindsym --locked XF86KbdBrightnessDown exec brightnessctl -d '*::kbd_backlight' set 10%-
bindsym --locked XF86TouchpadToggle input type:touchpad events toggle enabled disabled
bindsym --locked XF86TouchpadOn input type:touchpad events enabled
bindsym --locked XF86TouchpadOff input type:touchpad events disabled
bindsym XF86PowerOff exec ~/.local/bin/k4-power
bindsym Shift+XF86AudioMute exec $menu_sys audio      # switch the output
bindsym $mod+Ctrl+Delete exec $menu_sys call laptop_toggle   # the laptop display
bindsym Ctrl+Mod1+Delete [all] kill                   # close all windows, as Omarchy
bindsym XF86Eject exec eject
# the lid: the laptop display off while closed (as Omarchy)
bindswitch --reload --locked lid:on exec ~/.local/bin/sway-menu call laptop_off   # only while another screen is on
bindswitch --reload --locked lid:off exec ~/.local/bin/sway-menu call laptop_on
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioPrev exec playerctl previous

# Window rules
for_window [app_id="TUI.float"] floating enable, resize set 60 ppt 70 ppt, move position center
for_window [app_id="org.pulseaudio.pavucontrol"] floating enable, resize set 50 ppt 60 ppt, move position center

include /etc/sway/config.d/*
# Written by sway-menu (per-output scale); loaded last so it overrides the defaults above.
include ~/.local/state/sway/*.conf

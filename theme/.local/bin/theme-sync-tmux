#!/bin/bash
# theme-sync-tmux: write ~/.config/tmux/theme-colors.conf from the current theme and
# reload every running tmux server. Called by the Omarchy theme-set hook and by
# sway-theme-set on Ubuntu. An argument (the theme name Omarchy passes) is ignored:
# the palette always comes from the current theme's colors.toml.

THEME_DIR="$HOME/.local/state/omarchy/current/theme"
COLORS="$THEME_DIR/colors.toml"
TMUX_COLORS="$HOME/.config/tmux/theme-colors.conf"
THEME_NAME=$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null || echo unknown)

# Semantic palette, resolved the way Omarchy resolves it (colorN aliases included).
declare -A C
if [[ -f $COLORS ]]; then
  while IFS=$'\t' read -r key value; do C[$key]="$value"; done < <(theme-color --file "$COLORS" --all)
fi

# Last-resort defaults (Catppuccin Mocha) when there is no current theme yet.
bg=${C[background]:-"#1e1e2e"}
fg=${C[foreground]:-"#cdd6f4"}
dark_fg=${C[dark_foreground]:-"#6c7086"}
accent=${C[accent]:-"#89b4fa"}
selection=${C[selection]:-"#313244"}
muted=${C[muted]:-"#585b70"}
red=${C[red]:-"#f38ba8"}
yellow=${C[yellow]:-"#f9e2af"}
green=${C[green]:-"#a6e3a1"}
cyan=${C[cyan]:-"#94e2d5"}

mkdir -p "$(dirname "$TMUX_COLORS")"
cat >"$TMUX_COLORS" <<CONF
# Generated by theme-sync-tmux from theme: $THEME_NAME ($COLORS)
# Colours only: the status-bar layout in tmux.conf reads the @thm_* variables.

set -g @thm_bg "$bg"
set -g @thm_fg "$fg"
set -g @thm_dark_fg "$dark_fg"
set -g @thm_accent "$accent"
set -g @thm_selection "$selection"
set -g @thm_muted "$muted"
set -g @thm_red "$red"
set -g @thm_yellow "$yellow"
set -g @thm_green "$green"
set -g @thm_cyan "$cyan"

# Pane and status backgrounds stay "default" so the terminal's own background
# (and its background-opacity) shows through. Omarchy's theme-set-tmux sets an
# explicit bg on window-style, which would make every cell opaque; this file is
# sourced after it by the theme-set hook and wins.
set -g window-style "fg=$fg,bg=default"
set -g window-active-style "fg=$fg,bg=default"
set -g status-style "bg=default,fg=$fg"
set -g pane-border-style "fg=$muted"
set -g pane-active-border-style "fg=$accent"
set -g message-style "bg=$selection,fg=$fg"
set -g message-command-style "bg=$selection,fg=$accent"
set -g mode-style "bg=$selection,fg=$fg"
set -g popup-style "bg=$bg,fg=$fg"
set -g popup-border-style "fg=$accent"
set -g clock-mode-colour "$accent"
set -g window-status-activity-style "fg=$yellow"
set -g window-status-bell-style "fg=$red,bold"
CONF

TPM_SOURCE=""
for p in "$HOME/.tmux/plugins/tpm/scripts/source_plugins.sh" "$HOME/.config/tmux/plugins/tpm/scripts/source_plugins.sh"; do
  [[ -f $p ]] && { TPM_SOURCE="$p"; break; }
done

reload_tmux_socket() {  # reload_tmux_socket SOCKET
  tmux -S "$1" display -p '' >/dev/null 2>&1 || return 0   # not a live server
  tmux -S "$1" source-file "$TMUX_COLORS" 2>/dev/null
  tmux -S "$1" source-file "$HOME/.config/tmux/tmux.conf" 2>/dev/null || true
  [[ -n $TPM_SOURCE ]] && tmux -S "$1" run-shell "$TPM_SOURCE" 2>/dev/null
  tmux -S "$1" refresh-client -S 2>/dev/null
}

# tmux keeps its sockets in $TMUX_TMPDIR (default /tmp), not XDG_RUNTIME_DIR. The
# server process is called "tmux: server", so pgrep -x tmux would never find it;
# probing each socket is the reliable check.
SOCKET_DIR="${TMUX_TMPDIR:-/tmp}/tmux-$(id -u)"
for socket in "$SOCKET_DIR"/*; do
  [[ -S $socket ]] && reload_tmux_socket "$socket"
done
exit 0

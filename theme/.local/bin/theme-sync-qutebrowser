#!/bin/bash
# theme-sync-qutebrowser: make the running qutebrowser re-read config.py, which reads the
# current theme's colors.toml and the starfield flag. The IPC command goes to the instance
# using the default basedir; test instances started with --basedir have their own socket.
# Without a running instance `qutebrowser :cmd` would open a new window, hence the check.
if pgrep -x qutebrowser >/dev/null; then
  qutebrowser :config-source >/dev/null 2>&1
fi
exit 0
